{
  "$comment": "Disk hygiene policy for KalCode build machines. See tooling/disk-hygiene.mjs.",
  "warnGb": 150,
  "criticalGb": 25,
  "idleHours": 24,
  "mainIdleHours": 168,
  "incrementalDays": 7,
  "protect": [
    "kc-release-*",
    "kc-code-primary",
    "kc-proof-*",
    "kc-website-policy-*",
    "kc-handoff",
    "kc-gate-records",
    "kc-gate-rust-targets",
    "kc-runner",
    "kc-gates-pc2"
  ],
  "retain": []
}

{
  "name": "kalcode",
  "private": true,
  "description": "KalCode \u00e2\u20ac\u201d one intelligence that operates your entire AI workspace.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:desktop": "pnpm --filter @kalcode/desktop tauri dev",
    "dev:website": "pnpm --filter @kalcode/website dev",
    "build": "pnpm -r --if-present build",
    "format": "biome format --write . && cargo fmt --all",
    "format:check": "biome format . && cargo fmt --all -- --check",
    "lint": "biome lint . && cargo clippy --workspace --all-targets -- -D warnings",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test && cargo test --workspace",
    "test:e2e": "pnpm -r --if-present test:e2e",
    "gen:protocol": "cargo test -p kalcode-native-core -p kalcode-providers -p kalcode-threads -p kalcode-kalvoice --lib && node tooling/gen-protocol-index.mjs",
    "check:branding": "node tooling/check-branding.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm check:branding && pnpm check:capabilities && pnpm check:zero-cost && pnpm check:releases",
    "check:capabilities": "node tooling/check-capabilities.mjs",
    "check:zero-cost": "node tooling/check-zero-cost.mjs",
    "test:repeat": "node tooling/test-repeat.mjs",
    "perf": "node apps/desktop/tests/perf/run.ts",
    "perf:check": "node apps/desktop/tests/perf/check.ts",
    "deny": "cargo deny check",
    "check:releases": "node tooling/release/check-manifest.mjs",
    "release:build": "node tooling/release/build-windows.mjs",
    "release:verify": "node tooling/release/verify-windows.mjs",
    "release:publish": "node tooling/release/publish.mjs",
    "release:publish:dry-run": "node tooling/release/publish.mjs --dry-run",
    "release:smoke:local": "node tooling/release/smoke-local.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "typescript": "7.0.2"
  }
}

{
  "name": "@kalcode/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KalCode design system: tokens, brand assets and accessible React primitives.",
  "exports": {
    "./tokens.css": "./src/styles/tokens.css",
    "./fonts.css": "./src/styles/fonts.css",
    "./base.css": "./src/styles/base.css",
    "./terminal.css": "./src/styles/terminal.css",
    "./brand/*": "./src/brand/*",
    "./components": "./src/components/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:ui": "playwright test --config tests/diffview/playwright.config.ts",
    "test:ui:primitives": "playwright test --config tests/primitives/playwright.config.ts"
  },
  "dependencies": {
    "@kalcode/protocol": "workspace:*",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/lexend-deca": "5.3.0",
    "@fontsource-variable/lexend-exa": "5.3.0",
    "@fontsource-variable/lexend-giga": "5.3.0",
    "radix-ui": "1.6.7",
    "lucide-react": "1.48.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "jsdom": "30.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  }
}

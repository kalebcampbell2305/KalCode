{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kalcode-website",
  "main": "worker/index.ts",
  // Latest date supported by the workerd bundled with the pinned wrangler (1.20260921.1).
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Every request goes through the Worker so it can redirect www, serve /api/* and add
    // security headers to static responses too.
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kalcode-web",
      // Production database (created 2026-09-24). Local dev and tests use a local copy.
      "database_id": "f7b3e324-c093-4231-b768-2a4a930d2744",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      // Desktop release files: releases/<version>/<file> and releases/latest.json, uploaded by
      // `pnpm release:publish` (tooling/release/publish.mjs). Served by worker/downloads.ts.
      // Local dev and tests use a local simulation of the bucket.
      "binding": "RELEASES",
      "bucket_name": "kalcode-releases"
    }
  ],
  "ratelimits": [
    {
      "name": "EARLY_ACCESS_LIMITER",
      // Any unique positive integer string for this account's rate-limit namespace.
      "namespace_id": "1001",
      // 5 requests per 60 seconds per client IP (applies to both early-access endpoints).
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  // Plain configuration only; secrets never go here. RESEND_API_KEY is a Worker secret
  // (`wrangler secret put RESEND_API_KEY`); local development reads .dev.vars
  // (see .dev.vars.example). docs/WEBSITE.md "Email".
  "vars": {
    // Keep the verified preview manifest live until a signed stable descriptor, artifacts and D1
    // pointer have all been published and probed. Only exact "true" changes release authority.
    "RELEASE_CATALOG_ENABLED": "false",
    // resend (production) | capture (tests: loopback mail sink) | log (local console)
    "EMAIL_TRANSPORT": "resend",
    // Site-wide cap on emails per UTC day, inside Resend's free allowance (100/day).
    "EMAIL_DAILY_LIMIT": "90"
  },
  "triggers": {
    // Hourly cleanup of expired links and unconfirmed sign-ups (worker/index.ts `scheduled`).
    "crons": ["17 * * * *"]
  },
  "routes": [
    { "pattern": "kalcoded.com", "custom_domain": true },
    { "pattern": "www.kalcoded.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      // Per-request invocation logs would record request metadata such as client IP and
      // user agent. The privacy page promises we do not store those, so only the Worker's own
      // structured logs (which never contain emails or IPs) are kept.
      "invocation_logs": false
    }
  }
}

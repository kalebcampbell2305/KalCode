---
import "@kalcode/ui/fonts.css";
import "@kalcode/ui/tokens.css";
import "@kalcode/ui/base.css";
import "../styles/critical.css";
// The hero world's own stylesheets, imported here as well so they ship in the same
// render-blocking file as critical.css: one request in <head> instead of three.
import "../styles/hero.css";
import "../components/hero/space-backdrop.css";

import decaLatin from "@fontsource-variable/lexend-deca/files/lexend-deca-latin-wght-normal.woff2?url";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import PageStyles from "../components/PageStyles.astro";
import { TWITTER_SITE, jsonLdText, pageStructuredData } from "../lib/seo";
import { SITE_NAME, SITE_ORIGIN } from "../lib/site";
import { THEME_SCRIPT } from "../lib/theme-script";

interface Props {
  title: string;
  description: string;
  /** Canonical path, e.g. "/pricing". */
  path: string;
  noindex?: boolean;
  /**
   * A page of the KalCode world (home, product, KalVoice, pricing, download, 404): always the dark
   * cinematic theme. Reading pages (docs and legal) follow the visitor's theme.
   */
  world?: boolean;
  /** The page places <PageStyles /> itself, after its first viewport (home). */
  lateStyles?: boolean;
  /** schema.org JSON-LD for this page (a non-executing data block; see lib/seo.ts). */
  jsonLd?: Record<string, unknown>;
}

const { title, description, path, noindex = false, world = false, lateStyles = false, jsonLd } = Astro.props;
const canonical = new URL(path, SITE_ORIGIN).href;
const searchData = noindex ? undefined : pageStructuredData({ title, description, path }, jsonLd);
const ogImage = new URL("/og.png", SITE_ORIGIN).href;
const ogImageAlt =
  "The KalCode mascot, a pixel character holding a laptop marked K, beside the KalCode name and the line One intelligence. A brighter tomorrow.";
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={THEME_SCRIPT} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large" />}
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#05080F" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F5F7FB" media="(prefers-color-scheme: light)" />

    <link rel="preload" href={decaLatin} as="font" type="font/woff2" crossorigin />
    <slot name="head" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={TWITTER_SITE} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {searchData && <script type="application/ld+json" is:inline set:html={jsonLdText(searchData)} />}
  </head>
  <body data-theme={world ? "dark" : undefined} data-world={world ? "" : undefined}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header path={path} />
    <main id="main" tabindex="-1">
      {!lateStyles && <PageStyles />}
      <slot />
    </main>
    <Footer themeToggle={!world} />
    <script>
      import "../scripts/theme";
      import "../scripts/nav";
    </script>
  </body>
</html>

---
import { RELEASES, releaseCopy, releasePublicVersion, servedStableRelease } from "../lib/releases";
import { DOCS_NAV, type PagePath, getPage } from "../lib/site";
import Base from "./Base.astro";

interface Props {
  path: PagePath;
  heading: string;
  lead: string;
}
const { path, heading, lead } = Astro.props;
const page = getPage(path);
// Once a Stable release is served the docs describe it; before then they describe the design.
const stable = servedStableRelease(RELEASES);
---
<Base title={page.title} description={releaseCopy(page.description, RELEASES)} path={page.path}>
  <div class="container docs">
    <nav class="docs__nav" aria-label="Documentation">
      <h2>Documentation</h2>
      <ul role="list">
        {
          DOCS_NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={item.href === path ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <article class="docs__content">
      <header class="docs__head">
        <h1 class="h1">{heading}</h1>
        <p class="lead">{lead}</p>
        {
          stable ? (
            <p class="status-line"><span class="chip chip--built">Describes KalCode Stable {releasePublicVersion(stable.version)}</span></p>
          ) : (
            <p class="status-line"><span class="chip chip--dev">Describes the design</span> Details may change before release.</p>
          )
        }
      </header>
      <div class="prose">
        <slot />
      </div>
    </article>
  </div>
</Base>

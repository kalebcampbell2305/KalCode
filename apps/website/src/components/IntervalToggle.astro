---
/**
 * Monthly / Yearly segmented control (two toggle buttons with aria-pressed). JS-only: without
 * scripts it is hidden and pages show monthly prices with the yearly price written beside them.
 * src/scripts/interval.ts wires it up.
 */
interface Props {
  /** Short note on the Yearly option, e.g. "Save up to $100". */
  note?: string;
  class?: string;
}
const { note, class: className } = Astro.props;
---
<div class:list={["interval", "needs-js", className]} role="group" aria-label="Billing period" data-interval-toggle>
  <button type="button" class="interval__option" data-interval-option="month" aria-pressed="true">Monthly</button>
  <button type="button" class="interval__option" data-interval-option="year" aria-pressed="false">
    Yearly{note && <span class="interval__note">{note}</span>}
  </button>
</div>

<style>
  .interval {
    display: inline-flex;
    gap: 0.25rem;
    padding: 0.25rem;
    border-radius: var(--radius-full);
    background: rgb(4 8 18 / 0.72);
    box-shadow:
      inset 0 0 0 1px rgb(var(--world-line) / 0.2),
      0 18px 40px -24px rgb(0 0 0 / 0.9);
  }

  .interval__option {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.5rem;
    padding: 0 var(--space-5);
    border: 0;
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--color-text-secondary);
    font: inherit;
    font-size: var(--site-text-small);
    font-weight: var(--weight-medium);
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }

  .interval__option:hover {
    color: var(--color-text);
  }

  .interval__option[aria-pressed="true"] {
    background: linear-gradient(180deg, rgb(var(--world-blue) / 0.3), rgb(var(--world-blue) / 0.16));
    color: var(--color-text);
    box-shadow:
      inset 0 0 0 1px rgb(var(--world-blue) / 0.7),
      0 0 22px -6px rgb(var(--world-blue) / 0.6);
  }

  .interval__option:focus-visible {
    outline: 2px solid var(--color-accent-text);
    outline-offset: 3px;
  }

  .interval__note {
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius-full);
    background: rgb(var(--world-blue) / 0.16);
    color: var(--color-accent-icy, var(--color-accent-text));
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: var(--weight-medium);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .interval__option {
      transition: none;
    }
  }
</style>

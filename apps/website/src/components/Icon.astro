---
/** Decorative line icons (stroke = currentColor). The surrounding control carries the label. */
interface Props {
  name: "menu" | "close" | "system" | "light" | "dark" | "check" | "arrow-right" | "arrow-down" | "download" | "prompt" | "plus" | "lock" | "key";
  class?: string;
}
const { name, class: className } = Astro.props;
---
<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === "menu" && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === "close" && <path d="M6 6l12 12M18 6 6 18" />}
  {name === "system" && (
    <>
      <rect x="3" y="4.5" width="18" height="12" rx="1.5" />
      <path d="M9 20h6M12 16.5V20" />
    </>
  )}
  {name === "light" && (
    <>
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2.5v2M12 19.5v2M4.6 4.6 6 6M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4" />
    </>
  )}
  {name === "dark" && <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />}
  {name === "check" && <path d="m5 12.5 4.5 4.5L19 7.5" />}
  {name === "arrow-right" && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === "arrow-down" && <path d="M12 5v14M6 13l6 6 6-6" />}
  {name === "download" && <path d="M12 4v11M7 10.5l5 5 5-5M5 20h14" />}
  {name === "prompt" && <path d="m5 8 4 4-4 4M12 16h7" />}
  {name === "plus" && <path d="M12 5v14M5 12h14" />}
  {name === "lock" && (
    <>
      <rect x="5" y="10.5" width="14" height="10" rx="2" />
      <path d="M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5" />
    </>
  )}
  {name === "key" && (
    <>
      <circle cx="8" cy="15" r="3.5" />
      <path d="m10.5 12.5 8-8M16 7l2.5 2.5M14 9l2 2" />
    </>
  )}
</svg>

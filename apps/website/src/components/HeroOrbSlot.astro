---
/**
 * The home hero's centerpiece. Renders `hero/HeroOrb.astro` (the animated KalCode symbol, owned
 * by the hero work) when it exists; otherwise the static KalCode globe from the brand assets.
 */
import Globe from "./Globe.astro";

type HeroModule = { default: (props: Record<string, unknown>) => unknown };
const modules = import.meta.glob<HeroModule>("./hero/HeroOrb.astro", { eager: true });
const HeroOrb = modules["./hero/HeroOrb.astro"]?.default;

interface Props {
  size?: "full" | "compact";
}
const { size = "full" } = Astro.props;
/** Poster sizes matching site.css: stacked below 1024 px, the split hero's orb column above. */
const POSTER_SIZES = "(max-width: 1023px) min(88vw, 25rem, 40vh), min(32rem, 58vh)";
---
{
  HeroOrb ? (
    <HeroOrb size={size} sizes={size === "full" ? POSTER_SIZES : undefined} />
  ) : (
    <div class="hero__orb-poster">
      <Globe variant="kalcode" hero alt="" sizes="(min-width: 60rem) 27rem, 60vw" />
    </div>
  )
}

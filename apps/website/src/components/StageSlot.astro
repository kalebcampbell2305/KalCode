---
/**
 * Composition slot for a product demo from src/components/stage (owned by the stage work).
 * When `stage/<name>.astro` exists it is rendered with the remaining props (id, headingLevel,
 * width, ...). When it does not, nothing is rendered; pages check `hasStage()` (lib/stage.ts) to
 * leave out the whole section, so a missing demo never shows an empty frame.
 */
import type { StageName } from "../lib/stage";

type StageModule = { default: (props: Record<string, unknown>) => unknown };
const modules = import.meta.glob<StageModule>("./stage/*.astro", { eager: true });

interface Props {
  name: StageName;
  [prop: string]: unknown;
}

const { name, ...rest } = Astro.props;
const Component = modules[`./stage/${name}.astro`]?.default;
---
{
  Component && (
    <div class="stage-slot" data-stage-slot={name}>
      <Component {...rest} />
    </div>
  )
}

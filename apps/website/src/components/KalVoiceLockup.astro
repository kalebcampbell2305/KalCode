---
import { KALVOICE } from "../lib/site";
import Globe from "./Globe.astro";

/**
 * The KalVoice lockup: the voice artwork's lettering-free globe with the KalVoice name and line
 * set live in KalCode typography (no lettering in the image). Always rendered on the artwork's
 * own dark ground, in both themes.
 */
interface Props {
  sizes: string;
}
const { sizes } = Astro.props;
---
<figure class="artwork-tile" data-theme="dark">
  <div class="artwork-tile__globe">
    <Globe variant="kalvoice" alt={KALVOICE.globeAlt} sizes={sizes} />
  </div>
  <figcaption class="kalvoice-lockup kalvoice-lockup--centered">
    <span class="kalvoice-name">{KALVOICE.name}</span>
    <span class="kalvoice-line">{KALVOICE.line}</span>
  </figcaption>
</figure>

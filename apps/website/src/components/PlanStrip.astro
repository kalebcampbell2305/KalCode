---
/**
 * The home page's compact plan strip: each plan's stage, monthly price and headline limits, with
 * the most popular plan lit. Everything comes from @kalcode/protocol/plans; /pricing has the rest.
 */
import { CORE_LIMITS, PLANS, UNLIMITED_NOTE, formatCoreLimit, formatInterval, formatPrice } from "@kalcode/protocol/plans";
import Icon from "./Icon.astro";

/** The limits the strip leads with: agents, terminals and KalVoice. */
const STRIP_LIMITS = CORE_LIMITS.filter((limit) =>
  ["parallelAgents", "openTerminals", "kalvoiceRequestsPerMonth"].includes(limit.key),
);
---
<div class="plan-strip">
  <ul class="plan-cards" role="list">
    {
      PLANS.map((plan) => (
        <li class:list={["plan-card", { "plan-card--featured": plan.popular }]} data-plan={plan.id}>
          <p class="plan-card__name">
            <span>
              {plan.name}
              <span class="plan-card__stage">{plan.stage}</span>
            </span>
            {plan.popular && <span class="plan-card__tag">Most popular</span>}
          </p>
          <p class="plan-card__price">
            {formatPrice(plan, "month")}
            <small>{formatInterval("month")}</small>
          </p>
          <p class="plan-card__summary">{plan.tagline}</p>
          <ul class="plan-card__points" role="list">
            {STRIP_LIMITS.map((limit) => (
              <li>
                <Icon name="check" /> {formatCoreLimit(plan.limits, limit)}
                {plan.limits[limit.key] === null && <sup aria-hidden="true">*</sup>}
              </li>
            ))}
          </ul>
          <a class="text-link plan-card__link" href={`/pricing#plan-${plan.id}`}>
            {plan.name} details <Icon name="arrow-right" />
          </a>
        </li>
      ))
    }
  </ul>
  <p class="plan-strip__note"><span aria-hidden="true">* </span>{UNLIMITED_NOTE}</p>
</div>

---
/**
 * The plan ladder's first row, compressed for the home page: each plan's price and KalVoice
 * Requests, plus what every plan includes. All values come from @kalcode/protocol/plans.
 */
import { PLANS, formatInterval, formatKalVoiceAllowance, formatPrice } from "@kalcode/protocol/plans";
import Icon from "./Icon.astro";
---
<div class="ladder-strip">
  {
    PLANS.map((plan) => (
      <div class="ladder-strip__plan">
        <p class="ladder-strip__name">{plan.name}</p>
        <p class="ladder-strip__price">
          {formatPrice(plan.price)}
          <small>{formatInterval(plan.price)}</small>
        </p>
        <p class="ladder-strip__allowance">
          <strong>{formatKalVoiceAllowance(plan.limits)}</strong> KalVoice Requests
        </p>
      </div>
    ))
  }
  <div class="ladder-strip__includes">
    <p>Every plan includes</p>
    <p class="chips">
      <span class="chip chip--plain">All providers</span>
      <span class="chip chip--plain">All permission modes</span>
      <span class="chip chip--plain">Unlimited dictation</span>
    </p>
    <p>
      <a class="text-link" href="/pricing">Compare plans <Icon name="arrow-right" /></a>
    </p>
  </div>
</div>

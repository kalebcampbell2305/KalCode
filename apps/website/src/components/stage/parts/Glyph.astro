---
/**
 * Provider glyph, drawn by KalCode (never a provider logo): a small monochrome mark in the
 * provider's accent colour so panes can be told apart at a glance. Always paired with the
 * provider's name in text. Rendered as a CSS mask (stage/icons.css) to keep the HTML light.
 */
import type { ProviderId } from "../../../data/story";

interface Props {
  provider: ProviderId;
  class?: string;
}
const { provider, class: className } = Astro.props;
---
<span class:list={["kc-glyph", `kc-glyph--${provider}`, className]} aria-hidden="true"></span>

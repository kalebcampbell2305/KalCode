---
/**
 * Provider-published identity mark, rendered as a CSS mask (stage/icons.css) and paired with the
 * provider's name in text so panes can be told apart at a glance.
 */
import type { ProviderId } from "../../../data/story";

interface Props {
  provider: ProviderId;
  class?: string;
}
const { provider, class: className } = Astro.props;
---
<span class:list={["kc-glyph", `kc-glyph--${provider}`, className]} aria-hidden="true"></span>

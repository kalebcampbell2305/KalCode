---
/**
 * AppWindow: the KalCode desktop window, drawn in HTML with the app's design system and sample data.
 *
 * Title bar, workspace rail, a grid of up to four provider panes (Claude Code, Codex, Gemini CLI,
 * PowerShell), a right dock (Browser · Dashboard · Permissions), the floating KalVoice panel and a
 * mission strip. Everything is rendered at build time for the given scene; the stage script
 * (scripts/stage/app.ts) only switches attributes, streams lines and runs short scripted
 * sequences. Without JavaScript the window shows the scene as a finished, static picture.
 *
 * - `interactive`: real buttons, tabs and keyboard support (TryKalCode, DemoCenter, KalVoiceDemo).
 *   Otherwise the window is a picture: `aria-hidden` + `inert`, described by `label`.
 * - Narrow containers (< 760 px) switch to a phone layout: one pane at a time with tabs and
 *   swipe (scroll snap) between the open panes and the dock.
 */
import StageStyles from "./parts/StageStyles.astro";
import {
  FINAL_SCENE,
  FRESH_PLACEHOLDER,
  PROVIDERS,
  type ProviderId,
  type Scene,
  THREADS,
  type Thread,
  VOICE,
  WORKSPACE,
} from "../../data/story";
import BrowserPreview from "./parts/BrowserPreview.astro";
import DashboardPanel from "./parts/DashboardPanel.astro";
import Glyph from "./parts/Glyph.astro";
import KalVoicePanel from "./parts/KalVoicePanel.astro";
import MissionStrip from "./parts/MissionStrip.astro";
import Pane from "./parts/Pane.astro";
import PermissionsPanel from "./parts/PermissionsPanel.astro";
import Rail from "./parts/Rail.astro";

interface Props {
  /** Unique id on the page (prefixes every id inside). */
  id: string;
  scene?: Partial<Scene>;
  interactive?: boolean;
  /** Accessible description when the window is a picture. */
  label?: string;
  size?: "hero" | "section" | "compact";
  /** Initialise the stage script automatically when the window nears the viewport. */
  auto?: boolean;
  /** A sequence to play once, the first time the window is in view (e.g. "reveal" in the hero). */
  intro?: "reveal" | "approve" | "dictate" | "command" | "mission";
  class?: string;
}

const {
  id,
  scene: sceneProp = {},
  interactive = false,
  label = "KalCode window, product preview with sample data",
  size = "section",
  auto = true,
  intro,
  class: className,
} = Astro.props;

const scene: Scene = { ...FINAL_SCENE, ...sceneProp };
const spawns: readonly string[] = VOICE.spawns;
const present = spawns.filter((s) => scene.panes.includes(s) || scene.voice === "spawned" || scene.mission > 0);
const focusThread = THREADS.find((t) => t.id === scene.focus);
const dock = scene.view === "dashboard" && scene.dock === "dashboard" ? "browser" : scene.dock;

const fresh = (p: ProviderId): Thread => ({
  id: `fresh-${p}`,
  provider: p,
  name: "New thread",
  status: "idle",
  activity: "Waiting for your first message",
  workspace: WORKSPACE.name,
  branch: WORKSPACE.branch,
  mode: "approve",
  filesChanged: 0,
  duration: "under 1 min",
  cwd: WORKSPACE.path,
  transcript: [],
  placeholder: FRESH_PLACEHOLDER[p],
});

const dockTabs = [
  { id: "browser", label: "Browser", icon: "globe" },
  { id: "dashboard", label: "Dashboard", icon: "dashboard" },
  { id: "permissions", label: "Permissions", icon: "shield" },
] as const;
const pendingBadge = 1 + (scene.approval === "pending" ? 1 : 0);
const statusBy = (t: Thread) =>
  t.statusByApproval
    ? Object.entries(t.statusByApproval)
        .map(([k, v]) => `${k}:${v}`)
        .join(" ")
    : undefined;
---
<StageStyles />
<div
  class:list={["kc-app", `kc-app--${size}`, className]}
  id={id}
  data-kc-app
  data-kc-auto={auto ? "true" : undefined}
  data-kc-intro={intro}
  data-interactive={interactive ? "true" : "false"}
  data-view={scene.view}
  data-dock={dock}
  data-layout={scene.layout}
  data-count={scene.panes.length}
  data-approval={scene.approval}
  data-voice={scene.voice}
  data-mode={scene.mode}
  data-focus={scene.focus}
  data-panes={scene.panes.join(" ")}
  data-mission={scene.mission}
  data-testid={`app-${id}`}
  role={interactive ? "region" : "img"}
  aria-label={interactive ? "KalCode window, product preview with sample data" : label}
>
  <div class="kc-app__frame" aria-hidden={interactive ? undefined : "true"} inert={!interactive}>
    <div class="kc-app__bar">
      <span class="kc-app__crumb"><span class="kc-app__appname">KalCode</span><span aria-hidden="true">—</span>{WORKSPACE.name}</span>
      <span class="kc-app__winctl" aria-hidden="true"><span class="kc-i" data-i="minus"></span><span class="kc-i" data-i="square"></span><span class="kc-i" data-i="close"></span></span>
    </div>

    <div class="kc-app__tabs" data-kc-mtabs role={interactive ? "tablist" : undefined} aria-label={interactive ? "Open panes" : undefined}>
      {THREADS.map((t) => (
        interactive ? (
          <button type="button" role="tab" class="kc-mtab" data-kc-mtab={t.id} hidden={!scene.panes.includes(t.id)} aria-selected={scene.focus === t.id ? "true" : "false"} tabindex={scene.focus === t.id ? 0 : -1}>
            <Glyph provider={t.provider} />{t.provider === "shell" ? "PowerShell" : PROVIDERS[t.provider].name}
          </button>
        ) : (
          <span class="kc-mtab" data-kc-mtab={t.id} hidden={!scene.panes.includes(t.id)} data-selected={scene.focus === t.id ? "true" : undefined}>
            <Glyph provider={t.provider} />{t.provider === "shell" ? "PowerShell" : PROVIDERS[t.provider].name}
          </span>
        )
      ))}
      {dockTabs.map((d) => (
        interactive ? (
          <button type="button" role="tab" class="kc-mtab" data-kc-mtab={`dock:${d.id}`} hidden={dock !== d.id} aria-selected="false" tabindex="-1">
            <span class="kc-i" data-i={d.icon} aria-hidden="true"></span>{d.label}
          </button>
        ) : (
          <span class="kc-mtab" data-kc-mtab={`dock:${d.id}`} hidden={dock !== d.id}><span class="kc-i" data-i={d.icon} aria-hidden="true"></span>{d.label}</span>
        )
      ))}
    </div>

    <div class="kc-app__body">
      <Rail threads={THREADS} approval={scene.approval} interactive={interactive} focus={scene.focus} view={scene.view} present={present} />

      <div class="kc-app__main" data-kc-main>
        <div class="kc-app__center">
          <MissionStrip stage={scene.mission} />
          <div class="kc-grid" data-kc-grid>
            {THREADS.map((t) => {
              const slot = scene.panes.indexOf(t.id);
              // Closed panes wait in templates: parsed, but no style or layout work until opened.
              return slot >= 0 ? (
                <Pane thread={t} approval={scene.approval} interactive={interactive} open={true} focus={scene.focus === t.id} position={slot} />
              ) : (
                <template data-kc-pane-tpl={t.id} data-provider={t.provider} data-status-by={statusBy(t)}>
                  <Pane thread={t} approval={scene.approval} interactive={interactive} open={false} />
                </template>
              );
            })}
          </div>
          <KalVoicePanel state={scene.voice} interactive={interactive} target={focusThread ? PROVIDERS[focusThread.provider].name : "Claude Code"} />
          <div class="kc-dashview" data-kc-dashview>
            {scene.view === "dashboard" && <DashboardPanel uid={id} approval={scene.approval} interactive={interactive} present={present} />}
          </div>
        </div>

        <aside class="kc-dock" data-kc-dock aria-label={interactive ? "Dock" : undefined}>
          <div class="kc-dock__head">
          <div class="kc-dock__tabs" role={interactive ? "tablist" : undefined} aria-label={interactive ? "Dock" : undefined}>
            {dockTabs.map((d) => (
              interactive ? (
                <button
                  type="button"
                  role="tab"
                  class="kc-dock__tab"
                  id={`${id}-tab-${d.id}`}
                  aria-controls={`${id}-panel-${d.id}`}
                  aria-selected={dock === d.id ? "true" : "false"}
                  tabindex={dock === d.id ? 0 : -1}
                  data-kc-tab={d.id}
                  data-testid={`dock-tab-${d.id}`}
                >
                  <span class="kc-i" data-i={d.icon} aria-hidden="true"></span>{d.label}
                  {d.id === "dashboard" && <span class="kc-count kc-count--waiting" data-kc-count="approvals">{pendingBadge}</span>}
                </button>
              ) : (
                <span class="kc-dock__tab" data-kc-tab={d.id} data-selected={dock === d.id ? "true" : undefined}>
                  <span class="kc-i" data-i={d.icon} aria-hidden="true"></span>{d.label}
                  {d.id === "dashboard" && <span class="kc-count kc-count--waiting" data-kc-count="approvals">{pendingBadge}</span>}
                </span>
              )
            ))}
          </div>
            {interactive && (
              <button type="button" class="kc-iconbtn kc-dock__close" data-kc-action="dock:none" aria-label="Close dock">
                <span class="kc-i" data-i="close" aria-hidden="true"></span>
              </button>
            )}
          </div>
          <div class="kc-dock__panel" data-kc-panel="browser" id={`${id}-panel-browser`} role={interactive ? "tabpanel" : undefined} aria-labelledby={interactive ? `${id}-tab-browser` : undefined} hidden={dock !== "browser"}>
            {dock === "browser" ? <BrowserPreview interactive={interactive} /> : <template data-kc-lazy><BrowserPreview interactive={interactive} /></template>}
          </div>
          <div class="kc-dock__panel" data-kc-panel="dashboard" id={`${id}-panel-dashboard`} role={interactive ? "tabpanel" : undefined} aria-labelledby={interactive ? `${id}-tab-dashboard` : undefined} hidden={dock !== "dashboard"} data-kc-dash-home>
            {scene.view !== "dashboard" && <DashboardPanel uid={id} approval={scene.approval} interactive={interactive} present={present} />}
          </div>
          <div class="kc-dock__panel" data-kc-panel="permissions" id={`${id}-panel-permissions`} role={interactive ? "tabpanel" : undefined} aria-labelledby={interactive ? `${id}-tab-permissions` : undefined} hidden={dock !== "permissions"}>
            {dock === "permissions" ? (
              <PermissionsPanel uid={id} mode={scene.mode} approval={scene.approval} interactive={interactive} variant="compact" />
            ) : (
              <template data-kc-lazy><PermissionsPanel uid={id} mode={scene.mode} approval={scene.approval} interactive={interactive} variant="compact" /></template>
            )}
          </div>
        </aside>
      </div>

    </div>
  </div>

  {interactive && (
    <>
      {(["claude", "codex", "gemini"] as const).map((p) => (
        <template data-kc-fresh={p}>
          <Pane thread={fresh(p)} approval="none" interactive={true} open={false} fresh={true} />
        </template>
      ))}
      <p class="visually-hidden" aria-live="polite" data-kc-live data-testid={`live-${id}`}></p>
    </>
  )}
</div>

<script>
  import { initAutoApps } from "../../scripts/stage/app";
  initAutoApps();
</script>

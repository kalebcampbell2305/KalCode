---
/**
 * PermissionModes: the two modes a new coding agent can start in, as shipped (0.1.9+1738,
 * apps/desktop/src/surfaces/permissions/labels.ts DEFAULT_MODE_CHOICES; crates/permissions
 * policy.rs `baseline`). Bypass is the default: edits, commands, tests, builds, Git, pushes and dev
 * servers run without approval prompts and only credentials and secrets ask. Plan is read-only.
 *
 * A native radio group (arrow keys move between modes; no script), the outcome of each action in
 * the selected mode, and the one truthful Needs You moment both modes share: a request to read a
 * secret. Every mode is on every plan.
 */
interface Props {
  id?: string;
  mode?: "bypass" | "plan";
  headingLevel?: 2 | 3 | 4;
  /** compact: the card the home page draws. Other widths keep the same content. */
  width?: "compact" | "contained" | "wide" | "full";
  class?: string;
}
const { id = "permission-modes", mode = "bypass", width = "contained", class: className } = Astro.props;

const MODES = [
  {
    id: "bypass",
    label: "Bypass",
    badge: "Default",
    hint: "Coding agents work without approval prompts: edits, commands, tests, builds, Git, pushes and dev servers just run. Only access to credentials and secrets still asks.",
  },
  {
    id: "plan",
    label: "Plan",
    badge: "Read-only",
    hint: "Read and plan only. Anything that changes files or runs commands is refused, and credentials and secrets still ask.",
  },
] as const;

type Outcome = "runs" | "asks" | "refused";
const ROWS: { action: string; bypass: Outcome; plan: Outcome }[] = [
  { action: "Read files, Git history and logs", bypass: "runs", plan: "runs" },
  { action: "Edit files", bypass: "runs", plan: "refused" },
  { action: "Commands, tests and builds", bypass: "runs", plan: "refused" },
  { action: "Git commits and pushes", bypass: "runs", plan: "refused" },
  { action: "Dev servers", bypass: "runs", plan: "refused" },
  { action: "Credentials and secrets", bypass: "asks", plan: "asks" },
];
const OUTCOME: Record<Outcome, string> = { runs: "Runs", asks: "Asks you", refused: "Refused" };
---
<div
  class:list={["pm", `pm--${width}`, className]}
  id={id}
  data-testid="permission-modes"
>
  <fieldset class="pm__modes">
    <legend class="visually-hidden">Permission mode for new coding agents</legend>
    {MODES.map((m) => (
      <label class="pm__mode" data-testid={`mode-${m.id}`}>
        <input type="radio" name={`${id}-mode`} value={m.id} checked={m.id === mode} class="pm__radio" />
        <span class="pm__mode-name">{m.label}</span>
        <span class="pm__mode-badge">{m.badge}</span>
      </label>
    ))}
  </fieldset>

  <div class="pm__hints">
    {MODES.map((m) => (
      <p class="pm__hint" data-for={m.id}>{m.hint}</p>
    ))}
  </div>

  <table class="pm__table">
    <caption class="visually-hidden">What a coding agent may do in Bypass and in Plan</caption>
    <thead class="visually-hidden">
      <tr>
        <th scope="col">Action</th>
        <th scope="col">Bypass</th>
        <th scope="col">Plan</th>
      </tr>
    </thead>
    <tbody>
      {ROWS.map((row) => (
        <tr>
          <th scope="row">{row.action}</th>
          <td data-col="bypass"><span class="pm__out" data-outcome={row.bypass}>{OUTCOME[row.bypass]}</span></td>
          <td data-col="plan"><span class="pm__out" data-outcome={row.plan}>{OUTCOME[row.plan]}</span></td>
        </tr>
      ))}
    </tbody>
  </table>

  <div class="pm__ask" aria-label="Example: a Needs You request">
    <p class="pm__ask-head">
      <span class="pm__ask-chip">Needs you</span>
      <span class="pm__ask-agent">Payments Webhook · Gemini CLI</span>
    </p>
    <p class="pm__ask-text">Wants to read <code>STRIPE_SECRET_KEY</code> in <code>.env.local</code></p>
    <p class="pm__ask-foot">
      <span>Credentials and secrets always ask.</span>
      <span class="pm__ask-actions" aria-hidden="true"><span>Deny</span><span data-primary>Approve once</span></span>
    </p>
  </div>
  <p class="pm__label" data-testid="stage-label">Product preview · sample data · every mode on every plan</p>
</div>

<style>
  .pm {
    display: grid;
    gap: 0.875rem;
    width: 100%;
    max-width: 30rem;
    margin-inline: auto;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--panel-sheen), var(--color-surface-1);
    box-shadow:
      var(--shadow-panel),
      0 40px 80px -48px var(--color-glow);
    color: var(--color-text);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
  }

  .pm__modes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.25rem;
    margin: 0;
    padding: 0.25rem;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    background: var(--color-bg-sunken);
    box-shadow: var(--shadow-well);
  }

  .pm__mode {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    padding: 0.375rem 0.75rem;
    border-radius: var(--radius-md);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition:
      background var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out);
  }

  .pm__mode:hover {
    color: var(--color-text);
  }

  .pm__radio {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .pm__mode:has(.pm__radio:checked) {
    background: var(--color-surface-3);
    color: var(--color-text);
    box-shadow:
      inset 0 0 0 1px var(--color-border-lit-soft),
      0 0 22px -10px var(--color-glow);
  }

  .pm__mode:has(.pm__radio:focus-visible) {
    outline: 2px solid var(--color-border-focus);
    outline-offset: 2px;
  }

  .pm__mode-name {
    font-weight: var(--weight-semibold);
  }

  .pm__mode-badge {
    padding: 0.0625rem 0.4375rem;
    border-radius: var(--radius-full);
    background: var(--color-surface-hover);
    color: var(--color-text-muted);
    font-size: 0.6875rem;
  }

  .pm__mode:has(.pm__radio:checked) .pm__mode-badge {
    background: var(--color-accent-soft);
    color: var(--color-accent-text);
  }

  .pm__hint {
    margin: 0;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .pm__table {
    width: 100%;
    border-collapse: collapse;
  }

  .pm__table th,
  .pm__table td {
    padding: 0.4375rem 0;
    border-top: 1px solid var(--color-border-subtle);
    text-align: left;
    font-weight: var(--weight-regular);
  }

  .pm__table th {
    color: var(--color-text);
  }

  .pm__table td {
    text-align: right;
  }

  .pm__out {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: var(--weight-medium);
  }

  .pm__out::before {
    content: "";
    width: 0.375rem;
    height: 0.375rem;
    border-radius: var(--radius-full);
    background: currentColor;
  }

  .pm__out[data-outcome="runs"] {
    background: var(--status-working-soft);
    color: var(--status-working-text);
  }

  .pm__out[data-outcome="asks"] {
    background: var(--status-waiting-soft);
    color: var(--status-waiting-text);
  }

  .pm__out[data-outcome="refused"] {
    background: var(--status-muted-soft);
    color: var(--status-muted-text);
  }

  /* The selected mode decides which column and hint show (CSS only, so it works without JS). */
  .pm__hint,
  .pm td[data-col] {
    display: none;
  }

  .pm:has(.pm__radio[value="bypass"]:checked) .pm__hint[data-for="bypass"],
  .pm:has(.pm__radio[value="plan"]:checked) .pm__hint[data-for="plan"] {
    display: block;
  }

  .pm:has(.pm__radio[value="bypass"]:checked) td[data-col="bypass"],
  .pm:has(.pm__radio[value="plan"]:checked) td[data-col="plan"] {
    display: table-cell;
  }

  .pm__ask {
    display: grid;
    gap: 0.375rem;
    padding: 0.75rem 0.875rem;
    border: 1px solid var(--status-waiting-line);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, var(--status-waiting-soft), transparent), var(--color-surface-2);
  }

  .pm__ask-head,
  .pm__ask-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .pm__ask-chip {
    padding: 0.0625rem 0.5rem;
    border-radius: var(--radius-full);
    background: var(--status-waiting-soft);
    color: var(--status-waiting-text);
    font-size: 0.6875rem;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pm__ask-agent,
  .pm__ask-foot > span:first-child {
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }

  .pm__ask-text {
    margin: 0;
    font-weight: var(--weight-medium);
  }

  .pm__ask-text code {
    padding: 0.0625rem 0.3125rem;
    border-radius: var(--radius-sm);
    background: var(--color-code-bg);
    color: var(--color-accent-icy);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .pm__ask-actions {
    display: inline-flex;
    gap: 0.375rem;
  }

  .pm__ask-actions span {
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    color: var(--color-text-secondary);
    font-size: 0.75rem;
  }

  .pm__ask-actions span[data-primary] {
    border-color: var(--btn-primary-edge);
    background: var(--btn-primary-bg);
    color: var(--btn-primary-fg);
  }

  .pm__label {
    margin: 0;
    color: var(--color-text-faint);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
  }

  @media (prefers-reduced-motion: reduce) {
    .pm__mode {
      transition: none;
    }
  }
</style>

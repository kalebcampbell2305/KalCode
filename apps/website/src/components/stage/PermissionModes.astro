---
/**
 * PermissionModes: choose Plan, Approve or Auto (Bypass and Custom are marked Planned; 0.1.5
 * threads never run in them) and see how much an agent may do on its own (Allow / Ask / Deny per
 * action, from /docs/permissions). Hovering or focusing a mode previews it. The approval card
 * shows what happens to Codex's `pnpm add zod` in that mode; when the mode asks, Deny · Allow for
 * thread · Approve once decide it, and "Ask again" resets.
 */
import StageStyles from "./parts/StageStyles.astro";
import type { PermissionMode } from "../../data/story";
import PermissionsPanel from "./parts/PermissionsPanel.astro";
import { stageTag } from "../../lib/stage-status";
import StageLabel from "./parts/StageLabel.astro";

interface Props {
  id?: string;
  mode?: PermissionMode;
  headingLevel?: 2 | 3 | 4;
  /** compact: the small permissions table (about 380 × 260, no outer frame) for a card the page draws. */
  width?: "compact" | "contained" | "wide" | "full";
  class?: string;
}
const { id = "permission-modes", mode = "approve", width = "contained", class: className } = Astro.props;
const compact = width === "compact";
---
<StageStyles />
<div
  class:list={["kc-pm", compact ? "kc-pm--compact" : `kc-w--${width}`, className]}
  id={id}
  data-kc-app
  data-kc-auto="true"
  data-interactive="true"
  data-approval="pending"
  data-mode={mode}
  data-panes=""
  data-dock="none"
  data-testid="permission-modes"
>
  {!compact && <StageLabel tag="Modes as designed · the mode switcher is in development" />}
  <PermissionsPanel uid={id} mode={mode} approval="pending" interactive={true} variant={compact ? "table" : "full"} resettable={!compact} />
  {compact && (
    <StageLabel
      class="kc-pm__label"
      tag={stageTag({ tag: "Modes as designed", stableTag: "Plan, Approve and Auto in Stable {version} · Bypass and Custom planned" })}
    />
  )}
  <p class="visually-hidden" aria-live="polite" data-kc-live data-testid={`live-${id}`}></p>
</div>

<script>
  import { initAutoApps } from "../../scripts/stage/app";
  initAutoApps();
</script>

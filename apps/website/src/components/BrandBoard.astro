---
/**
 * A full brand board (the owner's KalCode or KalVoice board), shown as a marketing visual.
 * Exported unmodified by tooling/generate-brand-assets.py as AVIF with a WebP fallback at
 * 627/1254 widths. The boards carry their own dark ground, so they are framed in both themes.
 */
interface Props {
  board: "kalcode" | "kalvoice";
  sizes: string;
  alt: string;
  /** Above the fold: eager, high fetch priority. */
  priority?: boolean;
}

const { board, sizes, alt, priority = false } = Astro.props;
const base = `/assets/brand/${board}-board`;
const widths = [627, 1254];
const srcset = (format: "avif" | "webp") => widths.map((w) => `${base}-${w}.${format} ${w}w`).join(", ");
---
<figure class="brand-board">
  <picture>
    <source type="image/avif" srcset={srcset("avif")} sizes={sizes} />
    <source type="image/webp" srcset={srcset("webp")} sizes={sizes} />
    <img
      src={`${base}-1254.webp`}
      width="1254"
      height="1254"
      alt={alt}
      decoding="async"
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : "auto"}
    />
  </picture>
</figure>

---
import Lettering from "./Lettering.astro";

/**
 * A drawn design preview of the Dashboard concept. It is a picture made of HTML, not a
 * control surface: hidden from assistive technology (the figcaption and description carry the
 * meaning), nothing is focusable, and the depicted buttons have no pointer or hover states.
 */
const threads = [
  {
    title: "Refactor session storage",
    provider: "Claude Code",
    workspace: "core",
    status: "live",
    label: "Running",
    time: "12m",
  },
  {
    title: "Add rate limiting to signup",
    provider: "Codex",
    workspace: "web",
    status: "waiting",
    label: "Needs approval",
    time: "4m",
  },
  {
    title: "Write migration upgrade tests",
    provider: "Gemini CLI",
    workspace: "core",
    status: "live",
    label: "Running",
    time: "7m",
  },
  {
    title: "Update API reference",
    provider: "Claude Code",
    workspace: "docs",
    status: "done",
    label: "Done · verified",
    time: "25m",
  },
] as const;

const activity = [
  { time: "10:42", who: "KalVoice", text: "opened a Gemini CLI thread for “Write migration upgrade tests”" },
  { time: "10:44", who: "Codex", text: "requested package.install in web" },
  { time: "10:45", who: "Claude Code", text: "tests passed for “Update API reference”" },
] as const;
---
<figure class="preview-figure">
  <div class="preview" aria-hidden="true">
    <div class="preview__titlebar">
      <Lettering name="kalcode-wordmark" class="wordmark" />
      <span>Dashboard</span>
      <span class="preview__profile"><span class="status status--live">Approve mode</span></span>
    </div>
    <div class="preview__body">
      <div class="preview__sidebar">
        <div class="preview__nav-item preview__nav-item--active">Dashboard</div>
        <div class="preview__nav-item">KalVoice</div>
        <div class="preview__nav-item">Code</div>
        <div class="preview__nav-item">Threads</div>
        <div class="preview__nav-item">Providers</div>
      </div>
      <div class="preview__main">
        <div class="preview__header">
          <span class="preview__title">Dashboard</span>
          <span class="preview__counts">
            <span>3 threads running</span>
            <span>1 waiting for you</span>
            <span>3 providers connected</span>
          </span>
        </div>
        <div class="preview__table">
          <div class="preview__row preview__row--head">
            <span>Thread</span>
            <span>Provider</span>
            <span>Workspace</span>
            <span>Status</span>
            <span class="preview__time">Time</span>
          </div>
          {
            threads.map((thread) => (
              <div class="preview__row">
                <span class="preview__thread">{thread.title}</span>
                <span class="preview__meta">
                  {thread.provider} · {thread.workspace}
                </span>
                <span class="preview__provider">{thread.provider}</span>
                <span class="preview__workspace">{thread.workspace}</span>
                <span class="preview__status">
                  <span class={`status status--${thread.status}`}>{thread.label}</span>
                </span>
                <span class="preview__time">{thread.time}</span>
              </div>
            ))
          }
        </div>
        <div class="preview__lower">
          <div class="preview__request">
            <span class="preview__request-title">Codex wants to run a command</span>
            <span class="preview__command">pnpm add @cloudflare/workers-types --save-dev</span>
            <span class="preview__request-meta">
              <span>Thread: Add rate limiting to signup</span>
              <span>Scope: package.install</span>
            </span>
            <span class="preview__decisions">
              <span class="preview__decision">Deny</span>
              <span class="preview__decision">Approve once</span>
              <span class="preview__decision preview__decision--primary">Allow for thread</span>
            </span>
          </div>
          <div class="preview__activity">
            {
              activity.map((item) => (
                <div class="preview__activity-item">
                  <time>{item.time}</time>
                  <span>
                    <strong>{item.who}</strong> {item.text}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
  <figcaption>
    Design preview of the KalCode Dashboard, in development. This is an illustration, not a
    screenshot of released software.
    <span class="visually-hidden">
      It shows four threads: two running on Claude Code and Gemini CLI, one finished and
      verified, and one from Codex waiting for approval to install a package, with the choices
      Deny, Approve once, and Allow for thread.
    </span>
  </figcaption>
</figure>

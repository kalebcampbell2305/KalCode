---
/**
 * Header for every page except home: an optional status chip, a heavy display title, a lead,
 * and an optional slot for actions.
 */
interface Props {
  title: string;
  lead?: string;
  /** One-line truth label shown as a chip above the title, e.g. "In private development". */
  status?: string;
  /** Chip dot: in development (amber), built (green), plain (no dot). */
  statusKind?: "dev" | "built" | "plain";
}
const { title, lead, status, statusKind = "dev" } = Astro.props;
---
<header class="page-head">
  <div class="container page-head__inner">
    {status && <p class:list={["chip", `chip--${statusKind}`]}>{status}</p>}
    <h1 class="h1">{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</header>

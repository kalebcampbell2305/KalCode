---
import { ACCOUNT_PAGE, PRIMARY_NAV } from "../lib/site";
import BrandMark from "./BrandMark.astro";
import Icon from "./Icon.astro";
import Lettering from "./Lettering.astro";
import XLink from "./XLink.astro";

interface Props {
  path: string;
}
const { path } = Astro.props;

function current(href: string): "page" | "true" | undefined {
  if (path === href) return "page";
  if (href !== "/" && path.startsWith(`${href}/`)) return "true";
  return undefined;
}
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand-link" href="/" aria-label="KalCode home">
      <BrandMark size={28} />
      <Lettering name="kalcode-wordmark" class="wordmark" />
    </a>
    <nav class="site-nav" id="site-nav" aria-label="Main" data-site-nav>
      <ul class="site-nav__list" role="list">
        {
          PRIMARY_NAV.map((item) => (
            <li>
              <a class="site-nav__link" href={item.href} aria-current={current(item.href)}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="site-nav__utility">
          <a class="site-nav__utility-link" href={ACCOUNT_PAGE.path} aria-current={current(ACCOUNT_PAGE.path)}>
            Account
          </a>
        </li>
        <li class="site-nav__social">
          <XLink account="official" withHandle="menu" />
        </li>
        <li class="site-nav__cta">
          <a class="button button--primary button--sm" href="/download" aria-current={current("/download")}>
            Download
          </a>
        </li>
      </ul>
    </nav>
    <div class="header-tools">
      <a class="button button--primary button--sm" href="/download">Download</a>
      <button
        type="button"
        class="menu-button"
        aria-expanded="false"
        aria-controls="site-nav"
        aria-label="Menu"
        data-menu-button
      >
        <Icon name="menu" class="icon-menu" />
        <Icon name="close" class="icon-close" />
      </button>
    </div>
  </div>
</header>

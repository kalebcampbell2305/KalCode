---
import { buildStatus, RELEASES } from "../lib/releases";
import { ACCOUNT_PAGE, FOOTER_NAV, TAGLINE } from "../lib/site";
import BrandMark from "./BrandMark.astro";
import Lettering from "./Lettering.astro";
import ThemeToggle from "./ThemeToggle.astro";
import XLink from "./XLink.astro";

interface Props {
  /** Reading pages offer the theme choice; world pages are always dark (docs/WEBSITE.md). */
  themeToggle?: boolean;
}
const { themeToggle = true } = Astro.props;

const columns = [
  { heading: "Product", links: [...FOOTER_NAV.product, { href: ACCOUNT_PAGE.path, label: "Account" }] },
  { heading: "Docs", links: FOOTER_NAV.docs },
  { heading: "Legal", links: FOOTER_NAV.legal },
] as const;
---
<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <a class="brand-link" href="/" aria-label="KalCode home">
          <BrandMark size={36} lazy />
          <Lettering name="kalcode-wordmark" class="wordmark" />
        </a>
        <p class="tagline">{TAGLINE.split(". ").map((part, index, all) => <span>{index < all.length - 1 ? `${part}.` : part}</span>)}</p>
      </div>
      {
        columns.map((column) => (
          <nav aria-label={column.heading}>
            <h2>{column.heading}</h2>
            <ul role="list">
              {column.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
      <nav aria-label="Follow">
        <h2>Follow</h2>
        <ul role="list">
          <li><XLink account="official" withHandle /></li>
          <li><XLink account="founder" withHandle /></li>
        </ul>
      </nav>
    </div>
    <div class="site-footer__base">
      <div class="site-footer__legal">
        <p>© 2026 KalCode</p>
        <p>{RELEASES.latest ? `${buildStatus()}. More in development.` : "KalCode is in private development."}</p>
      </div>
      {themeToggle && <ThemeToggle />}
    </div>
  </div>
</footer>

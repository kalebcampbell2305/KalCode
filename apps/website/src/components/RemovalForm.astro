---
const id = "remove";
---
<form method="post" class="form needs-js" data-api-form="remove" novalidate>
  <label class="form__label" for={`${id}-email`}>Email address to remove</label>
  <div class="form__row">
    <input
      id={`${id}-email`}
      class="form__input"
      type="email"
      name="email"
      autocomplete="email"
      inputmode="email"
      autocapitalize="off"
      spellcheck="false"
      maxlength="254"
      required
      aria-describedby={`${id}-status`}
      placeholder="name@example.com"
    />
    <button class="button button--secondary" type="submit">Email me a removal link</button>
  </div>
  <p id={`${id}-status`} class="form__status" role="status" aria-live="polite"></p>
</form>
<noscript>
  <p class="form__consent">
    Removing your email needs JavaScript, which is turned off in this browser. Turn it on and
    reload this page to use the form.
  </p>
</noscript>
<script>
  import "../scripts/forms";
</script>

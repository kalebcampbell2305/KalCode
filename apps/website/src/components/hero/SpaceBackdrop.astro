---
/**
 * SpaceBackdrop: a static piece of the KalCode world behind a section. Imagery is derived from the
 * owner's KalCode banner (tooling/generate-hero-world.py) or rendered procedurally once into static
 * images (tooling/generate-space-art.py). No stock imagery, no hand-drawn lookalikes.
 *
 * Fills its positioned parent (position:absolute; inset:0; z-index:0), aria-hidden, no continuous
 * motion: images are lazy, and one shared IntersectionObserver lets the light settle in once when
 * the section first enters the viewport (instant with reduced motion; without JS it is simply
 * shown). Put the section content above it (position:relative; z-index:1). Several backdrops can
 * be stacked in one section (e.g. "deep" + "planet").
 *
 * PROPS
 *   variant    "nebula"   nebula crown and soft light falling from above (calm, atmospheric)
 *              "deep"     starfield and faint navy depth (the quietest)
 *              "orbital"  the banner's ring platform along the bottom edge (energy; product base)
 *              "gravity"  the sky pulled into a gravitational lens around the centre (depth funnel)
 *              "horizon"  a planet's luminous blue rim across the lower sky behind dark rocky
 *                         terrain (pricing, final CTA, footer); rocks={false} gives the banner's
 *                         planet-horizon light band alone
 *              "planet"   a large dark planet partly off-canvas at a page edge, rim-lit in blue,
 *                         with a small moon (see side / size)
 *              "void"     dark void with faint horizontal wave-energy lines (KalVoice)
 *              "vault"    security-toned darkness: a faint perspective grid under a cold vignette
 *                         (permissions, local-first)
 *   intensity  "low" | "medium" (default) | "high"
 *   side       planet: "left" | "right" (default "right")
 *   size       planet: "md" | "lg" (default) | "xl"
 *   rocks      horizon: include the rocky foreground (default true)
 *   class      extra classes for the root
 *
 * Hooks: every layer has a stable class (space-backdrop__stars / __art / __moon / __light), and
 * the root carries space-backdrop--<variant>, --<intensity>, --side-<side>, --size-<size>.
 */
import "./space-backdrop.css";

type Variant = "nebula" | "deep" | "orbital" | "gravity" | "horizon" | "planet" | "void" | "vault";

interface Props {
  variant: Variant;
  intensity?: "low" | "medium" | "high";
  side?: "left" | "right";
  size?: "md" | "lg" | "xl";
  rocks?: boolean;
  class?: string;
}

const { variant, intensity = "medium", side = "right", size = "lg", rocks = true, class: extra } = Astro.props;
const dir = "/assets/hero/world";

interface Art {
  stem: string;
  width: number;
  height: number;
  avif: boolean;
}
const ART: Record<Variant, Art | null> = {
  nebula: { stem: "backdrop-nebula", width: 1320, height: 330, avif: true },
  deep: null,
  orbital: { stem: "backdrop-orbital", width: 1672, height: 341, avif: true },
  gravity: { stem: "backdrop-gravity", width: 1000, height: 520, avif: true },
  horizon: rocks
    ? { stem: "rocky-horizon", width: 2400, height: 1000, avif: true }
    : { stem: "backdrop-horizon", width: 1672, height: 180, avif: true },
  planet: { stem: "planet-rim", width: 1400, height: 1400, avif: true },
  void: { stem: "void-waves", width: 2000, height: 900, avif: true },
  vault: null,
};
const art = ART[variant];
const stars = variant !== "horizon" || !rocks;
---
<div
  class:list={[
    "space-backdrop",
    `space-backdrop--${variant}`,
    `space-backdrop--${intensity}`,
    variant === "planet" && [`space-backdrop--side-${side}`, `space-backdrop--size-${size}`],
    variant === "horizon" && !rocks && "space-backdrop--band",
    extra,
  ]}
  data-space-backdrop
  aria-hidden="true"
>
  {
    stars && (
      <img
        class="space-backdrop__stars"
        src={`${dir}/backdrop-stars.webp`}
        width="1672"
        height="560"
        alt=""
        loading="lazy"
        decoding="async"
      />
    )
  }
  {
    art && (
      <picture class="space-backdrop__art">
        {art.avif && <source type="image/avif" srcset={`${dir}/${art.stem}.avif`} />}
        <img src={`${dir}/${art.stem}.webp`} width={art.width} height={art.height} alt="" loading="lazy" decoding="async" />
      </picture>
    )
  }
  {
    variant === "planet" && (
      <img
        class="space-backdrop__moon"
        src={`${dir}/planet-small.webp`}
        width="520"
        height="520"
        alt=""
        loading="lazy"
        decoding="async"
      />
    )
  }
  <span class="space-backdrop__light"></span>
</div>

<script>
  import "../../scripts/hero/backdrop";
</script>

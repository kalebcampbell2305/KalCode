---
/**
 * A keyboard shortcut, marked up as nested <kbd> elements (the HTML pattern for a key
 * combination), e.g. Ctrl+Shift+K.
 */
interface Props {
  keys: readonly string[];
}
const { keys } = Astro.props;
---
<kbd class="shortcut">{keys.map((key, index) => (index === 0 ? <kbd>{key}</kbd> : <Fragment>+<kbd>{key}</kbd></Fragment>))}</kbd>

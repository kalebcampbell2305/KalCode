---
/**
 * Build status per operating system, straight from the release manifest. A platform gets a
 * download button only when it is in `latest.platforms`; otherwise the manifest's own reason is
 * shown and there is no link. The row matching the visitor's system is marked by
 * scripts/platform.ts (progressive enhancement; nothing depends on it).
 */
import { type ReleaseManifest, RELEASES, formatBytes, formatReleaseDate, platformRows } from "../lib/releases";
import Icon from "./Icon.astro";

interface Props {
  manifest?: ReleaseManifest;
}
const { manifest = RELEASES } = Astro.props;
const rows = platformRows(manifest);
const latest = manifest.latest;
const releaseLabel = latest?.channel === "stable" ? "Stable" : "Preview";
const releaseNoun = latest?.channel === "stable" ? "stable build" : "preview";
const terms = latest?.channel === "stable"
  ? { href: "/terms", label: "KalCode terms" }
  : { href: "/terms#preview", label: "KalCode preview terms" };
// Release manifests published before Updates keep working, while new page links stay canonical.
const notesUrl = latest?.notesUrl.replace(/^\/changelog(?=#|$)/, "/updates");

function signatureLabel(os: (typeof rows)[number]["os"], signed: boolean): string {
  if (signed) return "Code-signed";
  return os === "macos" ? "Not code-signed or notarized" : "Not code-signed";
}

function checksumCommand(os: (typeof rows)[number]["os"], file: string): string {
  if (os === "windows") return `Get-FileHash .\\${file} -Algorithm SHA256`;
  if (os === "macos") return `shasum -a 256 "./${file}"`;
  return `sha256sum "./${file}"`;
}
---
<ul class="platforms" role="list" data-platforms>
  {
    rows.map((row) => (
      <li class="platform" id={row.os} data-os={row.os} data-state={row.state}>
        <div class="platform__head">
          <h3 class="platform__name">{row.name}</h3>
          {row.state === "available" && latest ? (
            <span class="chip chip--built">
              {releaseLabel} {latest.version}
            </span>
          ) : (
            <span class="chip">Not yet available</span>
          )}
          <span class="chip chip--live platform__you">Your system</span>
        </div>
        {row.state === "available" && latest ? (
          <>
            <p class="platform__state">{row.build.label}</p>
            <dl class="platform__meta">
              <div>
                <dt>Version</dt>
                <dd>
                  {latest.version} · published <time datetime={latest.publishedAt}>{formatReleaseDate(latest.publishedAt)}</time>
                </dd>
              </div>
              <div>
                <dt>File</dt>
                <dd class="mono">{row.build.file}</dd>
              </div>
              <div>
                <dt>Size</dt>
                <dd>{formatBytes(row.build.size)}</dd>
              </div>
              <div>
                <dt>SHA-256</dt>
                <dd class="mono" data-sha256>{row.build.sha256}</dd>
              </div>
              <div>
                <dt>Signature</dt>
                <dd>{signatureLabel(row.os, row.build.signed)}</dd>
              </div>
            </dl>
            {!row.build.signed && (
              <p class="platform__note">
                {row.os === "windows" ? (
                  <>This {releaseNoun} is not code-signed, so Windows SmartScreen may warn you. Verify its SHA-256 before opening it.</>
                ) : row.os === "macos" ? (
                  <>This {releaseNoun} is not code-signed or notarized. Verify its SHA-256 before opening it. KalCode does not ask you to bypass Gatekeeper.</>
                ) : (
                  <>This {releaseNoun} is not code-signed. Verify its SHA-256 before opening it.</>
                )}
              </p>
            )}
            <p class="platform__note">
              Verify the downloaded file with <code>{checksumCommand(row.os, row.build.file)}</code> and compare it with the SHA-256 above.
            </p>
            <div class="platform__action button-row">
              <a class="button button--primary button--lg" href={row.build.url} download={row.build.file}>
                <Icon name="download" />
                Download for {row.name}
              </a>
              <a class="text-link" href={notesUrl}>Release notes</a>
            </div>
            <p class="muted small">
              By downloading or using KalCode you agree to the{" "}
              <a href={terms.href}>{terms.label}</a>.
            </p>
          </>
        ) : (
          row.state === "unavailable" && (
            <p class="platform__state">
              {row.reason}
              {row.label !== row.name && <span class="platform__req"> Target: {row.label}.</span>}
            </p>
          )
        )}
      </li>
    ))
  }
</ul>
<script>
  import "../scripts/platform";
</script>

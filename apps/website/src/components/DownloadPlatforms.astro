---
/**
 * Build status per operating system, straight from the release manifest. A platform gets a
 * download button only when it is in `latest.platforms`; otherwise the manifest's own reason is
 * shown and there is no link. The row matching the visitor's system is marked by
 * scripts/platform.ts (progressive enhancement; nothing depends on it).
 */
import { type ReleaseManifest, RELEASES, formatBytes, formatReleaseDate, platformRows } from "../lib/releases";
import Icon from "./Icon.astro";

interface Props {
  manifest?: ReleaseManifest;
}
const { manifest = RELEASES } = Astro.props;
const rows = platformRows(manifest);
const latest = manifest.latest;
---
<ul class="platforms" role="list" data-platforms>
  {
    rows.map((row) => (
      <li class="platform" id={row.os} data-os={row.os} data-state={row.state}>
        <div class="platform__head">
          <h3 class="platform__name">{row.name}</h3>
          {row.state === "available" && latest ? (
            <span class="chip chip--built">
              Preview {latest.version}
            </span>
          ) : (
            <span class="chip">Not yet available</span>
          )}
          <span class="chip chip--live platform__you">Your system</span>
        </div>
        {row.state === "available" && latest ? (
          <>
            <p class="platform__state">{row.build.label}</p>
            <dl class="platform__meta">
              <div>
                <dt>Version</dt>
                <dd>
                  {latest.version} · published <time datetime={latest.publishedAt}>{formatReleaseDate(latest.publishedAt)}</time>
                </dd>
              </div>
              <div>
                <dt>File</dt>
                <dd class="mono">{row.build.file}</dd>
              </div>
              <div>
                <dt>Size</dt>
                <dd>{formatBytes(row.build.size)}</dd>
              </div>
              <div>
                <dt>SHA-256</dt>
                <dd class="mono" data-sha256>{row.build.sha256}</dd>
              </div>
              <div>
                <dt>Signature</dt>
                <dd>{row.build.signed ? "Code-signed" : "Not code-signed (preview)"}</dd>
              </div>
            </dl>
            {!row.build.signed && (
              <p class="platform__note">
                This preview is not code-signed yet, so Windows SmartScreen will say it protected your
                PC. Check the SHA-256 first, then choose <strong>More info</strong> and{" "}
                <strong>Run anyway</strong>.
              </p>
            )}
            <div class="platform__action button-row">
              <a class="button button--primary button--lg" href={row.build.url} download={row.build.file}>
                <Icon name="download" />
                Download for {row.name}
              </a>
              <a class="text-link" href={latest.notesUrl}>Release notes</a>
            </div>
            <p class="platform__note">
              By downloading or using KalCode you agree to the{" "}
              <a href="/terms#preview">KalCode preview terms</a>.
            </p>
          </>
        ) : (
          row.state === "unavailable" && (
            <p class="platform__state">
              {row.reason}
              {row.label !== row.name && <span class="platform__req"> Target: {row.label}.</span>}
            </p>
          )
        )}
      </li>
    ))
  }
</ul>
<script>
  import "../scripts/platform";
</script>

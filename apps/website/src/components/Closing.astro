---
/**
 * The closing moment: a small lit KalCode orb above a planet horizon and a rocky ridge.
 * Driven by the release manifest: with a published build it is the download; without one it
 * says so and carries the early-access form (home) or links to it (other pages). Only one
 * early-access form ever appears on a page.
 */
import { RELEASES, channelLabel, downloadCta, releaseSystems } from "../lib/releases";
import type { PagePath } from "../lib/site";
import Backdrop from "./Backdrop.astro";
import BrandMark from "./BrandMark.astro";
import DownloadButton from "./DownloadButton.astro";
import EarlyAccessForm from "./EarlyAccessForm.astro";
import XLink from "./XLink.astro";

interface Props {
  /** When set and there is no public build, the early-access form is rendered here. */
  formSource?: PagePath;
  title?: string;
}
const { formSource, title } = Astro.props;
const cta = downloadCta(RELEASES);
const heading = title ?? "Be first to run KalCode.";
// Named from the manifest's channel and platforms, so a Stable release never reads as a preview.
const released =
  channelLabel(RELEASES) === "Stable"
    ? `KalCode ${RELEASES.latest?.version} is out for ${releaseSystems(RELEASES)}.`
    : `The preview is out for ${releaseSystems(RELEASES)}.`;
---
<section class="finale" id="early-access" aria-labelledby="closing-title">
  <Backdrop variant="horizon" />
  <div class="container closing">
    <span class="finale__orb"><BrandMark size={72} lazy /></span>
    <h2 id="closing-title" class="h2">{heading}</h2>
    {
      cta.kind === "download" ? (
        <>
          <p>{released} Your providers, your projects, one workspace.</p>
          <div class="button-row">
            <DownloadButton />
            <a class="button button--secondary button--lg" href="/download">All platforms</a>
          </div>
          <p class="closing__note">{cta.note}</p>
        </>
      ) : formSource ? (
        <>
          <p>There is no public build yet. Early-access members hear first when there is one to try.</p>
          <EarlyAccessForm source={formSource} />
          <p class="closing__note">
            Progress in the open: <XLink account="official" withHandle />
          </p>
        </>
      ) : (
        <>
          <p>There is no public build yet. Early-access members hear first when there is one to try.</p>
          <div class="button-row">
            <DownloadButton />
          </div>
          <p class="closing__note">{cta.note}</p>
        </>
      )
    }
  </div>
</section>

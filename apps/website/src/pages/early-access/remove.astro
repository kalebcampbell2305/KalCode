---
import EmailAction from "../../components/EmailAction.astro";
import PageHead from "../../components/PageHead.astro";
import Base from "../../layouts/Base.astro";
import { EMAIL_ACTION_PAGES } from "../../lib/site";

// Opened from a link in an email: never indexed, and the link's code never leaves in a Referer.
const page = EMAIL_ACTION_PAGES.remove;
---
<Base title={page.title} description={page.description} path={page.path} noindex>
  <meta slot="head" name="referrer" content="no-referrer" />
  <PageHead title="Remove your email" lead="Leave the KalCode early-access list." />
  <EmailAction action="remove" />
</Base>

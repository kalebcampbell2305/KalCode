---
import { PLANS, formatKalVoiceAllowance } from "@kalcode/protocol/plans";
import PageHead from "../components/PageHead.astro";
import XLink from "../components/XLink.astro";
import Base from "../layouts/Base.astro";
import { RELEASES, channelLabel, formatReleaseDate, signedStableRelease } from "../lib/releases";
import { getPage } from "../lib/site";

const page = getPage("/updates");
const signedStable = signedStableRelease(RELEASES);
const stable016 = signedStable?.version === "0.1.6" ? signedStable : null;
const stable017 = signedStable?.version === "0.1.7" ? signedStable : null;
const stable018 = signedStable?.version === "0.1.8" ? signedStable : null;
const stable019 = signedStable?.version === "0.1.9" ? signedStable : null;
// 0.1.8 stays in the archive, un-featured, once a signed Stable 0.1.9 replaces it in the manifest.
const shows018 = Boolean(stable018 || stable019);
// 0.1.7 stays in the archive, un-featured, once a signed Stable 0.1.8 or later replaces it in the manifest.
const shows017 = Boolean(stable017 || shows018);
// 0.1.6 stays in the archive, un-featured, once a signed Stable 0.1.7 or later replaces it in the manifest.
const shows016 = Boolean(stable016 || shows017);
// 0.1.8's Stable publication time (0.1.8+901, releases.json at 9e3b4e1d), for when 0.1.9 is selected.
const published018 = stable018?.publishedAt ?? "2026-10-01T14:23:12.937Z";
// 0.1.7's Stable publication time (releases.json as deployed for 03eeabf6), for when 0.1.8 is selected.
const published017 = stable017?.publishedAt ?? "2026-09-30T18:25:35.409Z";
// 0.1.6's Stable publication time (releases.json as deployed at f1da08b5), for when 0.1.7 is selected.
const published016 = stable016?.publishedAt ?? "2026-09-30T02:34:07.332Z";
// The 0.1.7 entry's KalVoice orb line (primary TODO: final wording pending).
const KALVOICE_ORB_017 =
  "The orb now stops listening when you let go, cancel, or it times out, so you no longer need to press Esc.";
const servesPreview = channelLabel(RELEASES) === "Preview";
const allowances = PLANS.map((plan) => `${plan.name} ${formatKalVoiceAllowance(plan.limits)}`).join(", ");
// "Pro, MAX and MAX 2X": the plans that can be bought, named from PLANS.
const paidPlanNames = PLANS.filter((plan) => plan.price.monthlyUsd > 0).map((plan) => plan.name);
const paidPlans = [paidPlanNames.slice(0, -1).join(", "), paidPlanNames.at(-1)].filter(Boolean).join(" and ");

/**
 * Builds of 0.1.9 since it went Stable, newest first: user-facing highlights from
 * docs/releases/0.1.9+<build>.md, published when that build's releases.json was deployed. A build
 * is listed only once /download serves it or a later build, so the page never runs ahead of it.
 */
const BUILDS_019 = [
  {
    build: 1738,
    publishedAt: "2026-10-05T12:44:09.206Z",
    title: "One agent state everywhere, faster terminals, favorites and pins.",
    points: [
      "Every coding agent, on any provider, shows the same state in the Dashboard, the agent rail, Code and KalVoice: starting, working, waiting, needs you, ready, done or failed.",
      "Faster terminals: output is batched and written off the main thread, so busy agents and long builds stay smooth.",
      "When an account is limited, KalCode suggests another account you connected. It switches only when you choose to.",
      "Pin your favorite workspaces and destinations and reach them from anywhere.",
      "Agents keep their task names across restarts, Codex can use up to ten sub-agents, and your Codex rules files apply.",
      "Scheduled background sessions wait while your computer is busy, so the agents you start come first.",
    ],
  },
  {
    build: 1658,
    publishedAt: "2026-10-05T06:35:41.191Z",
    title: "Coding agents keep their native tools, in a new graphite look.",
    points: [
      "Claude Code and Codex search and fetch the web (in Plan mode too), use your own MCP servers, and run their shell, file and repo-search tools.",
      "Your setup follows every account: your SSH agent, GH_TOKEN and cloud credentials, plus CLAUDE.md, AGENTS.md and GEMINI.md, skills, plugins and commands.",
      "Codex uses your own config.toml and project trust, and Business, Enterprise and Edu accounts work. Gemini CLI runs in your real workspace with your MCP servers.",
      "A busy CPU never holds an agent you start. KalCode waits only when your computer genuinely can't run it, says why, and offers Start Anyway.",
      "A refined graphite design, with new Contrast and Text size settings under Appearance.",
      "The Providers page lists each provider's tools as native, needs setup or not offered.",
    ],
  },
  {
    build: 1565,
    publishedAt: "2026-10-04T22:55:23.122Z",
    title: "Go anywhere fast, and unlimited local agents on every plan.",
    points: [
      "Back and Forward retrace surfaces, workspaces and panes, and keep live terminals and Browser panes running.",
      "A universal quick switcher finds workspaces, Threads, agents, files, providers, accounts, settings, terminals, commands and releases.",
      "Breadcrumbs, recent navigation and consistent keyboard shortcuts.",
      "Every coding terminal header opens Account & usage. Choosing another account starts a fresh session and keeps the original.",
      "Smart Close protects active work, and New like this starts a fresh terminal with the same launch settings.",
      "Every plan supports unlimited local coding agents and terminals, subject to real provider and hardware limits.",
    ],
  },
] as const;
// The build /download serves, from its pinned file path (".../0.1.9+1738/...").
const servedBuild = Number(
  stable019?.platforms.map((platform) => platform.pinnedUrl.match(/\+(\d+)\//)?.[1]).find(Boolean) ?? 0,
);
const builds019 = BUILDS_019.filter((entry) => entry.build <= servedBuild);
---
<Base title={page.title} description={page.description} path={page.path} world>
  <PageHead
    eyebrow="Product news"
    title="Updates"
    lead="The releases, improvements, and product moments that change how you work in KalCode. Clear enough to scan. Detailed enough to matter."
    backdrop="orbital"
  >
    <nav class="updates-index" aria-label="Update archive">
      {stable019 && <a href="#release-0-1-9">0.1.9 Stable</a>}{shows018 && <a href="#release-0-1-8">0.1.8 Stable</a>}{shows017 && <a href="#release-0-1-7">0.1.7 Stable</a>}{shows016 && <a href="#release-0-1-6">0.1.6 Stable</a>}
      <a href="#release-0-1-1">Windows preview</a>
      <a href="#release-website-2026-09-24">New website</a>
      <a href="#release-kalvoice">KalVoice</a>
      <a href="#milestone-foundation">Foundation</a>
    </nav>
  </PageHead>

  <section class="section updates" aria-labelledby="updates-heading">
    <div class="container">
      <h2 class="visually-hidden" id="updates-heading">KalCode product updates</h2>
      <div class="updates-feed">
        {stable019 && (
          <article class="update update--featured" id="release-0-1-9" aria-labelledby="release-0-1-9-title">
            <div class="update__signal" aria-hidden="true"><span></span></div>
            <header class="update__meta">
              <p class="update__edition">KalCode 0.1.9</p>
              <p><time datetime={stable019.publishedAt}>{formatReleaseDate(stable019.publishedAt)}</time></p>
              <p class="chip chip--built">Stable · Windows and macOS</p>
              {builds019[0] && <p class="update__build">Build {builds019[0].build}</p>}
            </header>
            <div class="update__story">
              <p class="update__kicker">What's working, what needs you, what's shipping</p>
              <h2 id="release-0-1-9-title">KalCode 0.1.9 puts every agent, account and terminal in one command deck.</h2>
              <p class="update__lead">
                The Command Deck, Agent Fleet, the Provider Dock and KalVoice control of your workspace and
                agents, plus KalTidy and the Account Hub. Every build since installs when you close KalCode.
              </p>
              {
                builds019.length > 0 && (
                  <section class="builds" aria-labelledby="builds-0-1-9-title">
                    <h3 id="builds-0-1-9-title" class="builds__title">New in 0.1.9 builds</h3>
                    <ol class="builds__list" role="list">
                      {builds019.map((entry, index) => (
                        <li class:list={["build", { "build--latest": index === 0 }]} id={`build-${entry.build}`}>
                          <div class="build__meta">
                            <span class="build__number">Build {entry.build}</span>
                            <time datetime={entry.publishedAt}>{formatReleaseDate(entry.publishedAt)}</time>
                            {index === 0 && <span class="build__latest">Latest</span>}
                          </div>
                          <div class="build__body">
                            <p class="build__title">{entry.title}</p>
                            <ul class="build__points">
                              {entry.points.map((point) => (
                                <li>{point}</li>
                              ))}
                            </ul>
                          </div>
                        </li>
                      ))}
                    </ol>
                  </section>
                )
              }
              <h3 class="update__subhead">The 0.1.9 release</h3>
              <div class="update__groups">
                <section>
                  <h3>Moving to 0.1.9</h3>
                  <ul>
                    <li>From 0.1.8 or 0.1.7: update in the app with Restart to update or Settings &gt; Updates.</li>
                    <li>From 0.1.9 on, every update, including a new version, installs when you close KalCode.</li>
                    <li>Windows: 0.1.6 can't update itself. Download the 0.1.9 installer from the <a class="text-link" href="/download">download page</a> and run it once — your data is kept.</li>
                    <li>macOS: update from 0.1.6 in the app.</li>
                    <li>KalCode now saves each thread's reasoning effort, so Restore previous version only goes back to builds that can open that data.</li>
                  </ul>
                </section>
                <section>
                  <h3>Command Deck</h3>
                  <ul>
                    <li>See what's working, what needs you and what's shipping: workspace, branch, environment and mode up top, Projects on the left, every running agent on the right, builds, tests, provider health and shipping along the bottom.</li>
                    <li>Search and commands with Ctrl+K or Cmd+K.</li>
                  </ul>
                </section>
                <section>
                  <h3>Agent Fleet</h3>
                  <ul>
                    <li>Every agent is a live card: task name, account, branch, current action, changed files and whether it needs you.</li>
                    <li>Each new agent in a Git workspace works in its own worktree and branch, so parallel agents never change the same folder.</li>
                    <li>Ready to merge appears only when the agent finished, its work is committed and Git reports no conflicts.</li>
                  </ul>
                </section>
                <section>
                  <h3>Accounts</h3>
                  <ul>
                    <li>The Provider Dock shows every connected account with its sign-in health and running threads. Move a thread to another account from its menu, or drag it there and confirm.</li>
                    <li>Providers &gt; Accounts is a compact list grouped by provider, and accounts have the same names everywhere.</li>
                    <li>The Account Hub at the foot of the sidebar opens your plan, usage, billing, providers and settings.</li>
                  </ul>
                </section>
                <section>
                  <h3>KalVoice</h3>
                  <ul>
                    <li>Ask KalVoice to open or focus a thread, terminal, agent, Operations run or service, then say "open it" or "that one".</li>
                    <li>Start Claude Code or Codex agents on your signed-in accounts with a model and effort, and send them a prompt.</li>
                    <li>KalVoice can tell you when an agent finishes, fails or needs you.</li>
                  </ul>
                </section>
                <section>
                  <h3>Code</h3>
                  <ul>
                    <li>KalTidy stops idle terminals in one click and never stops agents, services, Operations work or the focused terminal.</li>
                    <li>Closing a terminal or agent pane now ends it.</li>
                    <li>Choose New like this to start an independent terminal or coding agent beside the original, with the same workspace, account, model and effort.</li>
                    <li>F8 push to talk works again right after you switch back to KalCode on Windows.</li>
                  </ul>
                </section>
                <section>
                  <h3>Plans</h3>
                  <ul>
                    <li>Every plan has unlimited local coding agents and terminals. Reaching a workspace or account limit never closes anything.</li>
                    <li>{paidPlans} can be bought monthly or yearly in the app.</li>
                  </ul>
                </section>
                <section>
                  <h3>Known issues</h3>
                  <ul>
                    <li>Codex agents can't commit inside their own worktree; use Commit changes on the agent's card.</li>
                  </ul>
                </section>
              </div>
              <p class="update__action"><a class="button button--primary" href="/download">Download KalCode</a></p>
            </div>
          </article>
        )}{shows018 && (
          <article
            class:list={["update", { "update--featured": Boolean(stable018) }]}
            id="release-0-1-8"
            aria-labelledby="release-0-1-8-title"
          >
            <div class="update__signal" aria-hidden="true"><span></span></div>
            <header class="update__meta">
              <p class="update__edition">KalCode 0.1.8</p>
              <p><time datetime={published018}>{formatReleaseDate(published018)}</time></p>
              <p class="chip chip--built">Stable · Windows and macOS</p>
            </header>
            <div class="update__story">
              <p class="update__kicker">From the queue to the result</p>
              <h2 id="release-0-1-8-title">KalCode 0.1.8 brings Operations to your workspace.</h2>
              <p class="update__lead">
                Queue, run and follow your project's work in one place. This release also brings the new
                KalCode logo, fixes a Windows freeze and a KalVoice crash when memory is low, and improves
                terminal focus, terminal limits and KalVoice.
              </p>
              <div class="update__groups">
                <section>
                  <h3>Moving to 0.1.8</h3>
                  <ul>
                    <li>From 0.1.7: update in the app with Restart to update or Settings &gt; Updates.</li>
                    <li>Windows: 0.1.6 can't update itself. Download the 0.1.8 installer from the <a class="text-link" href="/download">download page</a> and run it once — your data is kept.</li>
                    <li>macOS: update from 0.1.6 in the app.</li>
                  </ul>
                </section>
                <section>
                  <h3>Operations</h3>
                  <ul>
                    <li>A new Operations page: Runs, Queue, Services, Environments and Activity.</li>
                    <li>Queue agent work, builds, tests, scripts and deploys with dependencies and priority. Nothing runs until you confirm it, and a restart never reruns work on its own.</li>
                    <li>Each run keeps its output log and the files a command reports as its outputs.</li>
                    <li>See the processes and ports in your workspaces, and stop or restart the services Operations started.</li>
                    <li>Local, Preview, Staging and Production for each workspace, with deploys marked unverified until a health check exists.</li>
                  </ul>
                </section>
                <section>
                  <h3>Terminals</h3>
                  <ul>
                    <li>A focused terminal pane plays one quick blue trace around its edge, then keeps a thin blue outline.</li>
                    <li>Amber now means a thread or terminal is waiting for you.</li>
                    <li>Terminal limits follow your plan: 12 per workspace on Free and Pro, no KalCode limit on MAX and MAX 2X.</li>
                  </ul>
                </section>
                <section>
                  <h3>KalVoice</h3>
                  <ul>
                    <li>KalVoice prepares its speech model once per take, before the microphone opens.</li>
                    <li>When memory is low, KalVoice stops the recording and tells you, instead of closing KalCode.</li>
                    <li>The widget no longer covers pane controls while it shows a problem.</li>
                  </ul>
                </section>
                <section>
                  <h3>Updates and fixes</h3>
                  <ul>
                    <li>Later builds of 0.1.8 install by themselves when you close KalCode, so the next launch runs them. The update prompt is for new versions.</li>
                    <li>Restore previous version only goes back to a build that can open your data.</li>
                    <li>Fixed on Windows: KalCode could stop responding when keyboard focus moved away from it.</li>
                    <li>The new KalCode logo, now the app icon on Windows and macOS.</li>
                  </ul>
                </section>
                <section>
                  <h3>Known issues</h3>
                  <ul>
                    <li>After updating, KalVoice's on-device intelligence can take a few minutes to become ready while KalCode finishes cleaning up the previous version's worker; it then starts on its own.</li>
                  </ul>
                </section>
              </div>
              <p class="update__action"><a class="button button--primary" href="/download">Download KalCode</a></p>
            </div>
          </article>
        )}{shows017 && (
          <article
            class:list={["update", { "update--featured": Boolean(stable017) }]}
            id="release-0-1-7"
            aria-labelledby="release-0-1-7-title"
          >
            <div class="update__signal" aria-hidden="true"><span></span></div>
            <header class="update__meta">
              <p class="update__edition">KalCode 0.1.7</p>
              <p><time datetime={published017}>{formatReleaseDate(published017)}</time></p>
              <p class="chip chip--built">Stable · Windows and macOS</p>
            </header>
            <div class="update__story">
              <p class="update__kicker">Updates that finish on Windows</p>
              <h2 id="release-0-1-7-title">KalCode 0.1.7 fixes in-app updates on Windows.</h2>
              <p class="update__lead">
                In-app Update and Restore previous version now launch the installer on Windows, and the
                release includes more update and KalVoice fixes.
              </p>
              <div class="update__groups">
                <section>
                  <h3>Moving from 0.1.6</h3>
                  <ul>
                    <li>Windows: 0.1.6 can't update itself. Download the 0.1.7 installer from the <a class="text-link" href="/download">download page</a> and run it once — your data is kept.</li>
                    <li>macOS: update from 0.1.6 in the app.</li>
                  </ul>
                </section>
                <section>
                  <h3>Updates</h3>
                  <ul>
                    <li>Windows: in-app Update and Restore previous version now launch the installer. In 0.1.6 they can't start the installer.</li>
                    <li>If a provider sign-in or a file or folder dialog is open when you update, KalCode now tells you to close it and try again.</li>
                    <li>Fixed: Restore previous version clicked while an update is installing.</li>
                    <li>Fixed: signing out while an update is starting.</li>
                    <li>Fixed on macOS: a hidden temporary copy left behind after quitting while an update was being prepared.</li>
                  </ul>
                </section>
                <section>
                  <h3>KalVoice</h3>
                  <ul>
                    <li>{KALVOICE_ORB_017}</li>
                  </ul>
                </section>
              </div>
              <p class="update__action"><a class="button button--primary" href="/download">Download KalCode</a></p>
            </div>
          </article>
        )}{shows016 && (
          <article
            class:list={["update", { "update--featured": Boolean(stable016) }]}
            id="release-0-1-6"
            aria-labelledby="release-0-1-6-title"
          >
            <div class="update__signal" aria-hidden="true"><span></span></div>
            <header class="update__meta">
              <p class="update__edition">KalCode 0.1.6</p>
              <p><time datetime={published016}>{formatReleaseDate(published016)}</time></p>
              <p class="chip chip--built">Stable · Windows and macOS</p>
            </header>
            <div class="update__story">
              <p class="update__kicker">Your workspace, ready when you return</p>
              <h2 id="release-0-1-6-title">KalCode Stable brings local voice to your coding workspace.</h2>
              <p class="update__lead">
                Work with Claude Code and Codex through their official accounts, use local
                dictation, and keep track of your projects in one desktop application.
              </p>
              <div class="update__groups">
                <section>
                  <h3>Account and recovery</h3>
                  <ul>
                    <li>Browser sign-in returns to KalCode automatically.</li>
                    <li>Valid saved sessions restore when you reopen the app.</li>
                    <li>Interrupted workspaces recover automatically when KalCode can verify that previous processes and cleanup have finished.</li>
                  </ul>
                </section>
                <section>
                  <h3>KalVoice</h3>
                  <ul>
                    <li>Push-to-talk controls, a floating widget and voice settings in the Stable app.</li>
                    <li>Unlimited local dictation on every plan.</li>
                    <li>Signed local components for speech and local command interpretation, downloaded and verified by KalCode itself.</li>
                    <li>Speak to your threads: “send that”, “tell Authentication to run the tests”, “what needs permission?”.</li>
                  </ul>
                </section>
                <section>
                  <h3>Providers and accounts</h3>
                  <ul>
                    <li>Several accounts per provider, with a switcher in each thread's header.</li>
                    <li>Accounts remembered for each workspace.</li>
                    <li>Sign-in and threads with Claude Code 2.1.282 and later 2.1 releases and Codex 0.155.1 through 0.158.</li>
                    <li>Gemini CLI is unavailable: on June 18, 2026, Google ended Gemini CLI access through Sign in with Google for personal accounts, and 0.1.6 can't set the Google Cloud project that Standard and Enterprise licenses need.</li>
                  </ul>
                </section>
                <section>
                  <h3>Verified downloads</h3>
                  <ul>
                    <li>A signed installer for Windows and a signed, notarized app for Apple silicon.</li>
                    <li>Version, platform and SHA-256 details on the download page.</li>
                    <li>Provider permissions and account isolation remain in effect.</li>
                  </ul>
                </section>
                <section>
                  <h3>Updates and earlier builds</h3>
                  <ul>
                    <li>On macOS, in-app Update and Restore previous version now finish: the updater no longer waits on a shutdown lock it holds itself.</li>
                    <li>Windows: in-app Update and Restore previous version don't work in 0.1.6. When 0.1.7 is available, download it from the <a class="text-link" href="/download">download page</a> and run the installer — your data is kept.</li>
                    <li>KalCode 0.1.5 was never released. To move an earlier build to 0.1.6, download the installer from the download page and run it over your current app.</li>
                  </ul>
                </section>
              </div>
              <p class="update__action"><a class="button button--primary" href="/download">Download KalCode</a></p>
            </div>
          </article>
        )}
        <article
          class:list={["update", { "update--featured": !shows016 }]}
          id="release-0-1-1"
          aria-labelledby="release-0-1-1-title"
        >
          <div class="update__signal" aria-hidden="true"><span></span></div>
          <header class="update__meta">
            <p class="update__edition">KalCode 0.1.1</p>
            <p><time datetime="2026-09-24">September 24, 2026</time></p>
            <p class="chip chip--built">Public preview · Windows</p>
          </header>
          <div class="update__story">
            <p class="update__kicker">The first Windows preview</p>
            <h2 id="release-0-1-1-title">Your coding agents, together in one workspace.</h2>
            <p class="update__lead">
              KalCode 0.1.1 brings real project terminals and Claude Code threads into a persistent
              desktop workspace, with a Dashboard that shows what is working and what needs you.
            </p>
            <div class="update__groups">
              <section>
                <h3>New</h3>
                <ul>
                  <li>Project workspaces with PowerShell, Command Prompt, and Git Bash terminals.</li>
                  <li>Claude Code threads with streaming output, pause, stop, and resume.</li>
                  <li>A live Dashboard for active, waiting, completed, and failed work.</li>
                </ul>
              </section>
              <section>
                <h3>Improved</h3>
                <ul>
                  <li>Workspace and terminal tabs return after a restart.</li>
                  <li>Provider actions stay under KalCode's deny rules in every permission mode.</li>
                </ul>
              </section>
              <section>
                <h3>Fixed</h3>
                <ul>
                  <li>Programs planted in project folders cannot run when a thread starts.</li>
                  <li>Drive roots and home folders cannot be opened as workspaces.</li>
                </ul>
              </section>
            </div>
            {
              // Only while /download serves the preview; any Stable (even Windows-only) replaces it there.
              servesPreview && (
                <p class="update__action"><a class="button button--primary" href="/download">Download the Windows preview</a></p>
              )
            }
          </div>
        </article>

        <article class="update" id="release-website-2026-09-24" aria-labelledby="release-website-2026-09-24-title">
          <div class="update__signal" aria-hidden="true"><span></span></div>
          <header class="update__meta">
            <p class="update__edition">Website</p>
            <p><time datetime="2026-09-24">September 24, 2026</time></p>
            <p class="chip chip--built">Live</p>
          </header>
          <div class="update__story">
            <p class="update__kicker">A clearer view of the product</p>
            <h2 id="release-website-2026-09-24-title">The new kalcoded.com shows the real workspace.</h2>
            <p class="update__lead">
              Product previews now show terminals, permissions, KalVoice, and the Dashboard in the
              same visual world as the desktop app. Every preview and development feature is labelled
              with its current state.
            </p>
            <div class="update__groups update__groups--compact">
              <section>
                <h3>New</h3>
                <ul>
                  <li>Focused Product, KalVoice, Pricing, Download, and Docs pages.</li>
                  <li>Release status and verified download details from the public manifest.</li>
                  <li>Official product news from <XLink account="official" withHandle />.</li>
                </ul>
              </section>
            </div>
          </div>
        </article>

        <article class="update" id="release-kalvoice" aria-labelledby="release-kalvoice-title">
          <div class="update__signal" aria-hidden="true"><span></span></div>
          <header class="update__meta">
            <p class="update__edition">KalVoice</p>
            <p><time datetime="2026-09-24">September 24, 2026</time></p>
            <p class="chip chip--dev">In development</p>
          </header>
          <div class="update__story">
            <p class="update__kicker">Speak to your workspace</p>
            <h2 id="release-kalvoice-title">KalVoice puts your intent where you are working.</h2>
            <p class="update__lead">

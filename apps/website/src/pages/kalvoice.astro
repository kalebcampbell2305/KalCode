---
import Backdrop from "../components/Backdrop.astro";
import { PLANS, formatKalVoiceAllowance } from "@kalcode/protocol/plans";
import Closing from "../components/Closing.astro";
import Globe from "../components/Globe.astro";
import Icon from "../components/Icon.astro";
import SectionHead from "../components/SectionHead.astro";
import StageSlot from "../components/StageSlot.astro";
import Base from "../layouts/Base.astro";
import { RELEASES, servedStableRelease } from "../lib/releases";
import { KALVOICE, getPage } from "../lib/site";

const page = getPage("/kalvoice");
// KalVoice is described as shipped only while /download serves a signed Stable release.
const stable = servedStableRelease(RELEASES);
const description = stable ? page.description.replace(/ In development\.$/, "") : page.description;

// KalVoice Requests on a log scale from the smallest allowance (6%) to the largest (100%).
const allowances = PLANS.map((plan) => plan.limits.kalvoiceRequestsPerMonth ?? 0).filter((value) => value > 0);
const logMin = Math.log10(Math.min(...allowances));
const logMax = Math.log10(Math.max(...allowances));
const meterWidth = (value: number | null) =>
  value === null ? 100 : Math.max(6, Math.round(((Math.log10(value) - logMin) / (logMax - logMin)) * 94 + 6));

const privacy = [
  {
    label: "on-device",
    title: "Audio never leaves your computer.",
    body: "Speech is captured into memory, transcribed by a model running locally, then discarded. Nothing is stored or uploaded.",
  },
  {
    label: "no transcripts in logs",
    title: "The log records that you spoke, not what.",
    body: "KalCode's event log notes that a dictation or request happened. Your words are not written to it.",
  },
  {
    label: "local interpretation",
    title: "Commands are understood on your computer.",
    body: "Structured commands run without any model at all. Other commands use KalVoice's on-device interpreter; when it is not ready, KalVoice says so instead of sending your request to a provider.",
  },
];
---
<Base title={page.title} description={description} path={page.path} world>
  <section class="voice-hero" aria-labelledby="kv-title">
    <Backdrop variant="nebula" />
    <div class="voice-hero__orb" aria-hidden="true">
      <Globe variant="kalvoice" hero alt="" sizes="(min-width: 60rem) 30rem, 78vw" />
    </div>
    <div class="container voice-hero__content">
      {
        stable ? (
          <p class="chip chip--built">Available in KalCode Stable {stable.version}</p>
        ) : (
          <p class="chip chip--dev">{KALVOICE.status}</p>
        )
      }
      <h1 id="kv-title" class="voice-hero__title">
        <span class="visually-hidden">KalVoice: </span>
        <span class="voice-hero__wordmark" aria-hidden="true"></span>
        <span class="hero__statement">Speak your prompts with KalVoice.</span>
      </h1>
      <p class="hero__line">
        Hold {KALVOICE.pushToTalkKey} to talk to KalVoice. Release, and your words land in the focused
        agent — or, if you said a command, KalCode does it.
      </p>
      <div class="button-row hero__actions">
        <a class="button button--secondary button--lg" href="#modes">
          How it works
          <Icon name="arrow-down" class="icon-down" />
        </a>
      </div>
    </div>
  </section>

  <section class="world-section" id="modes" aria-labelledby="modes-title">
    <Backdrop variant="deep" />
    <div class="container">
      <SectionHead
        id="modes-title"
        title={`Hold ${KALVOICE.pushToTalkKey}. Speak. Release.`}
        text="One key, one gesture. KalVoice decides from context what you meant."
      />
      <p class="ptt">
        <kbd class="ptt__key">{KALVOICE.pushToTalkKey}</kbd>
        <span class="ptt__note">{KALVOICE.keyNote}</span>
      </p>
      <div class="modes">
        <article class="mode" aria-labelledby="dictation-title">
          <p class="mode__keys">Into a focused input</p>
          <h3 id="dictation-title" class="h2 h2--sm">Your words are typed there.</h3>
          <ul>
            <li>{stable ? "A Claude Code or Codex thread, a terminal, a search box." : "A Claude Code, Codex or Gemini CLI thread, a terminal, a search box."}</li>
            <li>The target is fixed when you press the key, so switching windows cannot misdirect your words.</li>
            <li>Dictation is unlimited on every plan, and never counted.</li>
          </ul>
          <p class="mode__example">“also cover the 429 response in the test”</p>
        </article>
        <article class="mode" aria-labelledby="command-title">
          <p class="mode__keys">A command</p>
          <h3 id="command-title" class="h2 h2--sm">KalCode does it.</h3>
          <ul>
            <li>Structured commands run locally; more complex interpretation requires the on-device runtime.</li>
            <li>Workspace controls run locally; coding tasks keep provider-native permissions.</li>
            <li>Each command is one KalVoice Request.</li>
          </ul>
          <p class="mode__example">“Pause every active thread.”</p>
        </article>
      </div>
    </div>
  </section>

  <section class="world-section" id="demo" aria-labelledby="demo-title">
    <Backdrop variant="nebula" />
    <div class="container">
      <SectionHead
        id="demo-title"
        title="Hear it land in the pane."
        text="The KalVoice panel, the waveform and a prompt arriving in the focused agent."
      />
    </div>
    <div class="container container--wide">
      <StageSlot name="KalVoiceDemo" />
    </div>
  </section>

  <section class="world-section" id="requests" aria-labelledby="requests-title">
    <Backdrop variant="orbital" />
    <div class="container feature-split feature-split--top">
      <div class="feature-split__copy">
        <h2 id="requests-title" class="h2">Unlimited local voice. Cloud requests by plan.</h2>
        <p>
          Local/on-device commands, dictation and voice into terminals are unlimited on every plan.
          Only cloud-backed KalVoice requests consume your monthly allowance, once per request.
        </p>
        <a class="text-link" href="/pricing">Compare plans <Icon name="arrow-right" /></a>
      </div>
      <div>
        <ul class="allowances" role="list" aria-label="KalVoice Requests per month by plan">
          {
            PLANS.map((plan) => (
              <li class="allowance">
                <span class="allowance__plan">{plan.name}</span>
                <svg class="meter" viewBox="0 0 100 6" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                  <rect class="meter__track" width="100" height="6" rx="3" />
                  <rect class="meter__fill" width={meterWidth(plan.limits.kalvoiceRequestsPerMonth)} height="6" rx="3" />
                </svg>
                <span class="allowance__value">{formatKalVoiceAllowance(plan.limits)} a month</span>
              </li>
            ))
          }
          <li class="allowance">
            <span class="allowance__plan">Dictation</span>
            <svg class="meter" viewBox="0 0 100 6" preserveAspectRatio="none" aria-hidden="true" focusable="false">
              <rect class="meter__fill" width="100" height="6" rx="3" />
            </svg>
            <span class="allowance__value">Unlimited on every plan</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="world-section" id="privacy" aria-labelledby="privacy-title">
    <Backdrop variant="gravity" />
    <div class="container">
      <SectionHead
        id="privacy-title"
        title="Private by default."
        text="KalVoice works inside your permission model: it cannot raise its own authority, approve its own requests, or turn on Bypass."
      />
      <ul class="facts" role="list">
        {
          privacy.map((fact) => (
            <li class="fact">
              <span class="fact__label">{fact.label}</span>
              <p class="fact__title">{fact.title}</p>
              <p>{fact.body}</p>
            </li>
          ))
        }
      </ul>
      <p class="section-foot">
        <a class="text-link" href="/docs/kalvoice">Read the KalVoice reference <Icon name="arrow-right" /></a>
      </p>
    </div>
  </section>

  <Closing />
</Base>

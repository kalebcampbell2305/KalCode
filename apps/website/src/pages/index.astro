---
import { PLANS, formatPrice } from "@kalcode/protocol/plans";
import Closing from "../components/Closing.astro";
import HeroOrbSlot from "../components/HeroOrbSlot.astro";
import Icon from "../components/Icon.astro";
import PlanStrip from "../components/PlanStrip.astro";
import ProviderGlyph from "../components/ProviderGlyph.astro";
import SectionHead from "../components/SectionHead.astro";
import StageSlot from "../components/StageSlot.astro";
import Base from "../layouts/Base.astro";
import { downloadCta } from "../lib/releases";
import { HERO_POSTER_SIZES, HERO_POSTER_SRCSET } from "../lib/hero";
import { structuredData } from "../lib/seo";
import { KALVOICE, PROVIDERS, getPage } from "../lib/site";

const page = getPage("/");
// On home the early-access form is in the closing section, so the hero links to it in place.
const cta = downloadCta(undefined, "#early-access");
const prices = PLANS.map((plan) => formatPrice(plan.price));
const priceLine = `${prices.slice(0, -1).join(", ")} or ${prices.at(-1)} a month.`;

const facts = [
  {
    label: "local-first",
    title: "Your project files stay local.",
    body: "Projects, threads and settings live on your device. Secrets go to your operating system's keychain.",
  },
  {
    label: "your own access",
    title: "Providers run on your own sign-in.",
    body: "Claude Code, Codex and Gemini CLI use the sign-in or API key you already have, billed by the provider as it is today.",
  },
  {
    label: "no markup",
    title: "KalCode never pays for, resells or meters your AI usage.",
    body: "There is no KalCode-paid fallback and nothing is proxied. Plans pay for KalCode, never for models.",
  },
];
---
<Base title={page.title} description={page.description} path={page.path} nightHeader jsonLd={structuredData()}>
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/avif"
    imagesrcset={HERO_POSTER_SRCSET}
    imagesizes={HERO_POSTER_SIZES}
    fetchpriority="high"
  />
  <section class="hero" data-theme="dark" aria-labelledby="hero-title">
    <div class="hero__orb">
      <HeroOrbSlot size="full" />
    </div>
    <div class="container hero__inner">
      <h1 id="hero-title" class="hero__title">
        <span class="hero__name">KalCode</span>
        <span class="hero__line">One intelligence that operates your entire AI workspace.</span>
      </h1>
      <p class="hero__support">
        Connect the coding providers you already use — Claude Code, Codex and Gemini CLI — and run
        them from one environment, on your own accounts.
      </p>
      <div class="button-row hero__actions">
        <a class="button button--primary button--lg" href={cta.href}>
          {cta.kind === "download" && <Icon name="download" />}
          {cta.label}
        </a>
        <a class="button button--secondary button--lg" href="#story">
          See it in action
          <Icon name="arrow-down" />
        </a>
      </div>
      <p class="hero__note">{cta.kind === "download" ? cta.note : `${cta.note} · in private development`}</p>
    </div>
  </section>

  <section class="provider-band" aria-labelledby="providers-label">
    <div class="container provider-bar">
      <h2 class="provider-bar__label" id="providers-label">Runs the coding agents you already use</h2>
      <ul class="provider-bar__list" role="list" aria-labelledby="providers-label">
        {
          PROVIDERS.map((provider) => (
            <li class="provider-bar__item">
              <span class="provider-bar__name">
                <ProviderGlyph />
                {provider.name}
              </span>
              <span class="provider-bar__status">{provider.status}</span>
            </li>
          ))
        }
        <li class="provider-bar__item provider-bar__item--more">
          <span class="provider-bar__name">More providers</span>
          <span class="provider-bar__status">Through the same runtime</span>
        </li>
      </ul>
    </div>
  </section>

  <section class="section" id="story" aria-labelledby="story-title">
    <div class="container">
      <SectionHead
        id="story-title"
        title="One workspace. Every coding agent."
        text="Watch the window come together: a real terminal, Claude Code, Codex beside it, the Dashboard, and an approval that waits for you."
      />
    </div>
    <div class="container container--wide">
      <StageSlot name="ScrollStory" />
    </div>
  </section>

  <section class="section" id="terminals" aria-labelledby="terminals-title">
    <div class="container">
      <SectionHead
        id="terminals-title"
        title="Stop juggling agent terminals."
        text="Six loose windows and no idea which one is waiting on you — or one workspace where every agent has a place and a status."
      />
    </div>
    <div class="container container--wide">
      <StageSlot name="BeforeAfter" />
    </div>
  </section>

  <section class="section section--sunken" id="try" aria-labelledby="try-title">
    <div class="container">
      <SectionHead
        id="try-title"
        title="Drive it yourself."
        text="Pick a provider, open a thread, split a pane, bring up the Dashboard. It all runs in this page, on sample data."
      />
    </div>
    <div class="container container--wide">
      <StageSlot name="TryKalCode" />
    </div>
  </section>

  <section class="section" id="control" aria-labelledby="control-title">
    <div class="container feature-split">
      <div class="feature-split__copy">
        <p class="chip chip--dev">Development build · sample data</p>
        <h2 id="control-title" class="h2">See every thread. Approve every action.</h2>
        <p>
          Status comes from runtime events, not from what a model says. Anything outside your rules
          waits for you. Every permission mode is on every plan.
        </p>
        <a class="text-link" href="/docs/permissions">How permissions work <Icon name="arrow-right" /></a>
      </div>
      <div class="feature-split__visual">
        <StageSlot name="PermissionModes" shape="compact" />
      </div>
    </div>
  </section>

  <section class="section" id="kalvoice" aria-labelledby="kalvoice-title">
    <div class="container feature-split feature-split--reverse">
      <div class="feature-split__copy">
        <p class="chip chip--dev">KalVoice · in development</p>
        <h2 id="kalvoice-title" class="h2">Speak your prompts with KalVoice.</h2>
        <p>
          Hold {KALVOICE.pushToTalkKey} to talk to KalVoice. Your words land in the focused agent —
          transcribed on your device, unlimited on every plan. Say a command, and KalCode does it.
        </p>
        <a class="text-link" href="/kalvoice">Meet KalVoice <Icon name="arrow-right" /></a>
      </div>
      <div class="feature-split__visual">
        <StageSlot name="KalVoiceDemo" shape="compact" />
      </div>
    </div>
  </section>

  <section class="section section--sunken" id="in-action" aria-labelledby="in-action-title">
    <div class="container">
      <SectionHead
        id="in-action-title"
        title="See KalCode in action."
        text="Multi-agent work, KalVoice, permissions, the Dashboard and Code Mode — one scene at a time."
      />
    </div>
    <div class="container container--wide">
      <StageSlot name="DemoCenter" />
    </div>
  </section>

  <section class="section" id="local" aria-labelledby="local-title">
    <div class="container">
      <div class="feature-split">
        <div class="feature-split__copy">
          <h2 id="local-title" class="h2">Your providers. Your projects. One workspace.</h2>
          <p>KalCode runs the tools you already pay for, on the machine you already trust.</p>
          <a class="text-link" href="/docs/local-first">What stays on your device <Icon name="arrow-right" /></a>
        </div>
        <div class="feature-split__visual">
          <StageSlot name="ProviderSwitch" shape="compact" />
        </div>
      </div>
      <ul class="facts" role="list">
        {
          facts.map((fact) => (
            <li class="fact">
              <span class="fact__label">{fact.label}</span>
              <p class="fact__title">{fact.title}</p>
              <p>{fact.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" id="plans" aria-labelledby="plans-title">
    <div class="container">
      <SectionHead
        id="plans-title"
        title={priceLine}
        text="Plans differ in KalVoice Requests and workspace features, never in safety. Your AI usage stays on your own account."
      />
      <PlanStrip />
      <p class="section-foot">Plans open at launch. Nothing is for sale today.</p>
    </div>
  </section>

  <Closing formSource="/" />
</Base>

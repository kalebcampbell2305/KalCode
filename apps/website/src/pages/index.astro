---
import { PLANS, formatInterval, formatKalVoiceAllowance, formatPrice } from "@kalcode/protocol/plans";
import Backdrop from "../components/Backdrop.astro";
import Closing from "../components/Closing.astro";
import DownloadButton from "../components/DownloadButton.astro";
import Globe from "../components/Globe.astro";
import HeroOrbSlot from "../components/HeroOrbSlot.astro";
import Icon from "../components/Icon.astro";
import PageStyles from "../components/PageStyles.astro";
import ProviderGlyph from "../components/ProviderGlyph.astro";
import StageSlot from "../components/StageSlot.astro";
import Base from "../layouts/Base.astro";
import { HERO_POSTER_PRELOADS } from "../lib/hero";
import { RELEASES, downloadCta, servedStableRelease } from "../lib/releases";
import { structuredData } from "../lib/seo";
import { GEMINI_AVAILABILITY, KALVOICE, PROVIDERS, getPage, planSummary } from "../lib/site";
import { firstStage, hasStage } from "../lib/stage";

const page = getPage("/");
const cta = downloadCta();
// KalVoice is described as shipped only while /download serves a signed Stable release.
const kalvoiceShipped = servedStableRelease(RELEASES) !== null;

// Compose the story from the demos that exist (lib/stage.ts): a section never renders empty.
const workspaceStage = firstStage("TryKalCode", "AppWindow");
const voiceStage = firstStage("KalVoiceStage", "KalVoiceDemo");
const commandStage = firstStage("CommandCenterStage", "DemoCenter");

/**
 * Plan cards: three honest highlights each, straight from the catalog. Agents, team workflows and
 * missions are Gated on Stable 0.1.5 (crates/native-core/src/flags.rs), so no card offers them.
 */
const FEATURED = "pro";
const planPoints = (plan: (typeof PLANS)[number]) => [
  `${formatKalVoiceAllowance(plan.limits)} KalVoice Requests a month`,
  plan.limits.concurrentThreads === null
    ? "Unlimited threads at once"
    : `${plan.limits.concurrentThreads} threads running at once`,
  "Every provider; Plan, Approve and Auto modes",
];

/** Permission policy as it reads in Approve mode (the default). */
const policies = [
  { action: "Read files", policy: "Allow", tone: "allow" },
  { action: "Edit files", policy: "Ask", tone: "ask" },
  { action: "Run commands", policy: "Ask", tone: "ask" },
  { action: "Network access", policy: "Ask", tone: "ask" },
  { action: "Deploy to production", policy: "Approval required", tone: "block" },
] as const;
---
<Base title={page.title} description={page.description} path={page.path} world lateStyles jsonLd={structuredData()}>
  <!-- The wordmark is a CSS mask (fetched in CORS mode), and often the LCP element: fetch it early. -->
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/assets/brand/kalcode-wordmark.png"
    crossorigin="anonymous"
    fetchpriority="high"
  />
  {
    HERO_POSTER_PRELOADS.map((preload) => (
      <link
        slot="head"
        rel="preload"
        as="image"
        type="image/avif"
        fetchpriority="high"
        media={preload.media}
        imagesrcset={preload.srcset}
        imagesizes={preload.sizes}
      />
    ))
  }

  <!-- The orb: the page's core. The lockup sits over its light, inside the text-safe band. -->
  <section class="hero" data-theme="dark" aria-labelledby="hero-title">
    <HeroOrbSlot />
    <p class="hero__aside hero__aside--left" aria-hidden="true">
      <span>Code</span><span>Reason</span><span>Automate</span><span>Create</span><span>Together.</span>
    </p>
    <p class="hero__aside hero__aside--right" aria-hidden="true">
      <span>Built for a</span><span>brighter</span><span>tomorrow.</span>
    </p>
    <div class="container hero__content">
      <div class="hero__lockup">
        <span class="hero__wordmark-glow" aria-hidden="true"><span class="hero__wordmark"></span></span>
        <p class="hero__tagline">Code the Future</p>
      </div>
      <h1 id="hero-title" class="hero__statement">
        <span class="visually-hidden">KalCode: </span>One intelligence that operates your entire AI workspace.
      </h1>
      <p class="hero__line">
        Connect Claude Code, Codex and the coding tools you already use — then operate them from one
        workspace.
      </p>
      <div class="button-row hero__actions">
        <DownloadButton />
        <a class="button button--secondary button--lg" href="#workspace">
          See it in action
          <Icon name="arrow-down" class="icon-down" />
        </a>
      </div>
      {
        cta.kind === "download" ? (
          <p class="hero__status">
            <span class="status-dot status-dot--built" aria-hidden="true" />
            <span>{cta.note}</span>
            <a href="/download">All platforms and checksums</a>
          </p>
        ) : (
          <p class="hero__status">
            <span class="status-dot" aria-hidden="true" />
            <span>No public build yet.</span>
            <a href="#early-access">Get notified when it ships</a>
          </p>
        )
      }
    </div>
  </section>

  <!-- Everything below the first viewport: its styles load here, not in <head>. -->
  <PageStyles />

  <!-- Providers: the names you already use, with honest adapter status. -->
  <section class="providers" aria-labelledby="providers-title">
    <div class="container">
      <h2 id="providers-title" class="providers__title">Works with the coding agents you already use</h2>
      <ul class="providers__list" role="list" aria-labelledby="providers-title">
        {
          PROVIDERS.map((provider) => (
            <li class="providers__item">
              <span class="providers__name">
                <ProviderGlyph provider={provider.id} />
                {provider.name}
              </span>
              <span class="providers__status">
                <span
                  class:list={["status-dot", provider.state === "built" ? "status-dot--built" : "status-dot--idle"]}
                  aria-hidden="true"
                />
                {provider.status}
              </span>
            </li>
          ))
        }
        <li class="providers__item providers__item--more">
          <span class="providers__name">And more providers</span>
          <span class="providers__status">Through the same runtime</span>
        </li>
      </ul>
      <p class="providers__note">{GEMINI_AVAILABILITY.notice}</p>
    </div>
  </section>

  <!-- The workspace: the product, large, in a lit frame. -->
  {
    workspaceStage && (
      <section class="world-section" id="workspace" aria-labelledby="workspace-title">
        <Backdrop variant="deep" />
        <Backdrop variant="orbital" intensity="low" />
        <Backdrop variant="planet" side="right" size="lg" intensity="high" />
        <div class="container container--wide">
          <div class="frame frame--feature">
            <header class="statement statement--wide" data-reveal>
              <p class="eyebrow">The workspace</p>
              <h2 id="workspace-title" class="h2">A real workspace. Not a chatbot.</h2>
              <div class="statement__side">
                <p class="body-lg">
                  Open a project, connect your providers, and get to work. Real terminals, a browser pane
                  and your agents' threads, in one workspace.
                </p>
                <a class="button button--secondary" href="/product">
                  Explore the product <Icon name="arrow-right" />
                </a>
              </div>
            </header>
            <StageSlot name={workspaceStage} />
          </div>
        </div>
      </section>
    )
  }

  <!-- KalVoice: a wide feature panel, the orb and the one key. -->
  <section class="world-section" id="kalvoice" aria-labelledby="kalvoice-title">
    <Backdrop variant="nebula" />
    <Backdrop variant="void" intensity="high" />
    <div class="container container--wide">
      <div class="frame frame--split">
        <div class="frame__copy" data-reveal>
          <p class="eyebrow">{kalvoiceShipped ? "KalVoice" : "KalVoice · in development"}</p>
          <h2 id="kalvoice-title" class="h2">Speak it. See it done.</h2>
          <p class="body-lg">
            Hold {KALVOICE.pushToTalkKey} to talk to KalVoice. Your words land in the focused agent; say a
            command and KalCode does it. On your device, unlimited.
          </p>
          <a class="button button--secondary" href="/kalvoice">
            Meet KalVoice <Icon name="arrow-right" />
          </a>
        </div>
        <div class="frame__visual">
          {
            voiceStage ? (
              <StageSlot name={voiceStage} width="compact" />
            ) : (
              <div class="voice-mark" aria-hidden="true">
                <Globe variant="kalvoice" alt="" sizes="(min-width: 64rem) 20rem, 60vw" />
                <kbd>{KALVOICE.pushToTalkKey}</kbd>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Dashboard: the full-width dashboard moment. -->
  {
    commandStage && (
      <section class="world-section world-section--tall" id="command" aria-labelledby="command-title">
        <Backdrop variant="deep" accent="grid" />
        <Backdrop variant="planet" side="left" size="xl" intensity="high" />
        <div class="container">
          <header class="statement statement--center" data-reveal>
            <p class="eyebrow">Dashboard</p>
            <h2 id="command-title" class="h2">Every thread. One dashboard.</h2>
            <p class="body-lg">
              What is running, what needs you, what is done — from runtime events, not from what a model
              says about itself.
            </p>
          </header>
        </div>
        <div class="container container--wide">
          <StageSlot name={commandStage} width="wide" />
        </div>
      </section>
    )
  }

  <!-- Missions: parallel agents toward one objective (labelled planned by the demo). -->
  {
    hasStage("MissionGraph") && (
      <section class="world-section" id="agents" aria-labelledby="agents-title">
        <Backdrop variant="deep" />
        <Backdrop variant="gravity" />
        <div class="container container--wide">
          <div class="frame frame--feature">
            <header class="statement statement--wide" data-reveal>
              <p class="eyebrow">Parallel agents · planned</p>
              <h2 id="agents-title" class="h2">Complex goals. Coordinated agents.</h2>
              <p class="body-lg">
                A planner breaks the objective down, agents build and review in parallel, and KalCode
                verifies the result before anything is called done.
              </p>
            </header>
            <StageSlot name="MissionGraph" width="wide" />
          </div>
        </div>
      </section>
    )
  }

  <!-- Providers, control, local-first: three framed facts, each with its own proof. -->
  <section class="world-section" id="control" aria-labelledby="control-title">
    <Backdrop variant="nebula" intensity="low" />
    <Backdrop variant="vault" intensity="high" />
    <div class="container container--wide">
      <h2 id="control-title" class="visually-hidden">Your accounts, your rules, your machine</h2>
      <div class="trio">
        <article class="frame frame--tile" aria-labelledby="keys-title">
          <p class="eyebrow">Your providers</p>
          <h3 id="keys-title" class="headline">Use your own accounts. Sign in from KalCode.</h3>
          <p>Claude Code and Codex run on your own accounts: sign in to each from KalCode, with a separate managed profile for every account. {GEMINI_AVAILABILITY.short}</p>
          {
            hasStage("ProviderSwitch") ? (
              <StageSlot name="ProviderSwitch" width="compact" />
            ) : (
              <ul class="tile-list" role="list">
                {PROVIDERS.map((provider) => (
                  <li>
                    <ProviderGlyph provider={provider.id} />
                    <span>{provider.name}</span>
                    <span class="tile-list__meta">{provider.access}</span>
                  </li>
                ))}
              </ul>
            )
          }
          <a class="text-link" href="/docs/providers">Provider setup <Icon name="arrow-right" /></a>
        </article>

        <article class="frame frame--tile" aria-labelledby="rules-title">
          <p class="eyebrow">Built for control</p>
          <h3 id="rules-title" class="headline">You set the rules. Agents follow them.</h3>
          <p>Plan, Approve and Auto on every plan. Anything outside your rules waits for you.</p>
          {hasStage("PermissionModes") ? (
            <StageSlot name="PermissionModes" width="compact" />
          ) : (
          <table class="policy">
            <caption class="visually-hidden">What agents may do in Approve mode</caption>
            <tbody>
              {
                policies.map((row) => (
                  <tr>
                    <th scope="row">{row.action}</th>
                    <td>
                      <span class:list={["policy__value", `policy__value--${row.tone}`]}>{row.policy}</span>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
          )}
          <a class="text-link" href="/docs/permissions">How permissions work <Icon name="arrow-right" /></a>
        </article>

        <article class="frame frame--tile" aria-labelledby="local-title">
          <p class="eyebrow">Local-first</p>
          <h3 id="local-title" class="headline">Your code. Your machine.</h3>
          <p>
            Projects, threads and settings stay on your device. KalCode never pays for, resells or meters
            your AI usage.
          </p>
          <ul class="tile-checks" role="list">
            <li><Icon name="check" /> Local database, on your device</li>
            <li><Icon name="check" /> KalCode session in your OS credential store</li>
            <li><Icon name="check" /> Nothing proxied through KalCode</li>
            <li><Icon name="check" /> No telemetry in current builds</li>
          </ul>
          <a class="text-link" href="/docs/local-first">What stays on your device <Icon name="arrow-right" /></a>
        </article>
      </div>
    </div>
  </section>

  <!-- Pricing: three plans over a lit horizon. -->
  <section class="world-section pricing-band" id="plans" aria-labelledby="plans-title">
    <Backdrop variant="deep" />
    <Backdrop variant="horizon" rocks={false} />
    
    <div class="container container--wide">
      <div class="pricing-band__grid">
        <header class="pricing-band__copy" data-reveal>
          <p class="eyebrow">Simple pricing</p>
          <h2 id="plans-title" class="h2">Power for every builder.</h2>
          <p class="body-lg">
            Every plan includes every provider, the Plan, Approve and Auto modes and unlimited on-device dictation.
            Your AI usage stays on your own account.
          </p>
          <a class="button button--secondary" href="/pricing">Compare plans <Icon name="arrow-right" /></a>
          <p class="pricing-band__note">Plans open at launch. Nothing is for sale today.</p>
        </header>
        <ul class="plan-cards" role="list">
          {
            PLANS.map((plan) => (
              <li class:list={["plan-card", { "plan-card--featured": plan.id === FEATURED }]}>
                <p class="plan-card__name">
                  {plan.name}
                  {plan.id === FEATURED && <span class="plan-card__tag">Recommended</span>}
                </p>
                <p class="plan-card__price">
                  {formatPrice(plan.price)}
                  <small>{formatInterval(plan.price)}</small>
                </p>
                <p class="plan-card__summary">{planSummary(plan)}</p>
                <ul class="plan-card__points" role="list">
                  {planPoints(plan).map((point) => (
                    <li>
                      <Icon name="check" /> {point}
                    </li>
                  ))}
                </ul>
                <a
                  class:list={["button", plan.id === FEATURED ? "button--primary" : "button--secondary"]}
                  href={cta.kind === "download" ? "/download" : "#early-access"}
                >
                  {cta.kind === "download" ? "Download KalCode" : "Join early access"}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <Closing formSource="/" />

  <script>
    import "../scripts/reveal";
  </script>
</Base>

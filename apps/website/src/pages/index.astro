---
import { PLANS, formatInterval, formatPrice } from "@kalcode/protocol/plans";
import DashboardPreview from "../components/DashboardPreview.astro";
import EarlyAccessForm from "../components/EarlyAccessForm.astro";
import Globe from "../components/Globe.astro";
import Lettering from "../components/Lettering.astro";
import Base from "../layouts/Base.astro";
import { getPage } from "../lib/site";

const page = getPage("/");

const steps = [
  {
    title: "Choose the intelligence",
    body: "Connect Claude Code, Codex or Gemini CLI with the accounts you already have, then pick the provider that suits each piece of work.",
  },
  {
    title: "Give it the objective",
    body: "Start a thread in a real workspace and terminal, or hand the objective to JARVIS to plan it and delegate the parts.",
  },
  {
    title: "Watch the work happen",
    body: "The Dashboard shows every thread as it runs: which provider, which workspace, and whether it is working, waiting on you, or done.",
  },
  {
    title: "Stay in control",
    body: "Permission modes decide what each agent may read, write, run or push. Anything outside your rules waits for your decision.",
  },
];

const principles = [
  {
    title: "Runtime truth",
    body: "Status comes from structured events emitted by the runtime, not from a model describing its own progress.",
  },
  {
    title: "Your authority",
    body: "Permission modes govern every provider, every agent and JARVIS itself. JARVIS is not above your authority, and consequential decisions are written to an audit log.",
  },
  {
    title: "Evidence over claims",
    body: "Work counts as done when there is evidence: tests that ran, diffs you can read, checks that passed.",
  },
  {
    title: "Local-first",
    body: "Projects, threads, events and settings stay on your device by default. Secrets are kept in your operating system's keychain.",
  },
  {
    title: "Provider freedom",
    body: "Bring the subscriptions and API keys you already have. You never pay KalCode to connect a provider.",
  },
];
---
<Base title={page.title} description={page.description} path={page.path}>
  <section class="band hero" data-theme="dark" aria-labelledby="hero-title">
    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="dev-note">KalCode is in private development.</p>
        <h1 id="hero-title" class="display hero__title">
          One intelligence that operates your entire AI workspace.
        </h1>
        <p class="lead hero__lead">
          Connect Claude, Codex, Gemini and the coding tools you already use. KalCode is being built
          to run them from one workspace, keep you in control of permissions, and let JARVIS
          coordinate the work when you want it to.
        </p>
        <div class="button-row hero__actions">
          <a class="button button--primary" href="#early-access">Join early access</a>
          <a class="button button--secondary" href="#how-it-works">See how it works</a>
        </div>
      </div>
      <div class="hero__visual">
        <Globe
          variant="kalcode"
          hero
          alt="KalCode constellation globe with a K formed by connected points of light"
          sizes="(min-width: 60rem) min(44rem, 50vw), min(calc(100vw - 2rem), 26rem)"
        />
      </div>
    </div>
  </section>

  <section class="section" id="how-it-works" aria-labelledby="how-title">
    <div class="container">
      <div class="section-head">
        <h2 id="how-title" class="h2">Connect the coding agents you already use. Run them from one command center.</h2>
      </div>
      <ol class="steps" role="list">
        {
          steps.map((step, index) => (
            <li class="step">
              <span class="step__number" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <h3 class="h3">{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="band section preview-band" data-theme="dark" aria-labelledby="dashboard-title">
    <div class="container">
      <div class="section-head">
        <h2 id="dashboard-title" class="h2">Everything that is running, on one screen.</h2>
        <p>
          The Dashboard is designed around runtime truth: which provider is working on what, in
          which workspace, and what needs your approval — built from structured events rather than
          from what a model says about itself.
        </p>
      </div>
      <DashboardPreview />

      <div class="jarvis" id="jarvis">
        <div class="jarvis__visual">
          <Globe variant="jarvis" alt="" sizes="(min-width: 56rem) 28rem, min(calc(100vw - 2rem), 22rem)" />
        </div>
        <div class="jarvis__copy">
          <p class="lockup" role="img" aria-label="JARVIS — Global thinking. Personal impact.">
            <Lettering name="jarvis-wordmark" />
            <Lettering name="jarvis-tagline" />
          </p>
          <h2 class="h2">The intelligence inside KalCode.</h2>
          <p>
            Talk to JARVIS and let it coordinate Claude, Codex, Gemini, your projects, and your
            tools. It is being built to plan an objective, delegate threads to the providers you
            choose, and report back with the evidence.
          </p>
          <p>
            JARVIS works inside the same permission model as every other agent. It cannot grant
            itself more authority, and it can never switch on Bypass.
          </p>
          <a class="text-link" href="/docs/jarvis">How JARVIS is designed</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="principles-title">
    <div class="container split">
      <div class="split__aside section-head">
        <h2 id="principles-title" class="h2">What KalCode holds to.</h2>
        <p>These rules shape every surface, from the Dashboard to JARVIS.</p>
      </div>
      <dl class="definition-list">
        {
          principles.map((item) => (
            <div>
              <dt class="h3">{item.title}</dt>
              <dd>{item.body}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="pricing-title">
    <div class="container">
      <div class="section-head">
        <h2 id="pricing-title" class="h2">Three plans. Provider connections free on all of them.</h2>
        <p>
          Plans become available when KalCode launches. Connecting Claude Code, Codex or Gemini CLI
          is never behind a paywall.
        </p>
      </div>
      <div class="plans plans-compact">
        {
          PLANS.map((plan) => (
            <div class="plan">
              <h3 class="plan__name">{plan.name}</h3>
              <p class="plan__price">
                <span class="plan__amount">{formatPrice(plan.price)}</span>
                <span class="plan__interval">{formatInterval(plan.price)}</span>
              </p>
              <p class="plan__summary">{plan.summary}</p>
            </div>
          ))
        }
      </div>
      <p class="plans-more">
        <a class="text-link" href="/pricing">Compare plans</a>
      </p>
    </div>
  </section>

  <section class="section" id="early-access" aria-labelledby="early-access-title">
    <div class="container signup">
      <div class="section-head">
        <h2 id="early-access-title" class="h2">Join early access.</h2>
        <p>
          KalCode is in private development. Leave your email and we'll write when there is a build
          to try. No account, no payment details.
        </p>
      </div>
      <EarlyAccessForm source="/" />
    </div>
  </section>
</Base>

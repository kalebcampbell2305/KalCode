---
import Closing from "../components/Closing.astro";
import Icon from "../components/Icon.astro";
import PageHead from "../components/PageHead.astro";
import StageSlot from "../components/StageSlot.astro";
import Base from "../layouts/Base.astro";
import { KALVOICE, PROVIDERS, getPage } from "../lib/site";

const page = getPage("/product");

const runs: Record<(typeof PROVIDERS)[number]["id"], string> = {
  claude: "Headless stream mode: threads you can resume and interrupt",
  codex: "Detected with its sign-in status; the adapter is planned",
  gemini: "Detected; the adapter is planned",
};

type State = "built" | "dev" | "planned";
const stateLabel: Record<State, string> = { built: "Built", dev: "In development", planned: "Planned" };

const statuses = [
  { label: "Working", tone: "live" },
  { label: "Needs approval", tone: "dev" },
  { label: "Needs your reply", tone: "dev" },
  { label: "Blocked", tone: "danger" },
  { label: "Paused", tone: "idle" },
  { label: "Idle", tone: "idle" },
  { label: "Failed", tone: "danger" },
  { label: "Done", tone: "built" },
] as const;

const modes = [
  { name: "Plan", text: "Read and plan. Nothing is modified; writes, commands and network changes are denied or asked." },
  { name: "Approve", text: "The default. Safe work proceeds; anything that needs your authority pauses for a decision." },
  { name: "Auto", text: "Actions covered by your rules run automatically. Everything else still asks." },
  { name: "Bypass", text: "Broad local authority, only when you choose it, with a persistent indicator. Pushes, deploys and spending keep their own rules." },
  { name: "Custom", text: "Named rule sets you define, such as a read-only reviewer or a local builder." },
];

const roadmap: { capability: string; state: State; note: string }[] = [
  { capability: "App shell, search and palette, light and dark themes", state: "built", note: "In the development build" },
  { capability: "Workspaces and real terminals (tabs)", state: "built", note: "PowerShell, Command Prompt, Git Bash; restore after restart" },
  { capability: "Claude Code adapter", state: "built", note: "Detection, sign-in status, stream mode, resume, interrupt" },
  { capability: "Codex and Gemini CLI", state: "dev", note: "Detected today; adapters planned" },
  { capability: "Dashboard", state: "built", note: "Design built; live thread data in development" },
  { capability: "Approvals and permission modes", state: "dev", note: "Engine and approval card in development" },
  { capability: "KalVoice dictation and commands", state: "dev", note: "On-device recognition and command grammar in development" },
  { capability: "Split panes, file tree, Git and diff views, browser preview", state: "planned", note: "Shown in previews with a Planned label" },
  { capability: "Agents, Missions, Automations", state: "planned", note: "Listed in plans as available at launch" },
];
---
<Base title={page.title} description={page.description} path={page.path}>
  <PageHead
    title="The workspace, piece by piece."
    lead="What each part of KalCode does, and how far along it is. Previews use sample data; the table at the end says what is built today."
    status="In private development"
  >
    <div class="button-row">
      <a class="button button--secondary" href="#status">What is built today <Icon name="arrow-down" /></a>
    </div>
  </PageHead>

  <section class="section section--tight" aria-label="The KalCode window (product preview, sample data)">
    <div class="container container--wide">
      <StageSlot name="AppWindow" />
    </div>
  </section>

  <section class="section" aria-label="What KalCode does">
    <div class="container chapters">
      <article class="chapter" id="workspace" aria-labelledby="workspace-title">
        <div class="chapter__head">
          <p class="chip chip--built">Built · development build</p>
          <h2 id="workspace-title" class="h2 h2--sm">Real terminals in a real workspace.</h2>
        </div>
        <div class="chapter__body">
          <p>
            Open a project folder and KalCode starts real terminals inside it — PowerShell, Command
            Prompt, Git Bash — with full colour, exit codes, and tabs that come back after a restart.
            Type <code>claude</code> or <code>codex</code> in a tab and the CLI runs exactly as it
            does anywhere else.
          </p>
          <p>Terminals are tabs today. Split panes are planned.</p>
        </div>
      </article>

      <article class="chapter" id="providers" aria-labelledby="providers-title">
        <div class="chapter__head">
          <p class="chip chip--dev">Claude Code built · others planned</p>
          <h2 id="providers-title" class="h2 h2--sm">Your providers, on your own accounts.</h2>
          <p>Connecting a provider is free on every plan.</p>
        </div>
        <div class="chapter__body">
          <div class="table-wrap" role="region" aria-label="Provider connections" tabindex="0">
            <table class="table">
              <caption class="visually-hidden">Providers, the account each uses, and how KalCode runs it today</caption>
              <thead>
                <tr>
                  <th scope="col">Provider</th>
                  <th scope="col">Uses your own</th>
                  <th scope="col">How KalCode runs it</th>
                  <th scope="col">Status</th>
                </tr>
              </thead>
              <tbody>
                {
                  PROVIDERS.map((provider) => (
                    <tr>
                      <th scope="row">{provider.name}</th>
                      <td>{provider.access}</td>
                      <td>{runs[provider.id]}</td>
                      <td>
                        <span class:list={["chip", provider.state === "built" ? "chip--built" : "chip--dev"]}>{provider.status}</span>
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <p>
            KalCode uses documented integration methods only: your signed-in local CLI or an API key
            you provide. It never copies hidden credentials or scrapes browser sessions. Usage is
            billed by the provider, as it is today — KalCode never charges for, resells or meters it.
          </p>
          <a class="text-link" href="/docs/providers">How provider connections work <Icon name="arrow-right" /></a>
        </div>
      </article>

      <article class="chapter" id="threads" aria-labelledby="threads-title">
        <div class="chapter__head">
          <p class="chip chip--dev">Design built · live data in development</p>
          <h2 id="threads-title" class="h2 h2--sm">Every thread, one Dashboard.</h2>
        </div>
        <div class="chapter__body">
          <p>
            Status comes from structured runtime events — a thread started, a tool ran, an approval was
            requested — never from a model's account of its own progress. Every status is a glyph and
            a word, never colour alone:
          </p>
          <ul class="status-set" role="list">
            {statuses.map((status) => <li class:list={["chip", `chip--${status.tone}`]}>{status.label}</li>)}
          </ul>
        </div>
      </article>

      <article class="chapter" id="permissions" aria-labelledby="permissions-title">
        <div class="chapter__head">
          <p class="chip chip--dev">In development</p>
          <h2 id="permissions-title" class="h2 h2--sm">You set the rules. Agents follow them.</h2>
          <p>Every mode is on every plan.</p>
        </div>
        <div class="chapter__body">
          <div class="table-wrap" role="region" aria-label="Permission modes" tabindex="0">
            <table class="table">
              <caption class="visually-hidden">Permission modes and what each allows</caption>
              <thead>
                <tr>
                  <th scope="col">Mode</th>
                  <th scope="col">What it allows</th>
                </tr>
              </thead>
              <tbody>
                {
                  modes.map((mode) => (
                    <tr>
                      <th scope="row">{mode.name}</th>
                      <td>{mode.text}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <p>
            When a decision is needed, KalCode asks with three choices, in this order: Deny, Allow for
            thread, and Approve once — the safe default. KalVoice asks the same way and can never turn
            on Bypass.
          </p>
          <a class="text-link" href="/docs/permissions">Read the permission model <Icon name="arrow-right" /></a>
        </div>
      </article>

      <article class="chapter" id="kalvoice" aria-labelledby="voice-title">
        <div class="chapter__head">
          <p class="chip chip--dev">In development</p>
          <h2 id="voice-title" class="h2 h2--sm">KalVoice: speak, don't type.</h2>
        </div>
        <div class="chapter__body">
          <p>
            Hold {KALVOICE.pushToTalkKey} and speak. Into a focused input, your words are typed there —
            transcribed on your device and unlimited on every plan. Say a command, and KalCode does it.
          </p>
          <a class="text-link" href="/kalvoice">Meet KalVoice <Icon name="arrow-right" /></a>
        </div>
      </article>

      <article class="chapter" id="local-first" aria-labelledby="local-title">
        <div class="chapter__head">
          <p class="chip chip--built">Built</p>
          <h2 id="local-title" class="h2 h2--sm">Local-first by default.</h2>
        </div>
        <div class="chapter__body">
          <p>
            Projects, threads, events and settings stay in a local database on your device.
            Credentials go to your operating system's keychain and are never written to the database,
            logs or the interface. Current builds send no telemetry.
          </p>
          <a class="text-link" href="/docs/local-first">What stays on your device <Icon name="arrow-right" /></a>
        </div>
      </article>
    </div>
  </section>

  <section class="section section--sunken" id="status" aria-labelledby="status-title">
    <div class="container">
      <header class="section-head section-head--split">
        <h2 id="status-title" class="h2">What is built today.</h2>
        <p>Updated with every milestone. Nothing here is publicly released yet.</p>
      </header>
      <div class="table-wrap" role="region" aria-label="Build status by capability" tabindex="0">
        <table class="table">
          <caption class="visually-hidden">KalCode capabilities and their build status</caption>
          <thead>
            <tr>
              <th scope="col">Capability</th>
              <th scope="col">Status</th>
              <th scope="col">Detail</th>
            </tr>
          </thead>
          <tbody>
            {
              roadmap.map((item) => (
                <tr>
                  <th scope="row">{item.capability}</th>
                  <td>
                    <span class:list={["chip", item.state === "planned" ? undefined : `chip--${item.state}`]}>
                      {stateLabel[item.state]}
                    </span>
                  </td>
                  <td>{item.note}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="section-foot">
        <a class="text-link" href="/changelog">Read the changelog <Icon name="arrow-right" /></a>
      </p>
    </div>
  </section>

  <Closing />
</Base>

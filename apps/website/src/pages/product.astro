---
import Backdrop from "../components/Backdrop.astro";
import Closing from "../components/Closing.astro";
import Icon from "../components/Icon.astro";
import PageHead from "../components/PageHead.astro";
import StageSlot from "../components/StageSlot.astro";
import { hasStage } from "../lib/stage";
import Base from "../layouts/Base.astro";
import { RELEASES, buildStatus, releaseCopy, signedStableRelease } from "../lib/releases";
import { GEMINI_AVAILABILITY, KALVOICE, PROVIDERS, getPage } from "../lib/site";

const page = getPage("/product");
const stableKalVoice = signedStableRelease(RELEASES) !== null;

const runs: Record<(typeof PROVIDERS)[number]["id"], string> = {
  claude: "Headless stream mode: threads you can resume and interrupt",
  codex: "Headless JSON mode: threads you can resume and interrupt",
  gemini: "Headless stream mode: threads you can resume and interrupt",
};

type State = "built" | "dev" | "planned";
const stateLabel: Record<State, string> = { built: "Built", dev: "In development", planned: "Planned" };

const statuses = [
  { label: "Working", tone: "live" },
  { label: "Needs approval", tone: "dev" },
  { label: "Needs your reply", tone: "dev" },
  { label: "Blocked", tone: "danger" },
  { label: "Paused", tone: "idle" },
  { label: "Idle", tone: "idle" },
  { label: "Failed", tone: "danger" },
  { label: "Done", tone: "built" },
] as const;

const modes: { name: string; text: string; planned?: boolean }[] = [
  { name: "Plan", text: "Read and plan. Nothing is modified; writes, commands and network changes are denied or asked." },
  { name: "Approve", text: "The default. Safe work proceeds; anything that needs your authority pauses for a decision." },
  { name: "Auto", text: "Actions covered by your rules run automatically. Everything else still asks." },
  { name: "Bypass", text: "Broad local authority, only when you choose it, with a persistent indicator. Pushes, deploys and spending keep their own rules.", planned: true },
  { name: "Custom", text: "Named rule sets you define, such as a read-only reviewer or a local builder.", planned: true },
];

const roadmap: { capability: string; state: State; note: string }[] = [
  { capability: "App shell, search and palette, light and dark themes", state: "built", note: "In the app today" },
  { capability: "Workspaces and real terminals", state: "built", note: "PowerShell, Command Prompt, Git Bash; restore after restart" },
  { capability: "Claude Code, Codex and Gemini CLI adapters", state: "built", note: releaseCopy("Sign-in per account from KalCode, streamed threads, resume, interrupt. Gemini CLI is unavailable in 0.1.6 after Google ended Sign in with Google for personal accounts", RELEASES) },
  { capability: "Dashboard", state: "built", note: "Live thread status from runtime events, with approvals inline" },
  { capability: "Approvals and permission modes", state: "built", note: "Permission engine, the Approvals panel, and Plan, Approve or Auto for every thread. Bypass and Custom are planned" },
  { capability: "KalVoice dictation and commands", state: stableKalVoice ? "built" : "dev", note: stableKalVoice ? "Available in Stable with signed local component setup" : "On-device recognition and command grammar in development" },
  { capability: "Split panes and the Browser pane", state: "built", note: "In Code: terminals, the browser and threads in panes you can split and resize" },
  { capability: "File tree, Git and diff views", state: "planned", note: "Shown in previews with a Planned label" },
  { capability: "Agents, Missions, Automations", state: "planned", note: "Not in the Stable app yet" },
];
---
<Base title={page.title} description={page.description} path={page.path} world>
  <PageHead
    backdrop="orbital"
    title="The workspace, piece by piece."
    lead="What each part of KalCode does, and how far along it is. Previews use sample data; the table at the end says what is built today."
    status={buildStatus()}
  >
    <div class="button-row">
      <a class="button button--secondary" href="#status">What is built today <Icon name="arrow-down" /></a>
    </div>
  </PageHead>

  {
    hasStage("BeforeAfter") && (
      <section class="world-section" id="terminals" aria-labelledby="terminals-title">
        <Backdrop variant="gravity" />
        <div class="container">
          <header class="statement statement--wide">
            <p class="eyebrow">The problem</p>
            <h2 id="terminals-title" class="h2">Stop juggling agent terminals.</h2>
            <p class="body-lg">
              Six loose windows and no idea which one is waiting on you — or one workspace where every
              agent has a place and a status.
            </p>
          </header>
        </div>
        <div class="container container--wide">
          <StageSlot name="BeforeAfter" />
        </div>
      </section>
    )
  }

  {
    hasStage("ScrollStory") && (
      <section class="world-section world-section--tall" id="story" aria-labelledby="story-title">
        <Backdrop variant="orbital" />
        <div class="container">
          <header class="statement statement--center">
            <p class="eyebrow">The workspace</p>
            <h2 id="story-title" class="h2">Watch it come together.</h2>
            <p class="body-lg">
              A real terminal, Claude Code, Codex beside it, the Dashboard, and an approval that waits
              for you.
            </p>
          </header>
        </div>
        <div class="container container--wide">
          <StageSlot name="ScrollStory" />
        </div>
      </section>
    )
  }

  {
    hasStage("DemoCenter") && (
      <section class="world-section" id="in-action" aria-labelledby="in-action-title">
        <Backdrop variant="nebula" />
        <div class="container">
          <header class="statement statement--center">
            <p class="eyebrow">See it in action</p>
            <h2 id="in-action-title" class="h2">One scene at a time.</h2>
            <p class="body-lg">Multi-agent work, KalVoice, permissions, the Dashboard and Code Mode.</p>
          </header>
        </div>
        <div class="container container--wide">
          <StageSlot name="DemoCenter" />
        </div>
      </section>
    )
  }

  <section class="world-section" aria-label="What KalCode does">
    <Backdrop variant="deep" />
    <div class="container chapters">
      <article class="chapter" id="workspace" aria-labelledby="workspace-title">
        <div class="chapter__head">
          <p class="chip chip--built">Built</p>
          <h2 id="workspace-title" class="h2 h2--sm">Real terminals in a real workspace.</h2>
        </div>
        <div class="chapter__body">
          <p>
            Open a project folder and KalCode starts real terminals inside it — PowerShell, Command
            Prompt, Git Bash — with full colour, exit codes, and a layout that comes back after a restart.
            Type <code>claude</code> or <code>codex</code> in a terminal and the CLI runs exactly as it
            does anywhere else.
          </p>
          <p>Terminals, the browser and threads open in panes you can split and resize.</p>
        </div>
      </article>

      <article class="chapter" id="providers" aria-labelledby="providers-title">
        <div class="chapter__head">
          <p class="chip chip--built">Built · Claude Code, Codex</p>
          <h2 id="providers-title" class="h2 h2--sm">Your providers, on your own accounts.</h2>
          <p>Connecting a provider is free on every plan.</p>
        </div>
        <div class="chapter__body">
          <div class="table-wrap" role="region" aria-label="Provider connections" tabindex="0">
            <table class="table">
              <caption class="visually-hidden">Providers, the account each uses, and how KalCode runs it today</caption>
              <thead>
                <tr>
                  <th scope="col">Provider</th>
                  <th scope="col">Uses your own</th>
                  <th scope="col">How KalCode runs it</th>
                  <th scope="col">Status</th>
                </tr>
              </thead>
              <tbody>
                {
                  PROVIDERS.map((provider) => (
                    <tr>
                      <th scope="row">{provider.name}</th>
                      <td>{provider.access}</td>
                      <td>{runs[provider.id]}</td>
                      <td>
                        <span class:list={["chip", provider.state === "built" ? "chip--built" : "chip--dev"]}>{releaseCopy(provider.status, RELEASES)}</span>
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <p>{releaseCopy(GEMINI_AVAILABILITY.notice, RELEASES)}</p>
          <p>
            KalCode uses documented integration methods only: each provider's own sign-in, run from
            KalCode for your account. It never copies hidden credentials or scrapes browser sessions. Usage is
            billed by the provider, as it is today — KalCode never charges for, resells or meters it.
          </p>
          <a class="text-link" href="/docs/providers">How provider connections work <Icon name="arrow-right" /></a>
        </div>
      </article>

      <article class="chapter" id="threads" aria-labelledby="threads-title">
        <div class="chapter__head">
          <p class="chip chip--built">Built</p>
          <h2 id="threads-title" class="h2 h2--sm">Every thread, one Dashboard.</h2>
        </div>
        <div class="chapter__body">
          <p>
            Status comes from structured runtime events — a thread started, a tool ran, an approval was
            requested — never from a model's account of its own progress. Every status is a glyph and
            a word, never colour alone:
          </p>
          <ul class="status-set" role="list">
            {statuses.map((status) => <li class:list={["chip", `chip--${status.tone}`]}>{status.label}</li>)}
          </ul>
        </div>
      </article>

      <article class="chapter" id="permissions" aria-labelledby="permissions-title">
        <div class="chapter__head">
          <p class="chip chip--built">Built</p>
          <h2 id="permissions-title" class="h2 h2--sm">You set the rules. Agents follow them.</h2>
          <p>Threads run in Plan, Approve or Auto on every plan. Bypass and Custom are planned.</p>
        </div>
        <div class="chapter__body">
          <div class="table-wrap" role="region" aria-label="Permission modes" tabindex="0">
            <table class="table">
              <caption class="visually-hidden">Permission modes and what each allows</caption>
              <thead>
                <tr>
                  <th scope="col">Mode</th>
                  <th scope="col">What it allows</th>
                </tr>
              </thead>
              <tbody>
                {
                  modes.map((mode) => (
                    <tr>
                      <th scope="row">{mode.name}{mode.planned && <> <span class="chip">Planned</span></>}</th>
                      <td>{mode.text}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <p>
            When a decision is needed, KalCode asks with three choices, in this order: Deny, Allow for
            thread, and Approve once — the safe default. KalVoice asks the same way and can never turn
            on Bypass.
          </p>
          <a class="text-link" href="/docs/permissions">Read the permission model <Icon name="arrow-right" /></a>
        </div>
      </article>

      <article class="chapter" id="kalvoice" aria-labelledby="voice-title">
        <div class="chapter__head">
          <p class:list={["chip", stableKalVoice ? "chip--built" : "chip--dev"]}>{stableKalVoice ? "Built" : "In development"}</p>
          <h2 id="voice-title" class="h2 h2--sm">KalVoice: speak, don't type.</h2>
        </div>
        <div class="chapter__body">
          <p>
            Hold {KALVOICE.pushToTalkKey} and speak. Into a focused input, your words are typed there —
            transcribed on your device and unlimited on every plan. Say a command, and KalCode does it.
          </p>
          <a class="text-link" href="/kalvoice">Meet KalVoice <Icon name="arrow-right" /></a>
        </div>
      </article>

      <article class="chapter" id="local-first" aria-labelledby="local-title">
        <div class="chapter__head">
          <p class="chip chip--built">Built</p>
          <h2 id="local-title" class="h2 h2--sm">Local-first by default.</h2>
        </div>
        <div class="chapter__body">
          <p>
            Projects, threads, events and settings stay in a local database on your device.
            Your KalCode account session is kept in your operating system's credential store. Each
            provider's own CLI keeps its sign-in, through a separate KalCode-managed profile for every
            account, and KalCode never reads or copies it. Neither is written to KalCode's database, logs or the interface.
            Current builds send no telemetry.
          </p>
          <a class="text-link" href="/docs/local-first">What stays on your device <Icon name="arrow-right" /></a>
        </div>
      </article>
    </div>
  </section>

  <section class="world-section" id="status" aria-labelledby="status-title">
    <Backdrop variant="orbital" />
    <div class="container">
      <header class="section-head section-head--split">
        <h2 id="status-title" class="h2">What is built today.</h2>
        <p>Updated with every milestone. Built means in the app you can download today.</p>
      </header>
      <div class="table-wrap" role="region" aria-label="Build status by capability" tabindex="0">
        <table class="table">
          <caption class="visually-hidden">KalCode capabilities and their build status</caption>
          <thead>
            <tr>
              <th scope="col">Capability</th>
              <th scope="col">Status</th>
              <th scope="col">Detail</th>
            </tr>
          </thead>
          <tbody>
            {
              roadmap.map((item) => (
                <tr>
                  <th scope="row">{item.capability}</th>
                  <td>
                    <span class:list={["chip", item.state === "planned" ? undefined : `chip--${item.state}`]}>
                      {stateLabel[item.state]}
                    </span>
                  </td>
                  <td>{item.note}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="section-foot">
        <a class="text-link" href="/updates">Read product updates <Icon name="arrow-right" /></a>
      </p>
    </div>
  </section>

  <Closing />
</Base>

---
import { PLAN_FEATURE_GROUPS, type PlanFeature, getPlan, getPlanFeature } from "@kalcode/protocol/plans";
import Backdrop from "../components/Backdrop.astro";
import Closing from "../components/Closing.astro";
import Icon from "../components/Icon.astro";
import PageHead from "../components/PageHead.astro";
import ProviderGlyph from "../components/ProviderGlyph.astro";
import StageSlot from "../components/StageSlot.astro";
import AgentWorkspace from "../components/stage/parts/AgentWorkspace.astro";
import Base from "../layouts/Base.astro";
import { RELEASES, buildStatus, servedStableRelease } from "../lib/releases";
import { KALVOICE, PROVIDERS, PROVIDER_LINE, getPage } from "../lib/site";
import { AGENT_STATES, hasStage, inlineIcon as icon } from "../lib/stage";

const page = getPage("/product");
const stable = servedStableRelease(RELEASES);

/** "Every plan", "Pro and up", "MAX 2X": the lowest plan a catalog feature is on. */
const planLabel = (feature: PlanFeature) =>
  feature.from === "free" ? "Every plan" : feature.from === "max2x" ? getPlan("max2x").name : `${getPlan(feature.from).name} and up`;
/** "0.1.9 · build 1565" from the catalog's `verifiedIn` ("0.1.9+1565"). */
const builtIn = (feature: PlanFeature) => {
  const [version, build] = (feature.verifiedIn ?? "").split("+");
  return build ? `${version} · build ${build}` : (version ?? "");
};

/** What KalCode is made of, each tied to its catalog entry so its tag can never drift. */
const parts: { icon: Parameters<typeof icon>[0]; title: string; text: string; feature: PlanFeature }[] = [
  {
    icon: "dashboard",
    title: "Agent Fleet and Needs You",
    text: "Every agent you run, on every provider, with one state: starting, working, waiting, needs you, ready, done or failed. Needs You collects what's waiting on you.",
    feature: getPlanFeature("agent-fleet"),
  },
  {
    icon: "operations",
    title: "Operations",
    text: "Runs, Queue, Services, Environments and Activity. Every task becomes one record from queued to finished, next to your dev servers and environments.",
    feature: getPlanFeature("operations"),
  },
  {
    icon: "memory",
    title: "Unified Memory",
    text: "Project memory your agents share, across Claude Code, Codex, Cursor and Gemini CLI, kept on your device.",
    feature: getPlanFeature("unified-memory"),
  },
  {
    icon: "globe",
    title: "Live Browser",
    text: "Your app in a pane beside the agent building it. KalCode finds your localhost dev server by itself.",
    feature: getPlanFeature("core-browser"),
  },
  {
    icon: "users",
    title: "Accounts and usage",
    text: "Account Hub and the Account & Usage Center: personal and work accounts, usage left before you launch, an account picker in every terminal header and suggestions when one runs low.",
    feature: getPlanFeature("account-hub"),
  },
  {
    icon: "kalvoice",
    title: "KalVoice",
    text: `Hold ${KALVOICE.pushToTalkKey}, or Fn on a Mac, and speak: words go into the focused agent, commands run KalCode. Dictation stays on your device and is unlimited.`,
    feature: getPlanFeature("kalvoice-dictation"),
  },
  {
    icon: "search",
    title: "Navigation",
    text: "Back and Forward, breadcrumbs, one quick switcher for everything, keyboard shortcuts, workspace favorites and global pins.",
    feature: getPlanFeature("quick-switcher"),
  },
  {
    icon: "handoff",
    title: "Agent Hand Off",
    text: "Pass work from one coding agent to another, with the context it needs to review what was done.",
    feature: getPlanFeature("agent-handoff"),
  },
];

/** The roadmap, rendered straight from the plan catalog: Available (with its build) or Coming soon. */
const roadmap = PLAN_FEATURE_GROUPS.map((group) => ({
  id: group.id,
  title: group.title.replace(" — every plan", ""),
  features: [...group.features].sort((a, b) => Number(a.status !== "available") - Number(b.status !== "available")),
  available: group.features.filter((f) => f.status === "available").length,
}));
const availableCount = roadmap.reduce((n, g) => n + g.available, 0);
const soonCount = roadmap.reduce((n, g) => n + g.features.length - g.available, 0);
---
<Base title={page.title} description={page.description} path={page.path} world>
  <PageHead
    backdrop="orbital"
    title="The workspace for coding agents."
    lead="Claude Code, Codex, Cursor and Gemini CLI in real terminals, and everything around them: Agent Fleet, Operations, Unified Memory, Live Browser, accounts and KalVoice."
    status={buildStatus()}
    statusKind={stable ? "built" : "dev"}
  >
    <div class="button-row">
      <a class="button button--secondary" href="#roadmap">What ships today <Icon name="arrow-down" /></a>
    </div>
  </PageHead>

  <!-- Code: agents are terminals. -->
  <section class="world-section prod" id="code" aria-labelledby="code-title">
    <Backdrop variant="gravity" />
    <div class="container container--wide prod__split">
      <div class="prod__copy">
        <p class="eyebrow">Code</p>
        <h2 id="code-title" class="h2">Every agent is a real coding terminal.</h2>
        <p class="body-lg">
          An agent in KalCode is the provider's own CLI in its own terminal pane, never a chat thread.
          Open New agent, pick the provider, account, model and effort, and launch up to ten at once.
        </p>
        <ul class="prod__list" role="list">
          <li><Icon name="check" /> Tabbed terminal panes you split, stack into groups and rename</li>
          <li><Icon name="check" /> Smart Close asks before stopping busy work; New like this repeats a launch</li>
          <li><Icon name="check" /> Image attachments, automatic localhost detection and a Browser pane beside agents</li>
          <li><Icon name="check" /> Unlimited local agents and terminals on every plan</li>
        </ul>
      </div>
      <div class="prod__visual">
        <AgentWorkspace flat />
      </div>
    </div>
  </section>

  <!-- Providers: native parity on your own accounts. -->
  <section class="world-section prod" id="providers" aria-labelledby="providers-title">
    <Backdrop variant="deep" />
    <div class="container container--wide">
      <header class="prod__head">
        <p class="eyebrow">Providers</p>
        <h2 id="providers-title" class="h2">Your providers, exactly as they are.</h2>
        <p class="body-lg">{PROVIDER_LINE}</p>
      </header>
      <ul class="prov" role="list">
        {
          PROVIDERS.map((provider) => (
            <li class="prov__card">
              <p class="prov__name"><ProviderGlyph provider={provider.id} />{provider.name}</p>
              <p class="prov__status"><span class="status-dot status-dot--built" aria-hidden="true" />{provider.status}</p>
              <p class="prov__runs">{provider.runs}</p>
              <p class="prov__access">{provider.access}</p>
            </li>
          ))
        }
      </ul>
      <p class="prod__fine">
        Agents see your real environment, such as your SSH agent, GitHub token and cloud credentials. KalCode
        uses each provider's own sign-in and never pays for, resells or meters your usage; your provider
        subscription, its rate and concurrency limits, and your hardware still apply.
        <a class="text-link" href="/docs/providers">How provider connections work <Icon name="arrow-right" /></a>
      </p>
    </div>
  </section>

  <!-- The rest of the workspace, each part tagged from the catalog. -->
  <section class="world-section prod" id="workspace" aria-labelledby="workspace-title">
    <Backdrop variant="nebula" intensity="low" />
    <div class="container container--wide">
      <header class="prod__head">
        <p class="eyebrow">Around your agents</p>
        <h2 id="workspace-title" class="h2">Everything they need, in one window.</h2>
      </header>
      <ul class="parts" role="list">
        {
          parts.map((part) => (
            <li class="parts__card">
              <span class="parts__icon" aria-hidden="true"><Fragment set:html={icon(part.icon)} /></span>
              <h3 class="parts__title">{part.title}</h3>
              <p class="parts__text">{part.text}</p>
              <p class="parts__tag" data-available={String(part.feature.status === "available")}>
                {part.feature.status === "available" ? planLabel(part.feature) : "Coming soon"}
              </p>
            </li>
          ))
        }
      </ul>
      <ol class="prod-states" role="list" aria-label="Agent states">
        {AGENT_STATES.map((state) => <li data-state={state.toLowerCase().replace(" ", "-")}>{state}</li>)}
      </ol>
    </div>
  </section>

  <!-- Control: permissions and local-first. -->
  <section class="world-section prod" id="control" aria-labelledby="control-title">
    <Backdrop variant="deep" />
    <div class="container container--wide prod__split prod__split--flip">
      <div class="prod__copy">
        <p class="eyebrow">Control</p>
        <h2 id="control-title" class="h2">Agents just work. Secrets still ask.</h2>
        <p class="body-lg">
          New coding agents start in Bypass: edits, commands, tests, builds, Git, pushes and dev servers run
          without approval prompts. Plan is the read-only alternative. Access to credentials and secrets
          always asks. Every mode is on every plan.
        </p>
        <p>
          Projects, Threads, events and settings stay in a local database on your device. Your KalCode
          session is kept in your operating system's credential store, and each provider's CLI keeps its own
          sign-in. Current builds send no telemetry.
        </p>
        <p class="prod__links">
          <a class="text-link" href="/docs/permissions">How permissions work <Icon name="arrow-right" /></a>
          <a class="text-link" href="/docs/local-first">What stays on your device <Icon name="arrow-right" /></a>
        </p>
      </div>
      {
        hasStage("PermissionModes") && (
          <div class="prod__visual">
            <StageSlot name="PermissionModes" id="product-permission-modes" width="compact" />
          </div>
        )
      }
    </div>
  </section>

  <!-- The roadmap, from the plan catalog. -->
  <section class="world-section prod" id="roadmap" aria-labelledby="roadmap-title">
    <Backdrop variant="orbital" />
    <div class="container container--wide">
      <header class="prod__head prod__head--row">
        <div>
          <p class="eyebrow">Roadmap</p>
          <h2 id="roadmap-title" class="h2">What ships today, and what's next.</h2>
        </div>
        <p>
          Available means it's in the KalCode you download today, with the build it was verified in. Coming
          soon is assigned to its plan and turns Available only once it ships.
          <span class="road__counts"><b>{availableCount}</b> available · <b>{soonCount}</b> coming soon</span>
        </p>
      </header>
      <div class="road">
        {
          roadmap.map((group) => (
            <section class="road__group" aria-labelledby={`road-${group.id}`}>
              <h3 class="road__title" id={`road-${group.id}`}>
                {group.title}
                <small>{group.available} of {group.features.length} available</small>
              </h3>
              <ul class="road__list" role="list">
                {group.features.map((feature) => (
                  <li class="road__row" data-status={feature.status}>
                    <span class="road__label">
                      {feature.label}
                      {feature.detail && <small>{feature.detail}</small>}
                    </span>
                    <span class="road__plan">{planLabel(feature)}</span>
                    <span class="road__status">
                      {feature.status === "available" ? (
                        <>
                          <span class="road__badge road__badge--live">Available</span>
                          <small>{builtIn(feature)}</small>
                        </>
                      ) : (
                        <span class="road__badge">Coming soon</span>
                      )}
                    </span>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
      <p class="prod__links prod__links--center">
        <a class="text-link" href="/pricing">Compare plans <Icon name="arrow-right" /></a>
        <a class="text-link" href="/updates">Read product updates <Icon name="arrow-right" /></a>
      </p>
    </div>
  </section>

  <Closing />
</Base>

<style>
  .prod {
    padding-block: clamp(2.5rem, 1.75rem + 3vw, 5rem);
  }

  .prod__split {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
  }

  .prod__split--flip .prod__copy {
    order: 2;
  }

  .prod__copy {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    color: var(--color-text-secondary);
  }

  .prod__copy .body-lg {
    color: var(--color-text-secondary);
  }

  .prod__visual {
    min-width: 0;
  }

  .prod__list {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .prod__list li {
    display: flex;
    gap: var(--space-2);
  }

  .prod__list :global(svg) {
    flex: none;
    width: 1em;
    height: 1em;
    margin-top: 0.3em;
    color: var(--status-working);
  }

  .prod__head {
    display: grid;
    gap: var(--space-3);
    max-width: 46rem;
    margin-bottom: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
  }

  .prod__head .body-lg,
  .prod__head > p {
    color: var(--color-text-secondary);
  }

  .prod__head--row {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: end;
    gap: var(--space-4) clamp(2rem, 1rem + 4vw, 5rem);
    max-width: none;
  }

  .prod__head--row .h2 {
    margin-top: var(--space-3);
  }

  .prod__fine {
    max-width: 52rem;
    margin-top: var(--space-5);
    color: var(--color-text-muted);
    font-size: var(--site-text-small);
  }

  .prod__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
  }

  .prod__links--center {
    justify-content: center;
    margin-top: var(--space-6);
  }

  .prod :global(.text-link svg) {
    width: 0.875em;
    height: 0.875em;
    vertical-align: -0.1em;
  }

  /* Providers */
  .prov {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .prov__card {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: var(--space-2);
    padding: 1.125rem 1.25rem 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--panel-sheen), var(--color-surface-1);
    box-shadow: var(--shadow-panel);
  }

  .prov__name {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .prov__name :global(.provider-glyph__mark) {
    width: 1.375rem;
    height: 1.375rem;
  }

  .prov__status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--status-working-text);
    font-size: var(--site-text-xs);
    font-weight: var(--weight-medium);
  }

  .prov__runs {
    color: var(--color-text-secondary);
    font-size: var(--site-text-small);
    line-height: 1.5;
  }

  .prov__access {
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-border-subtle);
    color: var(--color-text-muted);
    font-size: var(--site-text-xs);
  }

  /* Parts */
  .parts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .parts__card {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: var(--space-2);
    padding: 1.125rem 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--panel-sheen), var(--color-surface-1);
    box-shadow: var(--shadow-panel);
    transition:
      border-color var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }

  .parts__card:hover {
    border-color: var(--color-border-lit-soft);
    transform: translateY(-2px);
  }

  .parts__icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--color-border-lit-soft);
    border-radius: var(--radius-lg);
    background: var(--color-accent-soft);
    color: var(--color-accent-text);
  }

  .parts__icon :global(svg) {
    width: 1.125rem;
    height: 1.125rem;
  }

  .parts__title {
    margin: 0.25rem 0 0;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 700;
  }

  .parts__text {
    color: var(--color-text-secondary);
    font-size: var(--site-text-small);
    line-height: 1.55;
  }

  .parts__tag {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: var(--space-2);
    color: var(--color-accent-text);
    font-size: 0.6875rem;
    font-weight: var(--weight-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .parts__tag::before {
    content: "";
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: currentColor;
  }

  .parts__tag[data-available="true"] {
    color: var(--status-working-text);
  }

  .prod-states {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .prod-states li {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    padding: 0.3125rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-surface-1);
    color: var(--color-text-secondary);
    font-size: var(--site-text-small);
  }

  .prod-states li::before {
    content: "";
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 50%;
    background: var(--status-muted);
  }

  .prod-states li[data-state="working"]::before {
    background: var(--status-working);
  }

  .prod-states li[data-state="waiting"]::before,
  .prod-states li[data-state="needs-you"]::before {
    background: var(--status-waiting);
  }

  .prod-states li[data-state="ready"]::before {
    background: var(--status-recovering);
  }

  .prod-states li[data-state="done"]::before {
    background: var(--status-done);
  }

  .prod-states li[data-state="failed"]::before {
    background: var(--status-failed);
  }

  /* Roadmap */
  .road__counts {
    display: block;
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--site-text-small);
  }

  .road__counts b {
    color: var(--color-text);
  }

  /* Balanced columns, so a long group never leaves a hole beside it. */
  .road {
    columns: 2 26rem;
    column-gap: var(--space-4);
  }

  .road__group {
    display: inline-block;
    width: 100%;
    margin-bottom: var(--space-4);
    break-inside: avoid;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-surface-1);
    box-shadow: var(--shadow-panel);
  }

  .road__title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin: 0;
    padding: 0.875rem 1.125rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--panel-sheen), var(--color-surface-2);
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
  }

  .road__title small {
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--site-text-xs);
    font-weight: var(--weight-regular);
  }

  .road__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .road__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 6.5rem 8.25rem;
    align-items: center;
    gap: var(--space-3);
    padding: 0.5625rem 1.125rem;
    font-size: var(--site-text-small);
  }

  .road__row + .road__row {
    border-top: 1px solid var(--color-border-subtle);
  }

  .road__label {
    display: grid;
    color: var(--color-text);
    line-height: 1.4;
  }

  .road__row[data-status="coming_soon"] .road__label {
    color: var(--color-text-secondary);
  }

  .road__label small {
    color: var(--color-text-muted);
    font-size: var(--site-text-xs);
  }

  .road__plan {
    color: var(--color-text-muted);
    font-size: var(--site-text-xs);
  }

  .road__status {
    display: grid;
    justify-items: start;
    gap: 0.125rem;
  }

  .road__status small {
    color: var(--color-text-faint);
    font-size: 0.6875rem;
    white-space: nowrap;
  }

  .road__badge {
    padding: 0.0625rem 0.5rem;
    border: 1px solid var(--color-border-lit-soft);
    border-radius: var(--radius-full);
    color: var(--color-accent-text);
    font-size: 0.6875rem;
    font-weight: var(--weight-medium);
    white-space: nowrap;
  }

  .road__badge--live {
    border-color: var(--status-working-line);
    background: var(--status-working-soft);
    color: var(--status-working-text);
  }

  @media (max-width: 72rem) {
    .prov,
    .parts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

  }

  @media (max-width: 60rem) {
    .prod__split,
    .prod__head--row {
      grid-template-columns: minmax(0, 1fr);
    }

    .prod__split--flip .prod__copy {
      order: 0;
    }
  }

  @media (max-width: 36rem) {
    .prov,
    .parts {
      grid-template-columns: minmax(0, 1fr);
    }

    .road__row {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.25rem var(--space-3);
    }

    .road__label {
      grid-column: 1 / -1;
    }

    .road__status {
      justify-items: end;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .parts__card {
      transition: none;
    }

    .parts__card:hover {
      transform: none;
    }
  }
</style>

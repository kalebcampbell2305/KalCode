---
import EarlyAccessForm from "../components/EarlyAccessForm.astro";
import PageHead from "../components/PageHead.astro";
import Base from "../layouts/Base.astro";
import { getPage } from "../lib/site";

const page = getPage("/download");
---
<Base title={page.title} description={page.description} path={page.path}>
  <PageHead
    title="There is no public build yet."
    lead="KalCode is in private development. When there is a build ready to try, early-access members hear first."
  />

  <section class="section" id="early-access" aria-labelledby="early-access-title">
    <div class="container signup">
      <div class="section-head">
        <h2 id="early-access-title" class="h2">Join early access.</h2>
        <p>
          Leave your email and we'll write when there is something to install. No account and no
          payment details are needed.
        </p>
      </div>
      <EarlyAccessForm source="/download" />
    </div>
  </section>

  <section class="section" aria-labelledby="expect-title">
    <div class="container split">
      <div class="split__aside section-head">
        <h2 id="expect-title" class="h2">What to expect.</h2>
      </div>
      <dl class="definition-list">
        <div>
          <dt class="h3">A desktop app</dt>
          <dd>
            KalCode is being built as a desktop application for Windows, macOS and Linux. It runs
            your providers locally, in your own workspaces and terminals.
          </dd>
        </div>
        <div>
          <dt class="h3">Signed releases</dt>
          <dd>
            Code-signed installers and signed updates are planned before public release, so you
            can verify that a build came from us.
          </dd>
        </div>
        <div>
          <dt class="h3">Your providers, your accounts</dt>
          <dd>
            You connect the Claude Code, Codex or Gemini CLI setup you already use. Connecting
            providers is free on every plan, and KalCode never charges for or meters your provider
            usage.
          </dd>
        </div>
        <div>
          <dt class="h3">Progress in the open</dt>
          <dd>
            Development milestones are listed in the <a class="text-link" href="/changelog">changelog</a>.
          </dd>
        </div>
      </dl>
    </div>
  </section>
</Base>

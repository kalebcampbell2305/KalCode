---
import Backdrop from "../components/Backdrop.astro";
import DownloadPlatforms from "../components/DownloadPlatforms.astro";
import EarlyAccessForm from "../components/EarlyAccessForm.astro";
import PageHead from "../components/PageHead.astro";
import Base from "../layouts/Base.astro";
import { RELEASES, buildFor, formatReleaseDate } from "../lib/releases";
import { getPage } from "../lib/site";

const page = getPage("/download");
const latest = RELEASES.latest;
const windows = buildFor(RELEASES, "windows");
---
<Base title={page.title} description={page.description} path={page.path} world>
  <PageHead
    backdrop="orbital"
    title="Download KalCode"
    status={latest ? `Preview ${latest.version} · ${formatReleaseDate(latest.publishedAt)}` : "No public build yet"}
    statusKind={latest ? "built" : "dev"}
    lead={
      latest
        ? "A preview build of the KalCode desktop app. Check its SHA-256 before you run it."
        : "KalCode is in private development. Builds appear here the moment they are published, with the version, size and SHA-256 of every file."
    }
  />

  <section class="world-section" aria-labelledby="platforms-title">
    <Backdrop variant="deep" />
    <div class="container">
      <h2 id="platforms-title" class="visually-hidden">Builds by operating system</h2>
      <DownloadPlatforms />
      {
        windows && (
          <div class="prose section-foot">
            <p>
              To check the file in PowerShell, run <code>Get-FileHash .\{windows.file} -Algorithm SHA256</code>{" "}
              and compare the hash with the one above.
            </p>
          </div>
        )
      }
    </div>
  </section>

  <section class="world-section" id="early-access" aria-labelledby="early-access-title">
    <Backdrop variant="nebula" />
    <div class="container signup">
      <div class="section-head">
        <h2 id="early-access-title" class="h2 h2--sm">{latest ? "Hear about new builds." : "Join early access."}</h2>
        <p>
          Leave your email and we'll write when there is {latest ? "a new build" : "a build"} to try.
          No account and no payment details.
        </p>
      </div>
      <EarlyAccessForm source="/download" />
    </div>
  </section>

  <section class="world-section section--tight" aria-labelledby="expect-title">
    <Backdrop variant="deep" />
    <div class="container">
      <h2 id="expect-title" class="h2 h2--sm">What to expect</h2>
      <ul class="expect" role="list">
        <li><strong>A desktop app.</strong> It runs your providers locally, in your own workspaces and terminals.</li>
        <li><strong>Your providers, your accounts.</strong> Claude Code, Codex and Gemini CLI connect free on every plan.</li>
        <li><strong>Verifiable files.</strong> Every build lists its SHA-256. Code signing is planned before a stable release.</li>
        <li><strong>Progress in the open.</strong> Milestones are in the <a class="text-link" href="/changelog">changelog</a>.</li>
      </ul>
    </div>
  </section>
</Base>

---
/**
 * /games/activate: approve KAL University on a computer (device sign-in, docs/BILLING.md §13).
 * The game shows an 8-letter code and opens this page; the signed-in owner enters (or confirms)
 * it, and the game receives its signed license on its next poll. Private: noindex, no-referrer,
 * not in the sitemap. The page decides nothing itself: api.kalcoded.com checks the session cookie,
 * ownership and the code.
 */
import Backdrop from "../../components/Backdrop.astro";
import BrandMark from "../../components/BrandMark.astro";
import Icon from "../../components/Icon.astro";
import PageHead from "../../components/PageHead.astro";
import Base from "../../layouts/Base.astro";
import { formatGamePrice, KAL_UNIVERSITY } from "@kalcode/protocol/games";
import { GAME_ACCOUNT_PAGES } from "../../lib/site";

const page = GAME_ACCOUNT_PAGES.activate;
---
<Base title={page.title} description={page.description} path={page.path} world noindex>
  <meta slot="head" name="referrer" content="no-referrer" />
  <PageHead
    backdrop="orbital"
    eyebrow="A KalCode Game"
    title="Sign in to KAL University"
    lead="Connect the game on your computer to the KalCode account that owns it. It takes one code, once."
  />

  <section class="world-section ga-section" aria-labelledby="ga-title">
    <Backdrop variant="deep" />
    <div class="container ga-shell">
      <div class="ga-panel" data-activate>
        <p class="ga-lockup"><BrandMark size={28} /><span>KAL University</span></p>
        <h2 id="ga-title" class="h2 h2--sm" data-title>Enter the code from the game</h2>

        <p class="ga-copy" data-state="checking">Checking your KalCode sign-in…</p>

        <div class="ga-state" data-state="signed-out" hidden>
          <p class="ga-copy">
            Sign in to the KalCode account that owns KAL University. You'll come straight back here to finish.
          </p>
          <a class="button button--primary" href="/account" data-signin>Sign in to KalCode <Icon name="arrow-right" /></a>
        </div>

        <form class="ga-form" data-state="form" hidden novalidate>
          <label for="ga-code">Code shown in KAL University</label>
          <div class="ga-form__row">
            <input
              id="ga-code"
              name="code"
              type="text"
              inputmode="text"
              autocomplete="one-time-code"
              autocapitalize="characters"
              spellcheck="false"
              maxlength="9"
              placeholder="BCDF-GHJK"
              aria-describedby="ga-code-hint"
              required
            />
            <button class="button button--primary" type="submit" data-approve>Approve <Icon name="check" /></button>
          </div>
          <p id="ga-code-hint" class="ga-hint">
            Eight letters, shown on the game's sign-in screen. Signed in as <strong data-email>your account</strong>.
          </p>
        </form>

        <div class="ga-state ga-done" data-state="done" hidden>
          <span class="ga-done__mark" aria-hidden="true"><Icon name="check" /></span>
          <div>
            <p class="ga-done__title">KAL University is signed in.</p>
            <p class="ga-copy">Go back to the game. It finishes on its own within a few seconds, and you can close this tab.</p>
            <a class="text-link" href={GAME_ACCOUNT_PAGES.library.path}>Open your Game Library <Icon name="arrow-right" /></a>
          </div>
        </div>

        <div class="ga-state" data-state="not-owned" hidden>
          <p class="ga-copy">
            <strong>This KalCode account doesn't own KAL University yet.</strong> It will be {formatGamePrice(KAL_UNIVERSITY)} on its own,
            and it's included with KalCode Pro, MAX and MAX 2X. It isn't on sale yet.
          </p>
          <div class="button-row">
            <a class="button button--secondary" href={`${KAL_UNIVERSITY.path}#own`}>Ways to own it <Icon name="arrow-right" /></a>
            <a class="text-link" href="/account">Use a different account</a>
          </div>
        </div>

        <p class="ga-status" data-status role="status" aria-live="polite"></p>
      </div>

      <aside class="ga-aside" aria-labelledby="ga-how">
        <h3 id="ga-how" class="ga-aside__title">How it works</h3>
        <ol class="ga-steps">
          <li><span class="ga-steps__n">1</span><p>In KAL University, choose <strong>Sign in with KalCode</strong>. The game shows a code and opens this page.</p></li>
          <li><span class="ga-steps__n">2</span><p>Enter the code here while signed in to the account that owns the game.</p></li>
          <li><span class="ga-steps__n">3</span><p>Play. Your license works offline and renews itself whenever you're online.</p></li>
        </ol>
        <p class="ga-note"><Icon name="lock" class="ga-note__icon" /> Only enter a code that KAL University shows on your own computer. KalCode never asks for it by email or chat.</p>
      </aside>
    </div>
  </section>
</Base>

<style>
  .ga-section {
    min-height: 34rem;
  }

  .ga-shell {
    display: grid;
    gap: clamp(2rem, 5vw, 4.5rem);
    grid-template-columns: minmax(0, 1.1fr) minmax(17rem, 0.9fr);
    align-items: start;
  }

  .ga-panel {
    position: relative;
    display: grid;
    gap: var(--space-4);
    padding: clamp(1.5rem, 4vw, 3rem);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(80% 60% at 100% 0%, rgb(var(--world-gold) / 0.08), transparent 70%),
      var(--world-panel);
    box-shadow: var(--world-panel-lit);
  }

  .ga-panel::before {
    position: absolute;
    top: 0;
    left: 12%;
    width: 42%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-accent-icy), transparent);
    content: "";
  }

  .ga-lockup {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0;
    color: rgb(var(--world-gold));
    font-family: var(--font-wider);
    font-size: var(--type-label);
    font-weight: var(--weight-medium);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .ga-lockup :global(.brand-mark) {
    border-radius: var(--radius-md);
  }

  .ga-panel .h2 {
    margin: 0;
  }

  .ga-copy {
    margin: 0;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .ga-copy strong {
    color: var(--color-text);
  }

  .ga-state {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .ga-state[hidden],
  .ga-form[hidden],
  .ga-copy[hidden] {
    display: none;
  }

  .ga-form {
    display: grid;
    gap: 0.6rem;
  }

  .ga-form label {
    color: var(--color-text-muted);
    font-size: var(--site-text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ga-form__row {
    display: flex;
    gap: 0.7rem;
  }

  .ga-form input {
    min-width: 0;
    flex: 1;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    background: var(--color-bg-sunken);
    color: var(--color-text);
    padding: 0.8rem 1rem;
    font-family: var(--font-mono);
    font-size: 1.35rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .ga-form input::placeholder {
    color: var(--color-text-faint);
  }

  .ga-form input:focus-visible {
    border-color: var(--color-border-focus);
    outline: 2px solid var(--color-accent-soft);
    outline-offset: 2px;
  }

  .ga-form input[aria-invalid="true"] {
    border-color: var(--color-danger-text);
  }

  .ga-hint {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .ga-hint strong {
    color: var(--color-text-secondary);
    font-weight: var(--weight-semibold);
  }

  .ga-done {
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: var(--space-4);
  }

  .ga-done__mark {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border-radius: var(--radius-full);
    background: var(--color-accent-soft);
    box-shadow: inset 0 0 0 1px var(--color-border-lit-soft), var(--glow-subtle);
    color: var(--color-accent-text);
  }

  .ga-done__mark :global(svg) {
    width: 1.4rem;
    height: 1.4rem;
  }

  .ga-done > div {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
  }

  .ga-done__title {
    margin: 0;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: var(--weight-semibold);
  }

  .ga-status {
    min-height: 1.5rem;
    margin: 0;
    color: var(--color-accent-text);
  }

  .ga-status[data-tone="error"] {
    color: var(--color-danger-text);
  }

  .ga-aside {
    display: grid;
    gap: var(--space-5);
  }

  .ga-aside__title {
    margin: 0;
    color: var(--color-text);
    font-size: 1rem;
    font-weight: var(--weight-semibold);
  }

  .ga-steps {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
    list-style: none;
  }

  .ga-steps li {
    display: grid;
    grid-template-columns: 2.4rem 1fr;
    column-gap: 1rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .ga-steps__n {
    color: var(--color-accent-text);
    font-family: var(--font-mono);
    font-size: var(--site-text-xs);
  }

  .ga-steps p,
  .ga-note {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .ga-steps strong {
    color: var(--color-text);
  }

  .ga-note {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    color: var(--color-text-muted);
  }

  .ga-note :global(.ga-note__icon) {
    width: 1.1rem;
    height: 1.1rem;
    flex: none;
    margin-top: 0.2rem;
  }

  @media (max-width: 52rem) {
    .ga-shell {
      grid-template-columns: 1fr;
    }

    .ga-form__row {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>

<script>
  import {
    formatUserCode,
    GAMES_API,
    GAMES_RETURN_KEY,
    isCompleteUserCode,
    serializeReturn,
  } from "../../lib/games-client";

  type State = "checking" | "signed-out" | "form" | "done" | "not-owned";
  const panel = document.querySelector<HTMLElement>("[data-activate]");
  const form = panel?.querySelector<HTMLFormElement>("form");
  const input = panel?.querySelector<HTMLInputElement>("#ga-code");
  const approve = panel?.querySelector<HTMLButtonElement>("[data-approve]");
  const status = panel?.querySelector<HTMLElement>("[data-status]");
  const title = panel?.querySelector<HTMLElement>("[data-title]");
  const emailOutput = panel?.querySelector<HTMLElement>("[data-email]");
  const signIn = panel?.querySelector<HTMLAnchorElement>("[data-signin]");

  function show(state: State) {
    for (const element of panel?.querySelectorAll<HTMLElement>("[data-state]") ?? []) {
      element.hidden = element.dataset.state !== state;
    }
    if (title) {
      title.textContent =
        state === "done" ? "You're all set" : state === "not-owned" ? "Not owned yet" : "Enter the code from the game";
    }
  }

  function say(text: string, tone: "info" | "error" = "info") {
    if (!status) return;
    status.textContent = text;
    status.dataset.tone = tone;
  }

  async function api(path: string, init: RequestInit = {}) {
    try {
      return await fetch(`${GAMES_API}${path}`, { ...init, credentials: "include" });
    } catch {
      return null;
    }
  }

  const fromLink = formatUserCode(new URL(location.href).searchParams.get("code") ?? "");
  if (input && fromLink) input.value = fromLink;
  // Keep the code out of history once it is in the field.
  if (new URL(location.href).searchParams.has("code")) history.replaceState({}, "", location.pathname);

  input?.addEventListener("input", () => {
    const formatted = formatUserCode(input.value);
    if (formatted !== input.value) input.value = formatted;
    input.removeAttribute("aria-invalid");
    say("");
  });

  signIn?.addEventListener("click", () => {
    try {
      localStorage.setItem(GAMES_RETURN_KEY, serializeReturn("/games/activate", input?.value ?? null, Date.now()));
    } catch {
      // Storage blocked: the visitor can come back with the game's link.
    }
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!input || !approve) return;
    const code = formatUserCode(input.value);
    if (!isCompleteUserCode(code)) {
      input.setAttribute("aria-invalid", "true");
      say("Enter all eight letters of the code the game shows.", "error");
      input.focus();
      return;
    }
    approve.disabled = true;
    say("Approving…");
    const response = await api("/v1/games/device/approve", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({ userCode: code }),
    });
    approve.disabled = false;
    if (response?.ok) {
      say("");
      show("done");
      return;
    }
    const body = response ? ((await response.json().catch(() => ({}))) as { error?: string; message?: string }) : {};
    if (response?.status === 401) {
      say("");
      show("signed-out");
    } else if (body.error === "not_owned") {
      say("");
      show("not-owned");
    } else if (body.error === "rate_limited") {
      say("Too many tries. Wait a few minutes, then start sign-in again in the game.", "error");
    } else if (body.error === "invalid_code") {
      input.setAttribute("aria-invalid", "true");
      say("That code isn't valid or has expired. Choose Sign in with KalCode in the game to get a new one.", "error");
      input.focus();
    } else {
      say("KalCode couldn't be reached. Check your connection and try again.", "error");
    }
  });

  (async () => {
    show("checking");
    const response = await api("/v1/account");
    if (response?.status === 401) {
      show("signed-out");
      return;
    }
    if (!response?.ok) {
      show("signed-out");
      say("KalCode couldn't be reached. Check your connection and try again.", "error");
      return;
    }
    const body = (await response.json()) as { account?: { email?: string } };
    if (emailOutput && body.account?.email) emailOutput.textContent = body.account.email;
    try {
      localStorage.removeItem(GAMES_RETURN_KEY);
    } catch {
      // Nothing stored.
    }
    show("form");
    input?.focus();
  })();
</script>

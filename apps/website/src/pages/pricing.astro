---
import Backdrop from "../components/Backdrop.astro";
import {
  ALL_PERMISSION_MODES,
  PLANS,
  type PlanLimits,
  formatInterval,
  formatKalVoiceAllowance,
  formatPrice,
} from "@kalcode/protocol/plans";
import Closing from "../components/Closing.astro";
import Icon from "../components/Icon.astro";
import PageHead from "../components/PageHead.astro";
import Base from "../layouts/Base.astro";
import { getPage, planSummary } from "../lib/site";

const page = getPage("/pricing");
// Paid plans open with the same strict build flag as the account page's checkout buttons
// (docs/BILLING.md §9); closed, the page reads exactly as before.
const checkoutOpen = import.meta.env.PUBLIC_CHECKOUT_ENABLED === "true";

/** The plan most people should pick; drawn with an accent rule, never as a purchase button. */
const FEATURED = "pro";

/** KalVoice Requests on a log scale from the smallest to the largest allowance. */
const allowances = PLANS.map((plan) => plan.limits.kalvoiceRequestsPerMonth ?? 0);
const logMin = Math.log10(Math.min(...allowances.filter((value) => value > 0)));
const logMax = Math.log10(Math.max(...allowances));
const meterWidth = (limits: PlanLimits) => {
  const value = limits.kalvoiceRequestsPerMonth;
  if (value === null) return 100;
  return Math.max(6, Math.round(((Math.log10(value) - logMin) / (logMax - logMin)) * 94 + 6));
};

/**
 * The ladder lists only what differs between plans in the Stable app: KalVoice Requests. Persistent
 * agents, pair and team workflows, automations and advanced missions are Gated on Stable 0.1.6
 * (crates/native-core/src/flags.rs), so the ladder does not list them. Nor does it list threads
 * running at once: B9 536efd7 enforces no per-plan thread limit (the catalog's concurrentThreads
 * has no consumer outside crates/entitlements), and the Resource Governor's Balanced mode caps
 * every plan alike (crates/resources/src/mode.rs max_agents).
 */

// "Every plan includes" is stated once instead of repeated per column, so check it is true.
for (const plan of PLANS) {
  const everything =
    plan.limits.providerConnections === "unlimited" &&
    plan.limits.kalvoiceDictation === "unlimited" &&
    ALL_PERMISSION_MODES.every((mode) => plan.limits.permissionModes.includes(mode));
  if (!everything) throw new Error(`pricing: ${plan.name} no longer includes every provider, mode and dictation`);
}

const everyPlan = [
  "All providers",
  "Plan, Approve and Auto modes",
  "Unlimited on-device dictation",
  "Dashboard and workspaces",
  "Your own AI account",
];

const faq = [
  {
    q: "What is a KalVoice Request?",
    a: "One top-level request to KalVoice in command mode, however many steps it takes. “Open a terminal” is one request. “Pause every active thread” is also one request, however many threads it pauses.",
  },
  {
    q: "Does dictation count?",
    a: "No. KalVoice dictation runs on your device and is unlimited on every plan. It is never counted as a KalVoice Request.",
  },
  {
    q: "Do I pay for AI usage through KalCode?",
    a: "No. Claude Code and Codex run on your own provider accounts, and your usage is billed by each provider, as it is today. KalCode never charges for, resells or meters provider usage.",
  },
  {
    q: "What happens when I reach my limit?",
    a: "Dictation and everything else in KalCode keep working. KalVoice command requests pause until your monthly allowance resets or you change plans.",
  },
  {
    q: "Are permission modes limited by plan?",
    a: "No. Permission modes are safety controls, never a paid extra. In 0.1.6, threads run in Plan, Approve or Auto on every plan; Bypass and Custom are planned.",
  },
  checkoutOpen
    ? {
        q: "How do I buy a plan?",
        a: "Sign in on your account page and choose Pro, MAX or MAX 2X. Checkout opens on Stripe's hosted page. Plans renew monthly until you cancel them from Manage billing.",
      }
    : {
        q: "When can I buy a plan?",
        a: "At launch. Billing is not open yet. Early-access members hear first when plans open.",
      },
  {
    q: "What do the plans include?",
    a: "The prices and monthly KalVoice Request allowances shown here are the current plan catalog. Provider connections and local dictation remain unlimited on every plan.",
  },
  {
    q: "Do I need an account to join early access?",
    a: "No. Early access only needs an email address. KalCode accounts arrive with the paid plans at launch.",
  },
];
---
<Base title={page.title} description={page.description} path={page.path} world>
  <PageHead
    backdrop="nebula"
    title="Pricing"
    lead="Every plan runs every provider in Plan, Approve and Auto modes. Plans differ in KalVoice Requests — your AI usage stays on your own account."
    status={checkoutOpen ? "Paid plans are open · subscribe from your account" : "Plans open at launch · nothing is for sale today"}
  />

  <section class="world-section" aria-labelledby="plans-title">
    <Backdrop variant="deep" />
    <div class="container">
      <h2 id="plans-title" class="visually-hidden">Plans</h2>
      <div class="includes">
        <p class="includes__label">Every plan includes</p>
        <ul class="chips" role="list">
          {everyPlan.map((item) => <li class="chip chip--built">{item}</li>)}
        </ul>
      </div>

      <div class="ladder-wrap" role="region" aria-label="Plan comparison" tabindex="0">
        <table class="ladder">
          <caption class="visually-hidden">Plans, prices and monthly KalVoice Request allowances</caption>
          <thead>
            <tr>
              <td></td>
              {
                PLANS.map((plan) => (
                  <th scope="col" class:list={{ "ladder__col--featured": plan.id === FEATURED }}>
                    <div class="ladder__plan">
                      <span class="ladder__name">
                        {plan.name}
                        {plan.id === FEATURED && <span class="ladder__tag">Recommended</span>}
                      </span>
                      <span class="ladder__price">
                        {formatPrice(plan.price)}
                        <small>{formatInterval(plan.price)}</small>
                      </span>
                      <span class="ladder__summary">{planSummary(plan)}</span>
                    </div>
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            <tr class="ladder__row--key">
              <th scope="row">KalVoice Requests a month</th>
              {
                PLANS.map((plan) => (
                  <td class:list={{ "ladder__col--featured": plan.id === FEATURED }}>
                    <div class="ladder__value">
                      <strong>{formatKalVoiceAllowance(plan.limits)}</strong>
                      <svg class="meter" viewBox="0 0 100 6" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                        <rect class="meter__track" width="100" height="6" rx="3" />
                        <rect class="meter__fill" width={meterWidth(plan.limits)} height="6" rx="3" />
                      </svg>
                    </div>
                  </td>
                ))
              }
            </tr>
          </tbody>
        </table>
      </div>
      <p class="section-foot">
        <span>Local dictation is unlimited. Provider inference stays on your connected provider account.</span>
        <a class="text-link" href="/docs/kalvoice">How KalVoice Requests are counted <Icon name="arrow-right" /></a>{checkoutOpen && <a class="text-link" href="/account">Choose a plan in your account <Icon name="arrow-right" /></a>}
      </p>
    </div>
  </section>

  <section class="world-section" aria-labelledby="faq-title">
    <Backdrop variant="deep" />
    <div class="container feature-split feature-split--top">
      <div class="feature-split__copy">
        <h2 id="faq-title" class="h2 h2--sm">Questions</h2>
      </div>
      <div class="faq">
        {
          faq.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p class="faq__answer">{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <Closing title={checkoutOpen ? "Start on Free. Upgrade any time." : "Hear first when plans open."} />
</Base>

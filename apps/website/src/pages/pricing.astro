---
import {
  ALL_PERMISSION_MODES,
  PLANS,
  type PlanLimits,
  formatInterval,
  formatKalVoiceAllowance,
  formatPrice,
} from "@kalcode/protocol/plans";
import EarlyAccessForm from "../components/EarlyAccessForm.astro";
import Icon from "../components/Icon.astro";
import PageHead from "../components/PageHead.astro";
import Base from "../layouts/Base.astro";
import { getPage } from "../lib/site";

const page = getPage("/pricing");

const yesNo = (value: boolean) => (value ? "Included" : "—");
const automations: Record<PlanLimits["automations"], string> = {
  none: "—",
  scheduled: "Scheduled",
  scheduled_and_event: "Scheduled and event-triggered",
};
const capitalize = (word: string) => word.charAt(0).toUpperCase() + word.slice(1);
const modeNames = ALL_PERMISSION_MODES.map(capitalize).join(", ");

const rows: { label: string; value: (limits: PlanLimits) => string }[] = [
  { label: "KalVoice Requests / month", value: (l) => formatKalVoiceAllowance(l) },
  { label: "Local KalVoice dictation", value: (l) => (l.kalvoiceDictation === "unlimited" ? "Unlimited" : "—") },
  { label: "Provider connections", value: (l) => (l.providerConnections === "unlimited" ? "All" : "—") },
  {
    label: `Permission modes (${modeNames})`,
    value: (l) => (ALL_PERMISSION_MODES.every((mode) => l.permissionModes.includes(mode)) ? "All" : "—"),
  },
  {
    label: "Threads running at once",
    value: (l) => (l.concurrentThreads === null ? "Unlimited" : String(l.concurrentThreads)),
  },
  { label: "Persistent agents", value: (l) => yesNo(l.persistentAgents) },
  { label: "Pair and team workflows", value: (l) => yesNo(l.multiAgentWorkflows) },
  { label: "Automations", value: (l) => automations[l.automations] },
  { label: "Advanced missions with verification", value: (l) => yesNo(l.advancedMissions) },
];
---
<Base title={page.title} description={page.description} path={page.path}>
  <PageHead
    title="Pricing"
    lead="Three plans. Your AI providers connect free on every one of them, and your AI usage stays on your own provider account."
    devNote="Plans become available when KalCode launches. Nothing is for sale today."
  />

  <section class="section" aria-labelledby="plans-title">
    <div class="container">
      <h2 id="plans-title" class="visually-hidden">Plans</h2>
      <div class="plans">
        {
          PLANS.map((plan) => (
            <section class="plan" aria-labelledby={`plan-${plan.id}`}>
              <h3 class="plan__name" id={`plan-${plan.id}`}>{plan.name}</h3>
              <p class="plan__price">
                <span class="plan__amount">{formatPrice(plan.price)}</span>
                <span class="plan__interval">{formatInterval(plan.price)}</span>
              </p>
              <p class="plan__summary">{plan.summary}</p>
              <ul class="plan__highlights" role="list">
                {plan.highlights.map((line) => (
                  <li>
                    <Icon name="check" />
                    <span>{line}</span>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="compare-title">
    <div class="container">
      <div class="section-head">
        <h2 id="compare-title" class="h2">Compare plans.</h2>
        <p>
          These are the planned limits. They are provisional and may change before launch; the plan
          catalog on this page is built from the same configuration KalCode itself uses. KalVoice is
          in development, so its allowances apply once it ships.
        </p>
      </div>
      <div class="table-wrap" role="region" aria-label="Plan comparison" tabindex="0">
        <table class="table">
          <caption class="visually-hidden">Planned limits by plan (provisional)</caption>
          <thead>
            <tr>
              <th scope="col">Feature</th>
              {PLANS.map((plan) => <th scope="col">{plan.name}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              rows.map((row) => (
                <tr>
                  <th scope="row">{row.label}</th>
                  {PLANS.map((plan) => (
                    <td>{row.value(plan.limits)}</td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="container split">
      <div class="split__aside section-head">
        <h2 id="faq-title" class="h2">Questions.</h2>
      </div>
      <dl class="definition-list">
        <div>
          <dt class="h3">What is a KalVoice Request?</dt>
          <dd>
            One top-level request to KalVoice in command mode, however many steps it takes. “Open
            four Codex threads” is one request. “Have Claude implement this, Codex review it, then
            run the tests” is also one request.
          </dd>
        </div>
        <div>
          <dt class="h3">Does dictation count?</dt>
          <dd>
            No. KalVoice dictation runs on your device and is unlimited on every plan. It is never
            counted as a KalVoice Request.
          </dd>
        </div>
        <div>
          <dt class="h3">Do I pay for AI usage through KalCode?</dt>
          <dd>
            No. Claude Code, Codex and Gemini CLI run on your own provider accounts, and your usage
            is billed by each provider, as it is today. KalCode never charges for, resells or meters
            provider usage.
          </dd>
        </div>
        <div>
          <dt class="h3">What happens when I reach my limit?</dt>
          <dd>
            Dictation and everything else in KalCode keep working. KalVoice command requests pause
            until your monthly allowance resets or you upgrade.
          </dd>
        </div>
        <div>
          <dt class="h3">Are permission modes limited by plan?</dt>
          <dd>
            No. Plan, Approve, Auto, Bypass and Custom are safety controls, and every plan includes
            all of them.
          </dd>
        </div>
        <div>
          <dt class="h3">When can I buy a plan?</dt>
          <dd>
            At launch. KalCode is in private development and there is no billing yet. Early-access
            members will hear first when plans open.
          </dd>
        </div>
        <div>
          <dt class="h3">Are these limits final?</dt>
          <dd>
            No. Prices are set, but the limits in the comparison table are provisional and may change
            before launch.
          </dd>
        </div>
        <div>
          <dt class="h3">Do I need an account to join early access?</dt>
          <dd>
            No. Early access only needs an email address. KalCode accounts arrive with the paid
            plans at launch.
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section" id="early-access" aria-labelledby="early-access-title">
    <div class="container signup">
      <div class="section-head">
        <h2 id="early-access-title" class="h2">Hear when plans open.</h2>
        <p>Join early access and we'll email you when there is a build to try.</p>
      </div>
      <EarlyAccessForm source="/pricing" />
    </div>
  </section>
</Base>

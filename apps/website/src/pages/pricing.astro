---
import {
  CORE_LIMITS,
  type PlanFeature,
  PLAN_FEATURE_GROUPS,
  PLANS,
  UNLIMITED_NOTE,
  formatCoreLimit,
  formatInterval,
  formatLimit,
  formatPrice,
  getPlanFeature,
  planIncludes,
  yearlySavingsUsd,
} from "@kalcode/protocol/plans";
import Backdrop from "../components/Backdrop.astro";
import Closing from "../components/Closing.astro";
import Icon from "../components/Icon.astro";
import IntervalToggle from "../components/IntervalToggle.astro";
import PageHead from "../components/PageHead.astro";
import Base from "../layouts/Base.astro";
import { checkoutIntentHref } from "../lib/checkout-intent";
import { RELEASES, releaseCopy } from "../lib/releases";
import { getPage } from "../lib/site";

const page = getPage("/pricing");
// Paid plans open with the same strict build flag as the account page's checkout (docs/BILLING.md
// §9). Either way CHECK OUT NOW goes account-first; /account says when paid plans are not open.
const checkoutOpen = import.meta.env.PUBLIC_CHECKOUT_ENABLED === "true";

// Every price, limit, plan name and feature state below comes from @kalcode/protocol/plans.
const usd = (value: number) => `$${value.toLocaleString("en-US")}`;
const paidPlans = PLANS.filter((plan) => plan.price.monthlyUsd > 0);
const bestSaving = usd(Math.max(...PLANS.map(yearlySavingsUsd)));
const savingsList = paidPlans.map((plan) => `${plan.name} ${usd(yearlySavingsUsd(plan))}`).join(", ");

const limitValue = (plan: (typeof PLANS)[number], limit: (typeof CORE_LIMITS)[number]) =>
  plan.limits[limit.key] as number | null;

/** "1 agent" → ["1", "agent"]: the number is set large, the unit small. */
const splitLimit = (text: string) => {
  const space = text.indexOf(" ");
  return [text.slice(0, space), text.slice(space + 1)] as const;
};

const featureCell = (feature: PlanFeature, planId: (typeof PLANS)[number]["id"]) => {
  if (!planIncludes(planId, feature)) return { kind: "none" as const };
  const value = feature.values?.[planId];
  return value ? { kind: "value" as const, value } : { kind: "check" as const };
};

const faq = [
  {
    q: "What is a KalVoice Request?",
    a: "Each KalVoice command that KalCode carries out counts once, however many steps it takes. “Open a terminal” is one request. “Pause every active thread” is also one request, however many threads it pauses.",
  },
  {
    q: "Does dictation count?",
    a: "No. Dictation and voice into terminals run on your device, are unlimited on every plan and are never counted as KalVoice Requests.",
  },
  {
    q: "How does yearly billing work?",
    a: `You pay once a year instead of every month, and it costs less than twelve monthly payments: ${savingsList} a year. A yearly plan renews each year until you cancel it.`,
  },
  {
    q: "What happens when I reach a limit?",
    a: "Nothing you already have open is closed. KalCode never closes open terminals, workspaces, provider accounts or running agents; it only declines to open one more past your plan's limit. KalVoice commands pause until your monthly allowance resets, and dictation keeps working.",
  },
  {
    q: "What does “Coming soon” mean?",
    a: "The feature is assigned to that plan but is not available yet. It arrives in a normal KalCode update for everyone on that plan. Everything marked available works in KalCode today.",
  },
  {
    q: "Do I pay for AI usage through KalCode?",
    a: "No. Claude Code and Codex run on your own provider accounts, and your usage is billed by each provider, as it is today. KalCode never charges for, resells or meters provider usage.",
  },
  {
    q: "Are permission modes limited by plan?",
    a: releaseCopy(
      "No. Permission modes are safety controls, never a paid extra. In 0.1.6, threads run in Plan, Approve or Auto on every plan; Bypass and Custom are planned.",
      RELEASES,
    ),
  },
  checkoutOpen
    ? {
        q: "How do I buy a plan?",
        a: "Pick monthly or yearly and press CHECK OUT NOW on a plan. Sign in or create your KalCode account, and KalCode continues straight to Stripe's hosted checkout for that plan. Cancel any time from Manage billing on your account page.",
      }
    : {
        q: "When can I buy a plan?",
        a: "Paid plans open soon. You can create your KalCode account and start on Free today.",
      },
];
---
<Base title={page.title} description={page.description} path={page.path} world>
  <PageHead
    backdrop="nebula"
    title="Pricing"
    lead="Start free. Upgrade for more agents, more terminals and more autonomy. Your AI usage stays on your own provider account."
    status={checkoutOpen ? "Paid plans are open · monthly or yearly" : "Paid plans open soon · start on Free today"}
  />

  <section class="world-section pricing" aria-labelledby="plans-title" data-pricing>
    <Backdrop variant="deep" />
    <div class="container container--wide">
      <h2 id="plans-title" class="visually-hidden">Plans</h2>
      <div class="pricing__bar">
        <IntervalToggle note={`Save up to ${bestSaving}`} />
        <p class="pricing__legend">
          <span class="state state--available"><span class="state__mark"><Icon name="check" /></span> Available now</span>
          <span class="state state--soon"><span class="state__mark"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="7" /></svg></span> Coming soon</span>
        </p>
      </div>

      <ul class="tiers" role="list">
        {
          PLANS.map((plan, index) => {
            const previous = index > 0 ? PLANS[index - 1] : null;
            const saving = yearlySavingsUsd(plan);
            return (
              <li class:list={["tier", { "tier--popular": plan.popular }]} id={`plan-${plan.id}`} data-plan={plan.id}>
                <div class="tier__head">
                  <p class="tier__stage">{plan.stage}</p>
                  {plan.popular && <p class="tier__badge">Most popular</p>}
                </div>
                <h3 class="tier__name">{plan.name}</h3>
                <p class="tier__tagline">{plan.tagline}</p>
                <p class="tier__price">
                  <span data-show="month">
                    {formatPrice(plan, "month")}<small>{formatInterval("month")}</small>
                  </span>
                  <span data-show="year" hidden>
                    {formatPrice(plan, "year")}<small>{formatInterval("year")}</small>
                  </span>
                </p>
                <p class="tier__saving">
                  {saving > 0 ? (
                    <>
                      <span data-show="month">
                        or {formatPrice(plan, "year")}{formatInterval("year")} · save {usd(saving)}
                      </span>
                      <span data-show="year" hidden class="tier__saving--on">
                        You save {usd(saving)} a year
                      </span>
                    </>
                  ) : (
                    <span>No payment details needed</span>
                  )}
                </p>
                <a
                  class:list={["button", "button--primary", "tier__cta", { "tier__cta--popular": plan.popular }]}
                  href={checkoutIntentHref(plan.id, "month")}
                  data-checkout-plan={plan.id}
                >
                  CHECK OUT NOW<span class="visually-hidden"> with {plan.name}</span>
                </a>

                <ul class="tier__limits" role="list" aria-label={`${plan.name} limits`}>
                  {CORE_LIMITS.map((limit) => {
                    const [amount, unit] = splitLimit(formatCoreLimit(plan.limits, limit));
                    return (
                      <li data-limit={limit.key}>
                        <strong>{amount}</strong> {unit}
                        {limitValue(plan, limit) === null && (
                          <sup class="fn" aria-hidden="true">
                            *
                          </sup>
                        )}
                      </li>
                    );
                  })}
                  {plan.stage === "AUTOMATE" && <li class="tier__extra">Maximum autonomy</li>}
                </ul>

                <p class="tier__includes">{previous ? `Everything in ${previous.name}, plus` : "Includes"}</p>
                {[
                  { status: "available", heading: null },
                  { status: "coming_soon", heading: "Coming soon" },
                ].map(({ status, heading }) => {
                  const features = plan.cardFeatures.map(getPlanFeature).filter((feature) => feature.status === status);
                  if (features.length === 0) return null;
                  return (
                    <>
                      {heading && <p class="tier__soon-head">{heading}</p>}
                      <ul class:list={["tier__features", `tier__features--${status}`]} role="list">
                        {features.map((feature) => {
                          const value = feature.values?.[plan.id];
                          return (
                            <li class:list={["feat", `feat--${feature.status}`]} data-status={feature.status}>
                              <span class="feat__mark" aria-hidden="true">
                                {feature.status === "available" ? (
                                  <Icon name="check" />
                                ) : (
                                  <svg viewBox="0 0 24 24" focusable="false">
                                    <circle cx="12" cy="12" r="7" />
                                  </svg>
                                )}
                              </span>
                              <span class="feat__text">
                                {feature.label}
                                {value && <span class="feat__value"> · {value}</span>}
                                <span class="visually-hidden">
                                  {feature.status === "available" ? " (available now)" : " (coming soon)"}
                                </span>
                              </span>
                            </li>
                          );
                        })}
                      </ul>
                    </>
                  );
                })}
              </li>
            );
          })
        }
      </ul>

      <div class="pricing__notes">
        <p class="pricing__footnote" id="unlimited-note"><span aria-hidden="true">* </span>{UNLIMITED_NOTE}</p>
        <div class="includes">
          <p class="includes__label">Every plan includes</p>
          <ul class="chips" role="list">
            <li class="chip chip--built">Your own provider accounts</li>
            <li class="chip chip--built">Plan, Approve and Auto modes</li>
            <li class="chip chip--built">Unlimited on-device dictation</li>
            <li class="chip chip--built">Security fixes and updates</li>
          </ul>
        </div>
      </div>

      <details class="compare" id="compare">
        <summary class="compare__summary">
          <span class="compare__title">Compare all features</span>
          <span class="compare__hint">Every limit and every roadmap feature, plan by plan</span>
        </summary>
        <div class="compare__wrap" role="region" aria-label="Plan comparison" tabindex="0">
          <table class="compare__table">
            <caption class="visually-hidden">Limits and features by plan</caption>
            <thead>
              <tr>
                <td></td>
                {
                  PLANS.map((plan) => (
                    <th scope="col" class:list={{ "is-popular": plan.popular }}>
                      <span class="compare__plan">{plan.name}</span>
                      <span class="compare__price">
                        <span data-show="month">
                          {formatPrice(plan, "month")}
                          {formatInterval("month")}
                        </span>
                        <span data-show="year" hidden>
                          {formatPrice(plan, "year")}
                          {formatInterval("year")}
                        </span>
                      </span>
                    </th>
                  ))
                }
              </tr>
            </thead>
            <tbody>
              <tr class="compare__group">
                <th scope="colgroup" colspan={PLANS.length + 1}>Limits</th>
              </tr>
              {
                CORE_LIMITS.map((limit) => (
                  <tr>
                    <th scope="row">{limit.label}</th>
                    {PLANS.map((plan) => (
                      <td class:list={{ "is-popular": plan.popular }}>
                        <span class="compare__value">{formatLimit(limitValue(plan, limit))}</span>
                        {limitValue(plan, limit) === null && (
                          <sup class="fn" aria-hidden="true">
                            *
                          </sup>
                        )}
                      </td>
                    ))}
                  </tr>
                ))
              }
            </tbody>
            {
              PLAN_FEATURE_GROUPS.map((group) => (
                <tbody>
                  <tr class="compare__group">
                    <th scope="colgroup" colspan={PLANS.length + 1}>
                      {group.title}
                    </th>
                  </tr>
                  {group.features.map((feature) => (
                    <tr data-feature={feature.id} data-status={feature.status}>
                      <th scope="row">
                        <span class="compare__label">
                          {feature.label}
                          {feature.status === "coming_soon" && <span class="soon">Coming soon</span>}
                        </span>
                        {feature.detail && <span class="compare__detail">{feature.detail}</span>}
                      </th>
                      {PLANS.map((plan) => {
                        const cell = featureCell(feature, plan.id);
                        return (
                          <td class:list={{ "is-popular": plan.popular }}>
                            {cell.kind === "value" && <span class="compare__value">{cell.value}</span>}
                            {cell.kind === "check" && (
                              <span class="compare__check">
                                <Icon name="check" />
                                <span class="visually-hidden">Included</span>
                              </span>
                            )}
                            {cell.kind === "none" && (
                              <span class="compare__none">
                                <span aria-hidden="true">—</span>
                                <span class="visually-hidden">Not included</span>
                              </span>
                            )}
                          </td>
                        );
                      })}
                    </tr>
                  ))}
                </tbody>
              ))
            }
          </table>
        </div>
      </details>

      <p class="section-foot">
        <span>Local dictation is unlimited. Provider inference stays on your connected provider account.</span>
        <a class="text-link" href="/docs/kalvoice">How KalVoice Requests are counted <Icon name="arrow-right" /></a>
      </p>
    </div>
  </section>

  <section class="world-section" aria-labelledby="faq-title">
    <Backdrop variant="deep" />
    <div class="container feature-split feature-split--top">
      <div class="feature-split__copy">
        <h2 id="faq-title" class="h2 h2--sm">Questions</h2>
      </div>
      <div class="faq">
        {
          faq.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p class="faq__answer">{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <Closing title={checkoutOpen ? "Start on Free. Upgrade any time." : "Hear first when plans open."} />
</Base>

<style>
  .pricing__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4) var(--space-8);
    margin-bottom: clamp(1.75rem, 1.25rem + 1.5vw, 2.75rem);
  }

  .pricing__legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    color: var(--color-text-muted);
    font-size: var(--site-text-xs);
  }

  .state {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .state {
    white-space: nowrap;
  }

  .state__mark,
  .feat__mark {
    display: inline-flex;
    width: 1rem;
    height: 1rem;
    flex: none;
  }

  .state__mark :global(svg),
  .feat__mark :global(svg) {
    width: 100%;
    height: 100%;
  }

  .state--available .state__mark,
  .feat--available .feat__mark {
    color: var(--color-success);
  }

  .state--soon svg,
  .feat--coming_soon .feat__mark svg {
    fill: none;
    stroke: var(--color-text-muted);
    stroke-width: 1.8;
    stroke-dasharray: 3 2.6;
  }

  /* ---------- Plan cards ---------- */

  .tiers {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 44rem) {
    .tiers {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 76rem) {
    .tiers {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-4);
    }
  }

  .tier {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 1.1rem + 0.9vw, 2rem);
    border-radius: var(--world-frame-radius);
    background: linear-gradient(180deg, rgb(12 20 40 / 0.72), rgb(4 7 16 / 0.66));
    box-shadow:
      inset 0 0 0 1px rgb(var(--world-line) / 0.16),
      inset 0 1px 0 rgb(255 255 255 / 0.07),
      0 40px 80px -50px rgb(0 0 0 / 0.95);
  }

  .tier--popular {
    background:
      radial-gradient(120% 55% at 50% 0%, rgb(var(--world-blue) / 0.24), transparent 70%),
      linear-gradient(180deg, rgb(14 26 54 / 0.9), rgb(4 8 18 / 0.8));
    box-shadow:
      inset 0 0 0 1px rgb(var(--world-blue) / 0.6),
      inset 0 1px 0 rgb(255 255 255 / 0.14),
      0 0 60px -14px rgb(var(--world-blue) / 0.6),
      0 40px 80px -50px rgb(0 0 0 / 0.95);
  }

  .tier__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 1.75rem;
  }

  .tier__stage {
    color: var(--color-accent-text);
    font-family: var(--font-wider);
    font-size: var(--type-label);
    font-weight: var(--weight-medium);
    letter-spacing: 0.28em;
  }

  .tier__badge {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    padding: 0.4rem 0.9rem;
    border-radius: var(--radius-full);
    background: linear-gradient(180deg, rgb(var(--world-blue) / 0.95), rgb(58 120 234 / 0.95));
    box-shadow: 0 0 20px -4px rgb(var(--world-blue) / 0.8);
    color: #03060d;
    font-family: var(--font-wider);
    font-size: 0.625rem;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .tier__name {
    margin-top: var(--space-5);
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.5rem + 0.6vw, 2.125rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .tier__tagline {
    min-height: 3em;
    margin-top: var(--space-3);
    color: var(--color-text-secondary);
    font-size: var(--site-text-small);
    line-height: var(--leading-normal);
  }

  .tier__price {
    margin-top: var(--space-5);
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 2.2rem + 1.4vw, 3.5rem);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .tier__price small {
    margin-left: 0.3rem;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--site-text-small);
    font-weight: var(--weight-regular);
    letter-spacing: 0;
  }

  .tier__saving {
    min-height: 1.5em;
    margin-top: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--site-text-xs);
    font-variant-numeric: tabular-nums;
  }

  .tier__saving--on {
    color: var(--color-accent-icy, var(--color-accent-text));
    font-weight: var(--weight-medium);
  }

  .tier__cta {
    width: 100%;
    margin-top: var(--space-6);
    letter-spacing: 0.12em;
  }

  .tier:not(.tier--popular) .tier__cta::before {
    opacity: 0.28;
  }

  .tier__cta--popular::before {
    opacity: 0.9;
  }

  .tier__limits {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid rgb(var(--world-line) / 0.14);
    color: var(--color-text-secondary);
    font-size: var(--site-text-small);
  }

  .tier__limits strong {
    color: var(--color-text);
    font-weight: var(--weight-semibold);
    font-variant-numeric: tabular-nums;
  }

  .tier__extra {
    color: var(--color-accent-icy, var(--color-accent-text));
    font-weight: var(--weight-medium);
  }

  .fn {
    margin-left: 0.1em;
    color: var(--color-accent-text);
    font-size: 0.75em;
  }

  .tier__includes {
    margin-top: var(--space-6);
    color: var(--color-text);
    font-size: var(--site-text-xs);
    font-weight: var(--weight-semibold);
  }

  .tier__features {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-3);
    font-size: var(--site-text-small);
    line-height: 1.4;
  }

  .feat {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    color: var(--color-text);
  }

  .feat__mark {
    margin-top: 0.15em;
  }

  .feat--coming_soon {
    color: var(--color-text-secondary);
  }

  .feat__value {
    color: var(--color-text-muted);
  }

  .tier__soon-head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-5);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .tier__soon-head::after {
    content: "";
    flex: 1;
    height: 1px;
    background: rgb(var(--world-line) / 0.14);
  }

  .tier__includes + .tier__soon-head {
    margin-top: var(--space-3);
  }

  .soon {
    display: inline-block;
    margin-left: var(--space-2);
    padding: 0.0625rem 0.4375rem;
    border-radius: var(--radius-full);
    box-shadow: inset 0 0 0 1px rgb(var(--world-line) / 0.26);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.5;
    vertical-align: 0.1em;
    white-space: nowrap;
  }

  /* ---------- Notes ---------- */

  .pricing__notes {
    display: grid;
    gap: var(--space-6);
    margin-top: clamp(1.75rem, 1.25rem + 1.5vw, 2.5rem);
  }

  .pricing__footnote {
    max-width: 80ch;
    color: var(--color-text-muted);
    font-size: var(--site-text-xs);
  }

  .includes {
    margin-bottom: 0;
  }

  /* ---------- Compare all features ---------- */

  .compare {
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
    border-radius: var(--world-frame-radius);
    background: linear-gradient(180deg, rgb(10 18 36 / 0.6), rgb(4 7 16 / 0.55));
    box-shadow: inset 0 0 0 1px rgb(var(--world-line) / 0.16);
  }

  .compare__summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-1) var(--space-6);
    padding: var(--space-6) clamp(1.25rem, 1rem + 1vw, 2rem);
    border-radius: inherit;
    list-style: none;
    cursor: pointer;
  }

  .compare__summary::-webkit-details-marker {
    display: none;
  }

  .compare__summary::after {
    content: "";
    grid-column: 2;
    grid-row: 1 / span 2;
    width: 0.625rem;
    height: 0.625rem;
    border-right: 1.5px solid var(--color-text-secondary);
    border-bottom: 1.5px solid var(--color-text-secondary);
    transform: translateY(-25%) rotate(45deg);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .compare[open] .compare__summary::after {
    transform: translateY(25%) rotate(-135deg);
  }

  .compare__summary:focus-visible {
    outline: 2px solid var(--color-accent-text);
    outline-offset: 3px;
  }

  .compare__title {
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--type-title);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.02em;
  }

  .compare__summary:hover .compare__title {
    color: var(--color-accent-text);
  }

  .compare__hint {
    grid-column: 1;
    color: var(--color-text-muted);
    font-size: var(--site-text-small);
  }


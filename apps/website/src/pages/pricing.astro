<script>
  import { checkoutIntentHref } from "../lib/checkout-intent";
  import { onIntervalChange } from "../scripts/interval";

  const links = document.querySelectorAll<HTMLAnchorElement>("[data-checkout-plan]");
  onIntervalChange((interval) => {
    for (const link of links) {
      const plan = link.dataset.checkoutPlan;
      if (plan === "free" || plan === "pro" || plan === "max" || plan === "max2x") {
        link.href = checkoutIntentHref(plan, interval);
      }
    }
  });
</script>

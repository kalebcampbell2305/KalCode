# Production build flag (Vite loads this file for `astro build` only; dev and unit tests do not).
# Opens paid checkout on /account and the paid-plan copy on /, /pricing and /terms.
# Only the exact string "true" opens it (docs/BILLING.md section 9). Rollback: set it to false.
# Not a secret. Tracked on purpose despite the root .env.* ignore rule.
PUBLIC_CHECKOUT_ENABLED=true

{
  "name": "@kalcode/desktop",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "KalCode desktop application (Tauri + React).",
  "scripts": {
    "dev": "vite",
    "dev:ui": "vite --mode ui-test",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:ui-test": "vite build --mode ui-test --outDir dist-ui-test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:ui": "playwright test --config tests/ui/playwright.config.ts",
    "test:ui:functional": "playwright test --config tests/ui/playwright.config.ts --fail-on-flaky-tests --grep-invert \"@(?:screenshots|dashboard-shots|layout-shots|w1-shots|w2-shots)\"",
    "test:ui:visual-ci": "playwright test --config tests/ui/playwright.config.ts --fail-on-flaky-tests --grep \"@(?:dashboard-shots|layout-shots|w1-shots|w2-shots)\" --grep-invert \"@screenshots\"",
    "test:ui:widgets": "playwright test --config tests/widgets/playwright.config.ts",
    "build:e2e": "node scripts/build-e2e.mjs",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@kalcode/protocol": "workspace:*",
    "@kalcode/ui": "workspace:*",
    "@tauri-apps/api": "2.11.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "cmdk": "1.1.1",
    "lucide-react": "1.48.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.11.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  }
}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Least-privilege capability for the KalCode main window: KalCode's own commands, event plumbing, and theme sync. No filesystem, shell, HTTP, or opener access from the WebView.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:window:allow-set-theme",
    "allow-boot",
    "allow-window-ready",
    "allow-settings-get",
    "allow-settings-update",
    "allow-events-recent",
    "allow-events-subscribe",
    "allow-events-unsubscribe",
    "allow-diagnostics-get",
    "allow-diagnostics-open-log-dir",
    "allow-diagnostics-open-data-dir",
    "allow-secure-store-check",
    "allow-kalvoice-subscribe",
    "allow-kalvoice-status",
    "allow-kalvoice-request",
    "allow-kalvoice-preferences-update",
    "allow-kalvoice-listen-start",
    "allow-kalvoice-listen-stop",
    "allow-kalvoice-listen-cancel",
    "allow-kalvoice-model-download",
    "allow-kalvoice-model-cancel",
    "allow-kalvoice-model-delete",
    "allow-kalvoice-talk",
    "allow-kalvoice-type-instead",
    "allow-kalvoice-latency",
    "allow-kalvoice-latency-record",
    "allow-providers-list",
    "allow-providers-detect"
  ]
}

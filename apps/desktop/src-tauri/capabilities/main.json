{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Least-privilege capability for the KalCode main window: KalCode's own commands, event plumbing, and theme sync. No filesystem, shell, HTTP, or opener access from the WebView.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:window:allow-set-theme",
    "allow-boot",
    "allow-window-ready",
    "allow-settings-get",
    "allow-settings-update",
    "allow-events-recent",
    "allow-events-query",
    "allow-events-subscribe",
    "allow-events-unsubscribe",
    "allow-diagnostics-get",
    "allow-diagnostics-open-log-dir",
    "allow-diagnostics-open-data-dir",
    "allow-secure-store-check",
    "allow-kalvoice-subscribe",
    "allow-kalvoice-status",
    "allow-kalvoice-request",
    "allow-kalvoice-preferences-update",
    "allow-kalvoice-listen-start",
    "allow-kalvoice-listen-stop",
    "allow-kalvoice-listen-cancel",
    "allow-kalvoice-model-download",
    "allow-kalvoice-model-cancel",
    "allow-kalvoice-model-delete",
    "allow-kalvoice-talk",
    "allow-kalvoice-type-instead",
    "allow-kalvoice-confirm",
    "allow-kalvoice-latency",
    "allow-kalvoice-latency-record",
    "allow-providers-list",
    "allow-providers-detect",
    "allow-workspace-list",
    "allow-workspace-active",
    "allow-workspace-open-dialog",
    "allow-workspace-activate",
    "allow-workspace-remove",
    "allow-shells-list",
    "allow-terminal-list",
    "allow-terminal-create",
    "allow-terminal-restart",
    "allow-terminal-close",
    "allow-terminal-write",
    "allow-terminal-resize",
    "allow-terminal-attach",
    "allow-terminal-detach",
    "allow-terminal-ack",
    "allow-terminal-set-active",
    "allow-terminals-running",
    "allow-thread-list",
    "allow-thread-get",
    "allow-thread-messages",
    "allow-thread-tool-calls",
    "allow-thread-options",
    "allow-thread-create",
    "allow-thread-send",
    "allow-thread-interrupt",
    "allow-thread-resume",
    "allow-thread-stop",
    "allow-thread-rename",
    "allow-thread-archive",
    "allow-thread-stream",
    "allow-approval-list",
    "allow-approval-decide",
    "allow-permission-profiles-list",
    "allow-thread-set-permission-mode",
    "allow-permission-settings-get",
    "allow-permission-settings-update"
  ]
}

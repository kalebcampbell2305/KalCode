{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KalCode",
  "mainBinaryName": "kalcode",
  "version": "0.1.2",
  "identifier": "com.kalcode.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "KalCode",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "visible": false,
        "backgroundColor": "#05080f"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "KalCode",
    "copyright": "© 2026 KalCode",
    "category": "DeveloperTool",
    "shortDescription": "One intelligence that operates your entire AI workspace.",
    "longDescription": "KalCode connects the AI coding providers you already use, runs them in real workspaces, keeps you in control of permissions, and lets KalVoice turn your voice into prompts and KalCode commands.",
    "homepage": "https://kalcoded.com",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}

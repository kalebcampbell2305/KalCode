      "expect": [{ "kind": "control_browser", "command": { "kind": "open", "newPane": false } }]
    },
    {
      "id": "h027",
      "cat": "paraphrase",
      "text": "Reload the browser page",
      "expect": [{ "kind": "control_browser", "command": { "kind": "reload" } }]
    },
    {
      "id": "h028",
      "cat": "paraphrase",
      "text": "Switch over to Gemini",
      "expect": [{ "kind": "switch_provider", "providerId": "gemini-cli" }]
    },
    {
      "id": "h029",
      "cat": "paraphrase",
      "text": "Which threads are finished?",
      "expect": [{ "kind": "filter_dashboard", "chip": "done" }]
    },
    {
      "id": "h030",
      "cat": "paraphrase",
      "text": "Uh, show me the dashboard",
      "expect": [{ "kind": "navigate", "surface": "dashboard" }]
    },
    {
      "id": "h031",
      "cat": "asr",
      "text": "Open to cloud threads",
      "expect": [{ "kind": "create_threads", "providerId": "claude-code", "count": 2 }]
    },
    {
      "id": "h032",
      "cat": "asr",
      "text": "Um so pause all the agents",
      "expect": [{ "kind": "pause_threads", "scope": { "kind": "all" } }]
    },
    {
      "id": "h033",
      "cat": "asr",
      "text": "Go to the dash board please",
      "expect": [{ "kind": "navigate", "surface": "dashboard" }]
    },
    {
      "id": "h034",
      "cat": "asr",
      "text": "Open local host 8080",
      "expect": [{ "kind": "control_browser", "command": { "kind": "navigate", "url": "http://localhost:8080/" } }]
    },
    {
      "id": "h035",
      "cat": "reference",
      "text": "Put me in the docs workspace",
      "expect": [{ "kind": "open_workspace", "_target": { "workspace": "docs" } }]
    },
    {
      "id": "h036",
      "cat": "reference",
      "text": "Stop the flaky tests thread",
      "expect": [{ "kind": "stop_threads", "scope": { "kind": "thread" }, "_target": { "thread": "fix flaky tests" } }]
    },
    {
      "id": "h037",
      "cat": "reference",
      "text": "Pause the Gemini thread",
      "expect": [
        "clarify",
        { "kind": "pause_threads", "scope": { "kind": "thread" }, "_target": { "thread": "checkout" } }
      ]
    },
    { "id": "h038", "cat": "ambiguous", "text": "Stop the kalcode thread", "expect": ["clarify"] },
    { "id": "h039", "cat": "ambiguous", "text": "Pause that one", "expect": ["clarify"] },
    { "id": "h040", "cat": "ambiguous", "text": "Resume the Claude thread", "expect": ["clarify"] },
    { "id": "h041", "cat": "negative", "text": "Don't take me to settings", "expect": ["none"] },
    {
      "id": "h042",
      "cat": "negative",
      "text": "Take me to settings and stop all threads",
      "expect": ["none", "clarify"]
    },
    {
      "id": "h043",
      "cat": "negative",
      "text": "Freeze all the threads unless they're almost done",
      "expect": ["none"]
    },
    { "id": "h044", "cat": "negative", "text": "The dashboard is waiting for me to fix the chart", "expect": ["none"] },
    { "id": "h045", "cat": "negative", "text": "I need to stop all the threads before the demo", "expect": ["none"] },
    { "id": "h046", "cat": "negative", "text": "Where is the bug in the settings page", "expect": ["none"] },
    { "id": "h047", "cat": "negative", "text": "Put me in touch with the Codex team", "expect": ["none"] },
    { "id": "h048", "cat": "negative", "text": "Make me a function that pauses all threads", "expect": ["none"] },
    { "id": "h049", "cat": "negative", "text": "Back to the drawing board", "expect": ["none"] },
    { "id": "h050", "cat": "negative", "text": "Keep going with the refactor in the auth module", "expect": ["none"] },
    { "id": "h051", "cat": "negative", "text": "I need you to explain why the tests are failing", "expect": ["none"] },
    { "id": "h052", "cat": "negative", "text": "Freeze the dependency versions in package json", "expect": ["none"] },
    { "id": "h053", "cat": "negative", "text": "Get rid of the unused imports", "expect": ["none"] },
    {
      "id": "h054",
      "cat": "negative",
      "text": "Return to the previous implementation of the parser",
      "expect": ["none"]
    },
    { "id": "h055", "cat": "negative", "text": "Head over to the docs and update the readme", "expect": ["none"] }

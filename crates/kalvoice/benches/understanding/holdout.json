{
  "$comment": "Holdout set written after the proposed 0.1.5 normalization rules, to estimate how well they generalize beyond corpus.json. Same schema as corpus.json; uses corpus.json's fixture world. Includes negatives to check that rewrites never create unsafe executions.",
  "cases": [
    {
      "id": "h001",
      "cat": "paraphrase",
      "text": "Could you bring me back to the settings page?",
      "expect": [{ "kind": "navigate", "surface": "settings" }]
    },
    {
      "id": "h002",
      "cat": "paraphrase",
      "text": "Take me over to the providers screen",
      "expect": [{ "kind": "navigate", "surface": "providers" }]
    },
    {
      "id": "h003",
      "cat": "paraphrase",
      "text": "I want to go to settings",
      "expect": [{ "kind": "navigate", "surface": "settings" }]
    },
    {
      "id": "h004",
      "cat": "paraphrase",
      "text": "Get me back to the dashboard",
      "expect": [{ "kind": "navigate", "surface": "dashboard" }]
    },
    {
      "id": "h005",
      "cat": "paraphrase",
      "text": "Navigate me to the memory page",
      "expect": [{ "kind": "navigate", "surface": "memory" }]
    },
    {
      "id": "h006",
      "cat": "paraphrase",
      "text": "Let's look at the automations",
      "expect": [{ "kind": "navigate", "surface": "automations" }]
    },
    {
      "id": "h007",
      "cat": "paraphrase",
      "text": "Show me my threads",
      "expect": [{ "kind": "navigate", "surface": "threads" }]
    },
    {
      "id": "h008",
      "cat": "paraphrase",
      "text": "What are all my threads doing right now?",
      "expect": [{ "kind": "status_report" }]
    },
    {
      "id": "h009",
      "cat": "paraphrase",
      "text": "Give me a quick rundown of my agents",
      "expect": [{ "kind": "status_report" }]
    },
    {
      "id": "h010",
      "cat": "paraphrase",
      "text": "How are my agents getting on?",
      "expect": [{ "kind": "status_report" }]
    },
    {
      "id": "h011",
      "cat": "paraphrase",
      "text": "Is anybody waiting for me?",
      "expect": [{ "kind": "show_approvals" }, { "kind": "filter_dashboard", "chip": "waiting_for_you" }]
    },
    {
      "id": "h012",
      "cat": "paraphrase",
      "text": "What do I need to approve?",
      "expect": [{ "kind": "show_approvals" }]
    },
    {
      "id": "h013",
      "cat": "paraphrase",
      "text": "Are there requests waiting on my approval?",
      "expect": [{ "kind": "show_approvals" }]
    },
    {
      "id": "h014",
      "cat": "paraphrase",
      "text": "Show me the permission requests please",
      "expect": [{ "kind": "show_approvals" }]
    },
    {
      "id": "h015",
      "cat": "paraphrase",
      "text": "Anything that needs my sign off?",
      "expect": [{ "kind": "show_approvals" }]
    },
    {
      "id": "h016",
      "cat": "paraphrase",
      "text": "Pause all of it",
      "expect": [{ "kind": "pause_threads", "scope": { "kind": "all" } }]
    },
    {
      "id": "h017",
      "cat": "paraphrase",
      "text": "Pause every agent that's running right now",
      "expect": [{ "kind": "pause_threads", "scope": { "kind": "all" } }]
    },
    {
      "id": "h018",
      "cat": "paraphrase",
      "text": "Freeze everything",
      "expect": [{ "kind": "pause_threads", "scope": { "kind": "all" } }]
    },
    {
      "id": "h019",
      "cat": "paraphrase",
      "text": "Stop all of the agents that are running",
      "expect": [{ "kind": "stop_threads", "scope": { "kind": "all" } }]
    },
    {
      "id": "h020",
      "cat": "paraphrase",
      "text": "Let everything continue",
      "expect": [{ "kind": "resume_threads", "scope": { "kind": "all" } }]
    },
    {
      "id": "h021",
      "cat": "paraphrase",
      "text": "I'd like three more Codex agents",
      "expect": [{ "kind": "create_threads", "providerId": "codex", "count": 3 }]
    },
    {
      "id": "h022",
      "cat": "paraphrase",
      "text": "Could I have a Gemini thread",
      "expect": [{ "kind": "create_threads", "providerId": "gemini-cli", "count": 1 }]
    },
    { "id": "h023", "cat": "paraphrase", "text": "Bring up a new terminal", "expect": [{ "kind": "create_terminal" }] },
    {
      "id": "h024",
      "cat": "paraphrase",
      "text": "Take me into the website project",
      "expect": [{ "kind": "open_workspace", "_target": { "workspace": "website" } }]
    },
    {
      "id": "h025",
      "cat": "paraphrase",
      "text": "Bring me to the checkout thread",
